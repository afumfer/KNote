<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <!-- KNote Atlas, stage 4 (D6): the resources of the notes are up to 200 MB (KntConst.MaxLenNoteResourceFile). Without
           this, IIS refuses any request of more than 30,000,000 bytes, whatever the app says. 211,812,352 = 202 MB. -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="211812352" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
