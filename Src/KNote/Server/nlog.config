<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	  autoReload="true"
	  internalLogLevel="Warn"
	  internalLogFile="Log/NLogKNote.log" >

	<!-- Enable asp.net core layout rednderers -->
	<extensions>
		<add assembly="NLog.Web.AspNetCore" />
	</extensions>
	
	<!-- The targets to write to -->
	<targets>
		<!-- One file per day (Log/all_2026-10-22.log...), relative to the application folder;
		     maxArchiveFiles deletes the oldest ones when a new day's file is created -->
		<target xsi:type="File" name="allLogs" fileName="Log/all_${shortdate}.log" maxArchiveFiles="30" />
		<target xsi:type="File" name="relevantLogs" fileName="Log/relevant_${shortdate}.log" maxArchiveFiles="90" />
		<!-- <target xsi:type="Console" name="logConsole"  /> -->
		<target xsi:type="ColoredConsole" name="logConsole">
			<!-- <layout xsi:type="SimpleLayout" text="${longdate} ${level:uppercase=true} ${message}" /> -->
			<highlight-row condition="level == LogLevel.Trace" foregroundColor="DarkGray" />
			<highlight-row condition="level == LogLevel.Debug" foregroundColor="Gray" />
			<highlight-row condition="level == LogLevel.Info" foregroundColor="White" />
			<highlight-row condition="level == LogLevel.Warn" foregroundColor="Yellow" />
			<highlight-row condition="level == LogLevel.Error" foregroundColor="Red" />
			<highlight-row condition="level == LogLevel.Fatal" foregroundColor="Magenta" />
		</target>
	</targets>

	<rules>
		<logger name="KNote.*" minlevel="Info" writeTo="allLogs" />
		<logger name="KNote.*" minlevel="Warn" writeTo="relevantLogs" />
		<logger name="KNote.*" minlevel="Trace" writeTo="logConsole" />
		<!-- Needed so VS Code's serverReadyAction can detect "Now listening on:" and auto-open the browser -->
		<logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="logConsole" />
	</rules>
	
</nlog>
