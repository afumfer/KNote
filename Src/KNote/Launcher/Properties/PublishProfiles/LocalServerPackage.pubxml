<?xml version="1.0" encoding="utf-8"?>
<!-- KNote Local's package (see DeployLocalServer/KNote.LocalServer.targets): the launcher, the server and the
     installation scripts in DeployLocalServer\out\KNote-Local, and its zip. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>..\DeployLocalServer\out\KNote-Local\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <KntLocalServerPackage>true</KntLocalServerPackage>
  </PropertyGroup>
</Project>
