<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.0.10</Version>
    <AssemblyVersion>0.0.10.45</AssemblyVersion>
    <FileVersion>0.0.10.45</FileVersion>
    <ApplicationIcon>Resources\Icons\KNote.ico</ApplicationIcon>
    <!-- Read by ApplicationConfiguration.Initialize(). PerMonitorV2 breaks the embedded (TopLevel = false)
         views when moving to a monitor with a lower scale; with SystemAware Windows rescales the window. -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <!-- Visual Studio WinForms designer always works (and saves layouts) at 100 % -->
    <ForceDesignerDPIUnaware>true</ForceDesignerDPIUnaware>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Temp\**" />
    <EmbeddedResource Remove="Temp\**" />
    <None Remove="Temp\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
    <PackageReference Include="NLog" Version="6.2.2" />
    <PackageReference Include="NLog.Extensions.Logging" Version="6.2.2" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="System.Data.SqlClient" Version="4.9.1" />
    <PackageReference Include="System.IO.Ports" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ai\KNote.Ai.csproj" />
    <ProjectReference Include="..\HtmlEditorControl\HTMLEditorControl.csproj" />
    <ProjectReference Include="..\KntEditViewControl\KntEditViewControl.csproj" />
    <ProjectReference Include="..\KntIcons\KntIcons.csproj" />
    <ProjectReference Include="..\KntScript\KntScript.csproj" />
    <ProjectReference Include="..\Model\KNote.Model.csproj" />
    <ProjectReference Include="..\Reports\KNote.Reports.csproj" />
    <ProjectReference Include="..\Service\KNote.Service.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Update="NLog.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Resources\KNoteWebViewStyle.css">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!-- The Mermaid diagrams of the notes (KntEditView.DiagramsScriptsFolder): the web app's copy, the only one. -->
    <None Include="..\Client\wwwroot\lib\mermaid\*" LinkBase="Resources\mermaid" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Resources\Icons\KNote.ico" />
    <EmbeddedResource Include="Resources\Icons\KNote.ico" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Resources\KNoteAIChat.css" />
    <EmbeddedResource Include="Resources\KNoteAIChat.css" LogicalName="KNote.ClientWin.Resources.KNoteAIChat.css" />
    <None Remove="Resources\KNoteChatRoom.css" />
    <EmbeddedResource Include="Resources\KNoteChatRoom.css" LogicalName="KNote.ClientWin.Resources.KNoteChatRoom.css" />
  </ItemGroup>
</Project>