{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "KNote.Server",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build: Server",
            "program": "${workspaceFolder}/Server/bin/Debug/net10.0/KNote.Server.dll",
            "args": [],
            "cwd": "${workspaceFolder}/Server",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/KNote"
            },
            "console": "internalConsole"
        },
        {
            // KNote Local: the Server as the launcher starts it (Local environment, data folder in the user's profile,
            // http://127.0.0.1 and the port of its knote-local.json). See Server/CLAUDE.md, "KNote Local".
            "name": "KNote.Server (Local)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build: Server",
            "program": "${workspaceFolder}/Server/bin/Debug/net10.0/KNote.Server.dll",
            "args": [],
            "cwd": "${workspaceFolder}/Server",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Local"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/KNote"
            },
            "console": "internalConsole"
        },
        {
            // KNote Local's launcher: starts the Server build of the same configuration (Local environment, the user's
            // data folder) if it isn't running, and opens the browser. See Launcher/CLAUDE.md.
            "name": "KNote.Launcher",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build: Local",
            "program": "${workspaceFolder}/Launcher/bin/Debug/net10.0/KNote.Launcher.dll",
            "args": [],
            "cwd": "${workspaceFolder}/Launcher",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": "KNote.Launcher (stop)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build: Launcher",
            "program": "${workspaceFolder}/Launcher/bin/Debug/net10.0/KNote.Launcher.dll",
            "args": ["--stop"],
            "cwd": "${workspaceFolder}/Launcher",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            // Server + Client (Blazor WebAssembly). Requires C# Dev Kit; uses the first "Project" profile of
            // Server/Properties/launchSettings.json (inspectUri, launchUrl "KNote") and attaches the browser debugger.
            "name": "KNote.Web (Server + Client WASM)",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/Server/KNote.Server.csproj"
        },
        {
            "name": "KNote.ClientWin",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build: ClientWin",
            "program": "${workspaceFolder}/ClientWin/bin/Debug/net10.0-windows7.0/KNote.ClientWin.exe",
            "args": [],
            "cwd": "${workspaceFolder}/ClientWin",
            "stopAtEntry": false,
            "console": "internalConsole"
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}