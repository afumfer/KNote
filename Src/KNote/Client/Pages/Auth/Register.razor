@page "/register"

@inject DialogService dialogService
@inject NotificationService notificationService

@using KNote.Client.Auth

<EditForm Model="@user" Context="formContext">

    <DataAnnotationsValidator />

    <RadzenStack Gap="1rem">

        <KntFormField Label="User name:" Component="UserName">
            <RadzenTextBox Name="UserName" @bind-Value="@user.UserName" Style="width: 100%" />
            <ValidationMessage For="@(() => user.UserName)" />
        </KntFormField>

        <KntFormField Label="Full name:" Component="FullName">
            <RadzenTextBox Name="FullName" @bind-Value="@user.FullName" Style="width: 100%" />
            <ValidationMessage For="@(() => user.FullName)" />
        </KntFormField>

        <KntFormField Label="Email:" Component="EMail">
            <RadzenTextBox Name="EMail" @bind-Value="@user.EMail" Style="width: 100%" />
            <ValidationMessage For="@(() => user.EMail)" />
        </KntFormField>

        <KntFormField Label="Password:" Component="Password">
            <RadzenPassword Name="Password" @bind-Value="@user.Password" Style="width: 100%" />
            <ValidationMessage For="@(() => user.Password)" />
        </KntFormField>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton Text="Register" Click="() => OnRegister(formContext)" ButtonStyle="ButtonStyle.Primary" />
            <RadzenButton Text="Cancel" Click="() => OnCancel()" ButtonStyle="ButtonStyle.Secondary" />
        </RadzenStack>

    </RadzenStack>

</EditForm>

@code {
    private UserRegisterDto user = new UserRegisterDto();

    private void OnRegister(EditContext formContext)
    {        
        bool formIsValid = formContext.Validate();
        if (formIsValid == false)
        {            
            notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Register user", Detail =  "Incorrect data, check the required attributes.", Duration = 12000 });
            return;
        }

        dialogService.Close(user);
    }

    private void OnCancel()
    {
        dialogService.Close(null);
    }

}
