@page "/login"

@using KNote.Client.Auth

@inject DialogService dialogService
@inject NotificationService notificationService

@* Sign in dialog (Auth/KntSignIn opens it framed): the result is the credentials, or null. Enter signs in (the form's
   submit). Also to change repository (ChangingRepository), with the user's name already in. *@

<EditForm Model="@user" Context="formContext" OnSubmit="OnLogin">

    <DataAnnotationsValidator />

    <KntDialogFrame Icon="login" Title="@(ChangingRepository ? "Change repository" : "Sign in")"
                    Subtitle="@(ChangingRepository ? "Sign in again to choose another repository." : $"Welcome to {KntConst.AppName}.")">
        <ChildContent>
            <RadzenStack Gap="1rem">
                <KntField Label="User name" Component="UserName" Required="true">
                    <RadzenTextBox Name="UserName" @bind-Value="@user.UserName" AutoCompleteType="AutoCompleteType.Username" />
                    <ValidationMessage For="@(() => user.UserName)" />
                </KntField>
                <KntField Label="Password" Component="Password" Required="true">
                    <RadzenPassword Name="Password" @bind-Value="@user.Password" AutoCompleteType="AutoCompleteType.CurrentPassword" />
                    <ValidationMessage For="@(() => user.Password)" />
                </KntField>
                <RadzenStack Orientation="Orientation.Horizontal">
                    <RadzenButton Text="Forgot your password?" Click="OnForgotPassword" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text"
                                  Size="ButtonSize.Small" />
                </RadzenStack>
            </RadzenStack>
        </ChildContent>
        <Footer>
            <RadzenButton Text="Cancel" Click="() => OnCancel()" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" />
            <RadzenButton Text="Sign in" Icon="login" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" />
        </Footer>
    </KntDialogFrame>

</EditForm>


@code {
    // The user's name, to start with (changing repository).
    [Parameter] public string? UserName { get; set; }

    [Parameter] public bool ChangingRepository { get; set; }

    private UserCredentialsDto user = new UserCredentialsDto();

    protected override void OnInitialized() => user.UserName = UserName;

    private void OnLogin(EditContext formContext)
    {
        bool formIsValid = formContext.Validate();
        if (formIsValid == false)
        {
            notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Login user.", Detail =  "Incorrect data, check the required attributes.", Duration = 12000 });
            return;
        }

        dialogService.Close(user);
    }

    private void OnCancel()
    {
        dialogService.Close(null);
    }

    // On top of this dialog, which stays open to sign in afterwards.
    private async Task OnForgotPassword() =>
        await dialogService.OpenAsync<ForgotPassword>("Forgot your password?",
            new Dictionary<string, object?>() { { "UserName", user.UserName } },
            KntDialogs.Framed(KntDialogs.Small()));

}
