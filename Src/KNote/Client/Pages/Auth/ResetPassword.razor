@page "/reset-password"

@using KNote.Client.Auth

@inject IStore store
@inject ILoginService loginService
@inject NotificationService notificationService

@* Where the link of "Forgot your password?" leads (the server builds it with its PasswordReset:PublicBaseUrl): sets
   a new password with the link's token (api/users/reset-password) and signs the user in. Anonymous: whoever has
   the link. *@

<div class="knt-reset-password">
    <RadzenCard Variant="Variant.Outlined">
        <EditForm Model="@reset" Context="formContext" OnSubmit="OnSave">
            <RadzenStack Gap="1rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                    <RadzenIcon Icon="lock_reset" />
                    <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">Set a new password</RadzenText>
                </RadzenStack>

                @if (string.IsNullOrEmpty(Token))
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-m-0">
                        This link is not complete. Ask for a new one with "Forgot your password?" in the sign-in dialog.
                    </RadzenAlert>
                }
                else
                {
                    <KntField Label="New password" Component="NewPassword" Required="true" Help="@ChangePassword.NewPasswordHelp">
                        <RadzenPassword Name="NewPassword" @bind-Value="@reset.NewPassword" AutoCompleteType="AutoCompleteType.NewPassword" />
                    </KntField>
                    <KntField Label="Confirm the new password" Component="ConfirmPassword" Required="true">
                        <RadzenPassword Name="ConfirmPassword" @bind-Value="@confirmPassword" AutoCompleteType="AutoCompleteType.NewPassword" />
                    </KntField>
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
                        <RadzenButton Text="Set password" Icon="key" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" IsBusy="@saving.IsBusy" />
                    </RadzenStack>
                }
            </RadzenStack>
        </EditForm>
    </RadzenCard>
</div>

@code {
    [SupplyParameterFromQuery] public string? Token { get; set; }

    private readonly KntSingleFlight saving = new();

    private readonly UserResetPasswordDto reset = new();
    private string? confirmPassword;

    private Task OnSave() => saving.RunAsync(SaveAsync);

    private async Task SaveAsync()
    {
        var error = KntPasswordPolicy.Validate(reset.NewPassword)
            ?? (reset.NewPassword != confirmPassword ? "The new password and its confirmation are not the same." : null);
        if (error != null)
        {
            notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Set a new password", Detail = error, Duration = 12000 });
            return;
        }

        reset.Token = Token;
        var result = await store.Users.ResetPasswordAsync(reset);
        if (!result.IsValid)
            return;

        await loginService.Login(result.Entity.token);
        notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Set a new password",
            Detail = "Your new password is set, and you are signed in.", Duration = 6000 });
        store.NavigateTo("");
    }
}
