@using KNote.Client.Auth
@using KNote.Client.Pages.Auth
@using System.Threading.Tasks

@inject IStore store
@inject ILoginService loginService
@inject NavigationManager navigationManager
@inject DialogService dialogService
@inject NotificationService notificationService
@inject TooltipService tooltipService


<AuthorizeView>
    <Authorized>
        @* The signed in user's menu: their own account and signing out. *@
        <RadzenProfileMenu Click="OnUserMenuClick" class="knt-user-menu">
            <Template>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                    <RadzenIcon Icon="account_circle" />
                    <span class="knt-user-menu-name">@context?.User?.Identity?.Name</span>
                </RadzenStack>
            </Template>
            <ChildContent>
                <RadzenProfileMenuItem Text="My profile" Icon="person" Value="profile" />
                <RadzenProfileMenuItem Text="Change password" Icon="key" Value="password" />
                <RadzenProfileMenuItem Text="Sign out" Icon="logout" Value="logout" />
            </ChildContent>
        </RadzenProfileMenu>
    </Authorized>
    <NotAuthorized>        
        <RadzenIcon Icon="how_to_reg" @onclick="@(() => GoRegister())" class="rz-mx-1" 
            MouseEnter="@(args => tooltipService.Open(args, "Register", new TooltipOptions(){ Position = TooltipPosition.Bottom }) )" />            
        <RadzenIcon Icon="login" @onclick="@(() => GoLogin())" class="rz-mx-1" 
            MouseEnter="@(args => tooltipService.Open(args, "Login", new TooltipOptions(){ Position = TooltipPosition.Bottom }) )"/>            
    </NotAuthorized>
</AuthorizeView>

@code {

    // One sign in or registration at a time: a click repeated opens one dialog and signs in once.
    private readonly KntSingleFlight signing = new();

    private Task GoRegister() => signing.RunAsync(RegisterAsync);

    private Task GoLogin() => signing.RunAsync(LoginAsync);

    private async Task OnUserMenuClick(RadzenProfileMenuItem item)
    {
        switch (item.Value)
        {
            case "profile":
                await dialogService.OpenAsync<UserProfile>("My profile", new Dictionary<string, object?>(), KntDialogs.Framed(KntDialogs.Small()));
                break;
            case "password":
                await dialogService.OpenAsync<ChangePassword>("Change password", new Dictionary<string, object?>(), KntDialogs.Framed(KntDialogs.Small()));
                break;
            case "logout":
                GoLogout();
                break;
        }
    }

    private async Task RegisterAsync()
    {
        var resDialog = await dialogService.OpenAsync<Register>($"Register",
               new Dictionary<string, object?>() {  },
               KntDialogs.Framed(KntDialogs.Medium()));

        if(resDialog != null)
        {
            // The new user's role is decided by the server (see KntUsersRegisterAsyncCommand).
            var result = await store.Users.RegisterAsync(resDialog);
            if (!result.success)                
                await dialogService.Alert(result.error, "Error", new AlertOptions() { OkButtonText = "OK" });
            else
            {
                notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Login user.", Detail = "Authenticated use.", Duration = 3000 });
                await loginService.Login(result.token);
                navigationManager.NavigateTo("");
            }
        }
    }

    private async Task LoginAsync()
    {
        var resDialog = await dialogService.OpenAsync<Login>($"{KntConst.AppName} login",
               new Dictionary<string, object?>() {  },
               KntDialogs.Framed(KntDialogs.Small()));

        if(resDialog != null)
        {
            var result = await store.Users.LoginAsync(resDialog);
            if (!result.success)                        
                await dialogService.Alert(result.error, "Error", new AlertOptions() { OkButtonText = "OK" });
            else
            {
                notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Login user.", Detail =  "Authenticated use.", Duration = 3000 });
                await loginService.Login(result.token);
                navigationManager.NavigateTo("");
            }                        
        }             
    }

    private void GoLogout()
    {
        navigationManager.NavigateTo("Logout");
    }

}