@implements IDisposable

@inject IStore store
@inject DialogService dialogService
@inject NotificationService notificationService

@* "Forgot your password?" dialog (Auth/Login opens it on top of itself): asks for a link to set a new password,
   sent to the user's email (api/users/forgot-password). The server answers the same whether the user exists or
   not, and that answer is shown here. *@

<EditForm Model="@request" Context="formContext" OnSubmit="OnSend">

    <KntDialogFrame Icon="lock_reset" Title="Forgot your password?" Subtitle="We'll send you a link to set a new one." OnClose="OnExit">
        <ChildContent>
            <RadzenStack Gap="1rem">
                @if (answer == null)
                {
                    <KntField Label="User name or email" Component="UserNameOrEMail" Required="true" Help="The link goes to the email of your user.">
                        <RadzenTextBox Name="UserNameOrEMail" @bind-Value="@request.UserNameOrEMail" AutoCompleteType="AutoCompleteType.Username" />
                    </KntField>
                }
                else
                {
                    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-m-0">
                        @answer Check your inbox (and the spam folder): the link works once and for a short time.
                    </RadzenAlert>
                }
            </RadzenStack>
        </ChildContent>
        <Footer>
            @if (answer == null)
            {
                <RadzenButton Text="Cancel" Click="OnExit" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Disabled="@sending.IsBusy" />
                <RadzenButton Text="Send link" Icon="send" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" IsBusy="@sending.IsBusy" />
            }
            else
            {
                <RadzenButton Text="Close" Click="OnExit" ButtonStyle="ButtonStyle.Primary" />
            }
        </Footer>
    </KntDialogFrame>

</EditForm>

@code {
    // What was typed in the sign-in dialog, as a start.
    [Parameter] public string? UserName { get; set; }

    private readonly KntSingleFlight sending = new();
    private bool closed;

    private readonly UserForgotPasswordDto request = new();
    private string? answer;

    protected override void OnInitialized() => request.UserNameOrEMail = UserName;

    private Task OnSend() => sending.RunAsync(SendAsync);

    private async Task SendAsync()
    {
        if (answer != null)
            return;

        if (string.IsNullOrWhiteSpace(request.UserNameOrEMail))
        {
            notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Forgot your password?",
                Detail = "Enter your user name or your email.", Duration = 12000 });
            return;
        }

        var result = await store.Users.ForgotPasswordAsync(request);
        if (result.IsValid)
            answer = result.Entity;
    }

    private void OnExit()
    {
        if (!sending.IsBusy)
            CloseDialog(null);
    }

    public void Dispose() => closed = true;

    private void CloseDialog(object? result)
    {
        if (!closed)
            dialogService.Close(result);
    }
}
