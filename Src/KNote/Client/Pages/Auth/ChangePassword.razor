@using KNote.Client.Auth

@implements IDisposable

@inject IStore store
@inject ILoginService loginService
@inject DialogService dialogService
@inject NotificationService notificationService

@* "Change password" dialog (Shared/MainLayoutHeader → AdminLogin opens it framed): the signed in user changes their
   password (api/users/me/password, Users.ChangePasswordAsync). The server closes the user's other sessions and
   answers with a new token for this one, which is signed in with it. The result is true if it changed, or null. *@

<EditForm Model="@passwords" Context="formContext" OnSubmit="OnSave">

    <KntDialogFrame Icon="key" Title="Change password" Subtitle="@store.AppState.UserName" OnClose="OnExit">
        <ChildContent>
            <RadzenStack Gap="1rem">
                <KntField Label="Current password" Component="CurrentPassword" Required="true">
                    <RadzenPassword Name="CurrentPassword" @bind-Value="@passwords.CurrentPassword" AutoCompleteType="AutoCompleteType.CurrentPassword" />
                </KntField>
                <KntField Label="New password" Component="NewPassword" Required="true" Help="@NewPasswordHelp">
                    <RadzenPassword Name="NewPassword" @bind-Value="@passwords.NewPassword" AutoCompleteType="AutoCompleteType.NewPassword" />
                </KntField>
                <KntField Label="Confirm the new password" Component="ConfirmPassword" Required="true">
                    <RadzenPassword Name="ConfirmPassword" @bind-Value="@confirmPassword" AutoCompleteType="AutoCompleteType.NewPassword" />
                </KntField>
                <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" Size="AlertSize.Small" class="rz-m-0">
                    Your sessions in other browsers and devices will be closed.
                </RadzenAlert>
            </RadzenStack>
        </ChildContent>
        <Footer>
            <RadzenButton Text="Cancel" Click="OnExit" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Disabled="@saving.IsBusy" />
            <RadzenButton Text="Change password" Icon="key" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" IsBusy="@saving.IsBusy" />
        </Footer>
    </KntDialogFrame>

</EditForm>

@code {
    public static readonly string NewPasswordHelp = $"At least {KntPasswordPolicy.MinLength} characters, not your user name.";

    private readonly KntSingleFlight saving = new();
    private bool closed;

    private readonly UserChangePasswordDto passwords = new();
    private string? confirmPassword;

    private Task OnSave() => saving.RunAsync(SaveAsync);

    private async Task SaveAsync()
    {
        var error = string.IsNullOrEmpty(passwords.CurrentPassword) ? "Enter your current password."
            : KntPasswordPolicy.Validate(passwords.NewPassword, store.AppState.UserName)
            ?? (passwords.NewPassword != confirmPassword ? "The new password and its confirmation are not the same." : null);
        if (error != null)
        {
            notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Change password", Detail = error, Duration = 12000 });
            return;
        }

        var result = await store.Users.ChangePasswordAsync(passwords);
        if (result.IsValid)
        {
            await loginService.Login(result.Entity.token);
            CloseDialog(true);
        }
    }

    private void OnExit()
    {
        if (!saving.IsBusy)
            CloseDialog(null);
    }

    public void Dispose() => closed = true;

    private void CloseDialog(object? result)
    {
        if (!closed)
            dialogService.Close(result);
    }
}
