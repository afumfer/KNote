@implements IDisposable

@inject KntWindows kntWindows

@* KNote Atlas, the tab «AI personalization» (chapters 19–21): the context the AI receives in the session's repository. Each
   section reads its own part: the profile and the glossary side by side, the instructions of the tasks and what the AI
   receives (the result of the three, Staff). The notes are written in the note editor of always, in its own window: when
   one is saved there, the tab is read again. *@

<KntIndexHeader Section="KntSections.AtlasPersonalization" Subtitle="The context the AI receives in this repository" />

<RadzenStack Gap="1rem" class="rz-pt-2">
    <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">
        The AI receives this context in every task, so that it knows your repository: what it is for, its vocabulary and how
        you want it to work. The profile, the glossary and the instructions are notes of the folder «KNote Atlas»: you write
        them in the note editor, and only a ProjectManager or an Admin saves them.
    </RadzenText>
    <RadzenRow Gap="1rem">
        <RadzenColumn Size="12" SizeMD="6">
            <AtlasProfileSection @ref="profile" Changed="RefreshPromptAsync" />
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMD="6">
            <AtlasGlossarySection @ref="glossary" Changed="RefreshPromptAsync" />
        </RadzenColumn>
    </RadzenRow>
    <AtlasTaskPromptsSection @ref="tasks" Changed="RefreshPromptAsync" />
    <AuthorizeView Roles="Staff, ProjectManager, Admin">
        <Authorized>
            <AtlasPromptSection @ref="prompt" />
        </Authorized>
    </AuthorizeView>
</RadzenStack>

@code {
    private AtlasProfileSection? profile;
    private AtlasGlossarySection? glossary;
    private AtlasTaskPromptsSection? tasks;
    private AtlasPromptSection? prompt;

    protected override void OnInitialized() => kntWindows.NoteSaved += OnNoteSaved;

    private Task RefreshPromptAsync() => prompt?.RefreshAsync() ?? Task.CompletedTask;

    private void OnNoteSaved(Guid noteId) => _ = InvokeAsync(() => Task.WhenAll(
        profile?.RefreshAsync() ?? Task.CompletedTask,
        glossary?.RefreshAsync() ?? Task.CompletedTask,
        tasks?.RefreshAsync() ?? Task.CompletedTask,
        RefreshPromptAsync()));

    public void Dispose() => kntWindows.NoteSaved -= OnNoteSaved;
}
