@* KNote Atlas, a tab of the admin panel: the AI models of the session's repository (CU-02), its semantic index
   (CU-03) and «Process pending resources» (CU-25). Each section reads and saves its own part. *@

@attribute [Authorize(Roles = "Admin")]

<KntIndexHeader Section="KntSections.Atlas" Subtitle="AI models and search by meaning of this repository" />

<div class="rz-pt-2">
    <AtlasRepositoryModels OnSaved="@(() => semanticIndex?.RefreshAsync() ?? Task.CompletedTask)" />
    <AtlasSemanticIndex @ref="semanticIndex" />
    <AtlasResources OnFinished="@(() => semanticIndex?.FollowRunAsync() ?? Task.CompletedTask)" />
</div>

@code {
    private AtlasSemanticIndex? semanticIndex;
}
