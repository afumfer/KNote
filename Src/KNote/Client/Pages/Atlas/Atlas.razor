@page "/atlas"
@page "/atlas/evaluation"

@using KNote.Client.Auth

@inject NavigationManager navigationManager
@inject IJSRuntime js

@attribute [Authorize]

@* KNote Atlas: everything of the AI of the session's repository in one page, a tab for each part (KNote Atlas 4.3b). Each
   tab is for its role: the AI models, the semantic index and «Process pending resources» for an Admin, the search
   evaluation for a ProjectManager, the AI personalization for everyone. A tab the user can't use is disabled, with who can.
   Only the chosen tab is drawn (and asks the server): the tabs are drawn once it is known, not the first one meanwhile. The
   tab goes in the address (?tab=) and is remembered in the browser; /atlas/evaluation, the old page of the evaluation, opens
   its tab. *@

<KntIndexHeader Section="KntSections.Atlas" Subtitle="The AI of this repository" />

<div class="rz-pt-2 knt-atlas">
    @* The pages shown in the tabs draw their headers in compact style. *@
    <CascadingValue Name="KntCompactHeader" Value="true">
        @if (selectedIndex >= 0)
        {
            <RadzenTabs TabPosition="TabPosition.Left" SelectedIndex="@selectedIndex" SelectedIndexChanged="OnTabChanged">
                <Tabs>
                    @foreach (var tab in tabs)
                    {
                        <RadzenTabsItem Text="@tab.Section.Text" Disabled="@(!CanUse(tab))">
                            <Template>
                                <span class="knt-atlas-tab" title="@(CanUse(tab) ? null : tab.Who)">
                                    <RadzenIcon Icon="@tab.Section.Icon" />
                                    <span>@tab.Section.Text</span>
                                    @if (!CanUse(tab))
                                    {
                                        <RadzenIcon Icon="lock" class="knt-atlas-tab-lock" />
                                    }
                                </span>
                            </Template>
                            <ChildContent>
                                @if (CanUse(tab))
                                {
                                    @switch (tab.Key)
                                    {
                                        case ModelsTab:
                                            <AtlasRepositoryModels />
                                            break;
                                        case PersonalizationTab:
                                            <AtlasPersonalization />
                                            break;
                                        case IndexTab:
                                            <AtlasSemanticIndex />
                                            break;
                                        case ResourcesTab:
                                            <AtlasResources />
                                            break;
                                        case EvaluationTab:
                                            <SearchEvaluation />
                                            break;
                                    }
                                }
                            </ChildContent>
                        </RadzenTabsItem>
                    }
                </Tabs>
            </RadzenTabs>
        }
    </CascadingValue>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = null!;
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    private const string ModelsTab = "models";
    private const string PersonalizationTab = "personalization";
    private const string IndexTab = "index";
    private const string ResourcesTab = "resources";
    private const string EvaluationTab = "evaluation";
    private const string StorageKey = "knt-atlas-tab";

    private sealed record AtlasTab(string Key, KntSection Section, EnumRoles Role, string Who);

    private static readonly List<AtlasTab> tabs =
    [
        new(ModelsTab, KntSections.AtlasModels, EnumRoles.Admin, "Only an Admin chooses the AI models of the repository."),
        new(PersonalizationTab, KntSections.AtlasPersonalization, EnumRoles.Guest, ""),
        new(IndexTab, KntSections.AtlasSemanticIndex, EnumRoles.Admin, "Only an Admin creates or updates the semantic index."),
        new(ResourcesTab, KntSections.AtlasResources, EnumRoles.Admin, "Only an Admin processes the pending resources of the repository."),
        new(EvaluationTab, KntSections.SearchEvaluation, EnumRoles.ProjectManager, "Only a ProjectManager or an Admin evaluates the search.")
    ];

    private EnumRoles role = EnumRoles.Guest;
    private int selectedIndex = -1;

    private bool CanUse(AtlasTab tab) => role >= tab.Role;

    protected override async Task OnParametersSetAsync()
    {
        var user = (await AuthenticationState).User;
        role = Enum.GetValues<EnumRoles>().Where(r => KntAccess.HasRole(user, r)).DefaultIfEmpty(EnumRoles.Guest).Max();

        // The tab of the address; else the old page of the evaluation; else the last one used here; else the personalization.
        var key = Tab;
        if (key == null && navigationManager.Uri.TrimEnd('/').EndsWith("/atlas/evaluation", StringComparison.OrdinalIgnoreCase))
            key = EvaluationTab;
        if (key == null && selectedIndex < 0)
            key = await ReadLastTabAsync();
        var index = tabs.FindIndex(t => t.Key == key && CanUse(t));
        if (index >= 0)
            selectedIndex = index;
        else if (selectedIndex < 0)
            selectedIndex = tabs.FindIndex(t => t.Key == PersonalizationTab);
    }

    private async Task OnTabChanged(int index)
    {
        selectedIndex = index;
        var key = tabs[index].Key;
        try
        {
            await js.LocalStorageSetItem(StorageKey, key);
        }
        catch (JSException)
        {
        }
        navigationManager.NavigateTo($"atlas?tab={key}", replace: true);
    }

    private async Task<string?> ReadLastTabAsync()
    {
        try
        {
            return await js.LocalStorageGetItem(StorageKey);
        }
        catch (JSException)
        {
            return null;
        }
    }
}
