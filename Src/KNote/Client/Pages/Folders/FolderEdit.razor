@page "/folders/edit/{FolderId}"

@implements IDisposable

@inject IStore store 
@inject DialogService dialogService

@attribute [Authorize(Roles = "Admin, ProjectManager")]

<NavigationLock ConfirmExternalNavigation=true />

@if (folder != null)
{
    <FolderForm Title="Edit folder" OnValidSubmit="OnSave" OnExit="OnExit" Saving="saving.IsBusy" Folder="folder" />
}
else
{
    <text>Loading ... </text>
}

@code {
    // One save at a time (a double click saves once), and leaving waits for it.
    private readonly KntSingleFlight saving = new();
    // Closed meanwhile (Esc): no result to give, and Radzen's Close would close the dialog on top, another one.
    private bool closed;

    [Parameter] public string FolderId { get; set; } = string.Empty;

    private FolderDto? folder;    

    protected async override Task OnInitializedAsync()
    {
        base.OnInitialized();

        store.AppState.OnChange += StateHasChanged;

        Guid id;
        var parseOk = Guid.TryParse(FolderId, out id);
        if (!parseOk)
        {
            await dialogService.Alert("Invalid folder identifier.");
            CloseDialog(null);
            return;
        }

        var result = await store.Folders.GetAsync(id);
        if (!result.IsValid)                    
            CloseDialog(null);
        else
        {            
            folder = result.Entity;
            folder.SetIsDirty(false);
        }
    }

    public void Dispose()
    {
        closed = true;
        store.AppState.OnChange -= StateHasChanged;
    }

    private Task OnSave() => saving.RunAsync(SaveAsync);

    private async Task SaveAsync()
    {
        if (!folder!.IsDirty())
        {
            CloseDialog(folder);
        }
        else
        {
            var result = await store.Folders.SaveAsync(folder!);
            if (result.IsValid)
            {
                if (store.AppState.FoldersTree != null)
                {
                    FolderDto? toUpdate;
                    store.AppState.FoldersIndex.TryGetValue(folder.FolderId, out toUpdate);
                    if (toUpdate != null)
                    {
                        if (toUpdate.ParentId == folder.ParentId)
                            toUpdate.Name = folder.Name;
                        else
                            store.AppState.FoldersTree = null;
                    }
                    else
                    {
                        store.AppState.FoldersTree = null;
                    }
                }            
                CloseDialog(result.Entity);
            }            
        }
    }

    private async Task OnExit()
    {        
        if (saving.IsBusy)
            return;

        if (folder == null)
        {
            CloseDialog(null);
            return;
        }

        if (folder.IsDirty())
        {
            var resultDialog = await dialogService.Confirm(
                @"Do you want to leave the page and lose your changes?",
                $"{KntConst.AppName}",
                new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });

            if (resultDialog == true)
            {
                CloseDialog(null);
            }
        }
        else
        {
            CloseDialog(null);
        }
    }

    private void CloseDialog(object? result)
    {
        if (!closed)
            dialogService.Close(result);
    }
}
