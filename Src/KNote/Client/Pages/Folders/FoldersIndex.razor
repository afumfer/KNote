@page "/folders"

@implements IDisposable

@inject IStore store
@inject TooltipService tooltipService
@inject DialogService dialogService

@attribute [Authorize(Roles = "Guest, Staff, ProjectManager, Admin")]


<KntIndexHeader Section="KntSections.Folders">
    <IndexMenu>
        <RadzenMenu>
            <RadzenMenuItem Text="New folder ..." Icon="post_add"  Click="OnNew"></RadzenMenuItem>
            <RadzenMenuItem Text="Edit folder ..." Icon="edit" Disabled="@(selectedFolder == null)" Click="@(() => OnEdit(selectedFolder!))"></RadzenMenuItem>
            <RadzenMenuItem Text="Delete folder ..." Icon="delete" Disabled="@(selectedFolder == null || deleting.IsBusy)" Click="@(() => OnDelete(selectedFolder!))"></RadzenMenuItem>
            <RadzenMenuItem Text="Refresh tree" Icon="refresh"  Click="OnRefreshTree" ></RadzenMenuItem>
        </RadzenMenu>
    </IndexMenu>
</KntIndexHeader>

<div class="rz-border rz-p-2 rz-mt-2 knt-admin-list" style="overflow: auto">
    @if (foldersTree == null)
    {
        <RadzenLabel class="rz-m-2" Text="Loading tree folders ..." />
    }
    else
    {
        <KntFoldersTreeView FoldersInfo="foldersTree"
                            FolderSelected="OnFolderSelected"
                            FolderActions="ActionsOf"
                            FolderDoubleClick="OnEdit" />
    }
</div>


@code {

    private List<FolderDto>? foldersTree;
    private FolderDto? selectedFolder;
    private AppState appState = null!;

    protected override async Task OnInitializedAsync()    
    {
        appState = store.AppState;
        appState.OnChange += StateHasChanged;

        await Load();
    }

    // The tree asked for last: reading it again (after a change) or leaving the page cancels the one being read.
    private readonly KntLatestRequest treeRequest = new();

    public void Dispose()
    {
        appState.OnChange -= StateHasChanged;
        treeRequest.Dispose();
    }

    async Task Load()
    {
        selectedFolder = null;

        var request = await treeRequest.RunAsync(ct => store.Folders.GetTreeAsync(ct));
        if (request.Canceled)
            return;

        var result = request.Value;
        if (result.IsValid)
            foldersTree = result.Entity;
        else
        {
            foldersTree = new List<FolderDto>();
        }

        // Only a tree read is kept: after a failure (the session refused, no network) it is asked again next time.
        if (result.IsValid)
            appState.FoldersTree = foldersTree;

        if (!appState.IsSelectedFolder())
        {
            if (foldersTree?.Count > 0)
            {
                FolderDto? f;
                f = foldersTree.Select(x => x).FirstOrDefault();
                if(f != null)
                    f.Selected = true;
                OnFolderSelected(f);
            }            
        }
        else 
            OnFolderSelected(appState.SelectedFolder.GetSimpleDto<FolderDto>());
    }

    void OnFolderSelected(FolderDto? f)
    {
        selectedFolder = f;
        appState.SelectedFolder = selectedFolder.GetSimpleDto<FolderDto>();
    }

    async Task OnNew()
    {
        if (await FolderDialogs.NewAsync(dialogService))
            await Load();
    }

    // A right click on a folder; the header buttons and a double click act on the selected one.
    private List<KntAction> ActionsOf(FolderDto folder) =>
    [
        new("Edit", "edit", () => OnEdit(folder)),
        new("Delete", "delete", () => OnDelete(folder), Danger: true)
    ];

    async Task OnEdit(FolderDto folder)
    {
        if (await FolderDialogs.EditAsync(dialogService, folder))
            await Load();
    }


    // One delete at a time: a click or the Delete key repeated asks and deletes once.
    private readonly KntSingleFlight deleting = new();

    Task OnDelete(FolderDto folder) => deleting.RunAsync(() => DeleteAsync(folder));

    async Task DeleteAsync(FolderDto folder)
    {
        if (await FolderDialogs.DeleteAsync(dialogService, store, folder))
        {
            foldersTree = null;
            await OnRefreshTree();
        }
    }

    private async Task OnRefreshTree()
    {
        foldersTree = null;
        appState.SelectedFolder = null;
        appState.FoldersTree = null;
        await Load();
    }
}
