@inject DialogService dialogService
@inject NotificationService notificationService
@inject TooltipService tooltipService

<EditForm Model="KAttribute" Context="formContext">

    <DataAnnotationsValidator></DataAnnotationsValidator>

    <KntDialogFrame Icon="@KntSections.Attributes.Icon" Title="@Title" Subtitle="@Subtitle" OnClose="() => OnExit.InvokeAsync(null)">
        <ChildContent>

            <KntFormSection Icon="badge" Title="General" Description="An attribute is a field that notes can fill in.">
                <KntField Label="Name" Component="Name" Required="true">
                    <RadzenTextBox Name="Name" @bind-Value="@KAttribute.Name" />
                    <ValidationMessage For="@(() => KAttribute.Name)" />
                </KntField>
                <KntField Label="Description" Component="Description">
                    <RadzenTextArea Name="Description" @bind-Value="@KAttribute.Description" Rows="2" />
                    <ValidationMessage For="@(() => KAttribute.Description)" />
                </KntField>
            </KntFormSection>

            <KntFormSection Icon="tune" Title="Behavior" Description="What the attribute holds and which notes have it.">
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeSM="6">
                        <KntField Label="Data type" Component="KAttributeDataType" Required="true">
                            <RadzenDropDown Name="KAttributeDataType" @bind-Value="@KAttribute.KAttributeDataType" TValue="EnumKAttributeDataType"
                                            Data="@KntConst.KAttributes" TextProperty="Value" ValueProperty="Key">
                                <Template Context="dataType">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                        <RadzenIcon Icon="@KntDataTypes.Icon(((KeyValuePair<EnumKAttributeDataType, string>)dataType).Key)" />
                                        <span>@(((KeyValuePair<EnumKAttributeDataType, string>)dataType).Value)</span>
                                    </RadzenStack>
                                </Template>
                                <ValueTemplate Context="dataType">
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                        <RadzenIcon Icon="@KntDataTypes.Icon(((KeyValuePair<EnumKAttributeDataType, string>)dataType).Key)" />
                                        <span>@(((KeyValuePair<EnumKAttributeDataType, string>)dataType).Value)</span>
                                    </RadzenStack>
                                </ValueTemplate>
                            </RadzenDropDown>
                            <ValidationMessage For="@(() => KAttribute.KAttributeDataType)" />
                        </KntField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeSM="6">
                        <KntField Label="Note type" Component="NoteTypeId" Help="Only the notes of this type have it. Empty: all the notes.">
                            <RadzenDropDown Name="NoteTypeId" @bind-Value="@KAttribute.NoteTypeId" TValue="Guid?"
                                            Data="@NoteTypes" TextProperty="Name" ValueProperty="NoteTypeId"
                                            AllowClear="true" Placeholder="All the notes" />
                            <ValidationMessage For="@(() => KAttribute.NoteTypeId)" />
                        </KntField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeSM="6">
                        <KntField Label="Order" Component="Order" Help="Position among the note's attributes.">
                            <RadzenNumeric Name="Order" @bind-Value="@KAttribute.Order" />
                            <ValidationMessage For="@(() => KAttribute.Order)" />
                        </KntField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeSM="6">
                        <KntField Label="Required value" Component="RequiredValue" Help="A note can't be saved without it.">
                            <RadzenSwitch Name="RequiredValue" @bind-Value="@KAttribute.RequiredValue" />
                            <ValidationMessage For="@(() => KAttribute.RequiredValue)" />
                        </KntField>
                    </RadzenColumn>
                </RadzenRow>
            </KntFormSection>

            @if (KAttribute.KAttributeDataType == EnumKAttributeDataType.TabulatedValue || KAttribute.KAttributeDataType == EnumKAttributeDataType.TagsValue)
            {
                <KntFormSection Icon="list" Title="Values" Description="@(KAttribute.KAttributeDataType == EnumKAttributeDataType.TagsValue ? "The tags a note can choose (several)." : "The values a note can choose (one).")">
                    <div class="knt-values">
                        <div class="knt-values-header">
                            <span>@atributeValues!.Count @(atributeValues.Count == 1 ? "value" : "values")</span>
                            <RadzenButton Text="Add value" Icon="add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                                          Click="@(() => OnAtrValueNew())" />
                        </div>
                        @if (atributeValues.Count == 0)
                        {
                            <div class="knt-values-empty">
                                <RadzenIcon Icon="playlist_add" />
                                <span>No values yet: add the first one.</span>
                            </div>
                        }
                        else
                        {
                            @foreach (var value in atributeValues.OrderBy(v => v.Order))
                            {
                                <div class="knt-value-row" @ondblclick="() => OnAtrValueEdit(value)">
                                    <span class="knt-value-order">@value.Order</span>
                                    <span class="knt-value-text">@value.Value</span>
                                    <RadzenButton Icon="edit" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                                                  MouseEnter="@(args => tooltipService.Open(args, "Edit value"))" Click="@(() => OnAtrValueEdit(value))" />
                                    <RadzenButton Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                                  MouseEnter="@(args => tooltipService.Open(args, "Delete value"))" Click="@(() => OnAtrValueDelete(value))" />
                                </div>
                            }
                        }
                    </div>
                </KntFormSection>
            }

        </ChildContent>
        <Footer>
            <RadzenButton Text="Cancel" Click="() => OnExit.InvokeAsync(null)" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" />
            <RadzenButton Text="Save" Icon="save" Click="() => Save(formContext)" ButtonStyle="ButtonStyle.Primary" />
        </Footer>
    </KntDialogFrame>

</EditForm>

@code {
    [Parameter] [EditorRequired] public KAttributeDto KAttribute { get; set; } = null!;
    [Parameter] public EventCallback OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnExit { get; set; }
    [Parameter] public List<NoteTypeDto> NoteTypes { get; set; } = new List<NoteTypeDto>();
    
    List<KAttributeTabulatedValueDto>? atributeValues;

    private bool IsNew => KAttribute.KAttributeId == Guid.Empty;

    private string Title => IsNew ? "New attribute" : "Edit attribute";

    private string Subtitle => IsNew ? "A new field for the notes." : KAttribute.Name;


    protected override void OnInitialized()
    {
        // This is necesary for correct binding with Radzen grid
        atributeValues = KAttribute.KAttributeValues.ToList();
    }

    protected async Task Save(EditContext formContext)
    {
        bool formIsValid = formContext.Validate();

        if (formIsValid == false)
        {            
            notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Save attribute.", Detail =  "Incorrect data, check the required attributes.", Duration = 12000 });
            return;
        }

        await OnValidSubmit.InvokeAsync(formContext);
    }

    async Task OnAtrValueNew()
    {        
        await AtrValueEdit(null!);
    }

    async Task OnAtrValueEdit(KAttributeTabulatedValueDto atrEdit)
    {        
        await AtrValueEdit(atrEdit);
    }

    async Task OnAtrValueDelete(KAttributeTabulatedValueDto atrValue)
    {
        var resultDialog = await dialogService.Confirm(
            $"Are you sure you want delete this attribute tabulated value?", 
            "Delete value", 
            new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });

        if (resultDialog == true)
        {
            KAttribute.KAttributeValues.Remove(atrValue);
            KAttribute.SetIsDirty(true, false);
        }
    }

    async Task AtrValueEdit(KAttributeTabulatedValueDto atrValue)
    {
        var resAtrEdited = await dialogService.OpenAsync<AttributeValueEditor>($"Edit attribute tabulated value",
               new Dictionary<string, object?>() { { "AtrValue", atrValue }, { "AttributeName", KAttribute.Name } },
               KntDialogs.Framed(KntDialogs.Small()));

        if(resAtrEdited != null)
        {
            if (!resAtrEdited.IsDirty())
                return;

            var atrOld = KAttribute.KAttributeValues.Where(v => v.KAttributeTabulatedValueId == resAtrEdited.KAttributeTabulatedValueId).SingleOrDefault();

            if (atrOld == null)
            {
                resAtrEdited.KAttributeId = KAttribute.KAttributeId;
                resAtrEdited.SetIsNew(true);
                KAttribute.KAttributeValues.Add(resAtrEdited);
            }
            else
            {
                var i = KAttribute.KAttributeValues.IndexOf(atrOld);
                KAttribute.KAttributeValues.RemoveAt(i);
                KAttribute.KAttributeValues.Insert(i, resAtrEdited);
            }                
        }
        // This is necesary for correct binding with Radzen grid
        atributeValues = KAttribute.KAttributeValues.ToList();

        StateHasChanged();
    }

}
