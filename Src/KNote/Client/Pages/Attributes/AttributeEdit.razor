@page "/attributes/edit/{AttributeId}"

@implements IDisposable

@inject IStore store
@inject DialogService dialogService

@attribute [Authorize(Roles = "Admin")]


<NavigationLock ConfirmExternalNavigation=true />

@if (kattribute != null && showForm)
{
    <AttributeForm OnValidSubmit="OnSave" OnExit="OnExit" Saving="saving.IsBusy" KAttribute="kattribute" NoteTypes="noteTypes" />
}
else
{
    <text>Loading ... </text>
}

@code {
    // One save at a time (a double click saves once), and leaving waits for it.
    private readonly KntSingleFlight saving = new();
    // Closed meanwhile (Esc): no result to give, and Radzen's Close would close the dialog on top, another one.
    private bool closed;

    [Parameter] public string AttributeId { get; set; } = string.Empty;

    private KAttributeDto? kattribute;
    private bool showForm = false;
    private List<NoteTypeDto> noteTypes = new List<NoteTypeDto>();

    protected async override Task OnInitializedAsync()
    {
        base.OnInitialized();

        Guid id;
        var parseOk = Guid.TryParse(AttributeId, out id);
        if (!parseOk)
        {
            await dialogService.Alert("Invalid attribute identifier.");
            CloseDialog(null);
            return;
        }

        var result = await store.KAttributes.GetAsync(id);
        if (!result.IsValid)
        {            
            CloseDialog(null);
            return;
        }
        else
        {
            kattribute = result.Entity;
            kattribute.SetIsDirty(false);
        }

        var result2 = await store.NoteTypes.GetAllAsync();
        if (!result2.IsValid)
        {                        
            CloseDialog(null);
        }
        else
        {
            noteTypes = result2.Entity;
            showForm = true;
        }        
    }

    private Task OnSave() => saving.RunAsync(SaveAsync);

    private async Task SaveAsync()
    {

        if (!kattribute!.IsDirty())
        {            
            CloseDialog(kattribute);
        }
        else
        {
            if (kattribute.IsValid())
            {
                var result = await store.KAttributes.SaveAsync(kattribute);
                if (result.IsValid)                                    
                {                    
                    CloseDialog(result.Entity);
                }
            }
        }
    }

    private async Task OnExit()
    {
        if (saving.IsBusy)
            return;

        if (kattribute == null)
        {
            CloseDialog(null);
            return;
        }

        if (kattribute.IsDirty())
        {
            var resultDialog = await dialogService.Confirm(
                @"Do you want to leave the page and lose your changes?",
                $"{KntConst.AppName}",
                new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });

            if (resultDialog == true)
            {
                CloseDialog(null);
            }
        }
        else
        {
            CloseDialog(null);
        }
    }

    public void Dispose() => closed = true;

    private void CloseDialog(object? result)
    {
        if (!closed)
            dialogService.Close(result);
    }
}
