@page "/users"

@implements IDisposable

@inject IStore store
@inject TooltipService tooltipService
@inject DialogService dialogService
@inject ContextMenuService contextMenuService

@attribute [Authorize(Roles = "Admin")]

<KntIndexHeader Section="KntSections.Users">
    <IndexMenu>
        <RadzenMenu>
            <RadzenMenuItem Text="New user ..." Icon="post_add"  Click="OnNew"></RadzenMenuItem>
            <RadzenMenuItem Text="Edit user ..." Icon="edit" Disabled="@(Selected == null)" Click="@(() => OnEdit(Selected!))"></RadzenMenuItem>
            <RadzenMenuItem Text="Delete user ..." Icon="delete" Disabled="@(Selected == null || deleting.IsBusy)" Click="@(() => OnDelete(Selected!))"></RadzenMenuItem>
        </RadzenMenu>
    </IndexMenu>
</KntIndexHeader>

<RadzenStack Gap="0.5rem" class="rz-pt-2">
    <EntityList List="users" LoadFailed="loadFailed" Retry="Load">
        <AllItems>
            <RadzenDataGrid Data="@users" TItem="UserDto" AllowColumnResize="true" AllowSorting="true" Density="@Density.Compact"
                            class="knt-admin-list knt-list" AllowAlternatingRows="false"
                            SelectionMode="DataGridSelectionMode.Single" @bind-Value="selection"
                            CellContextMenu="OnCellContextMenu"
                            RowDoubleClick="@(args => OnEdit(args.Data!))">
                <Columns>
                    <RadzenDataGridColumn TItem="UserDto" Property="UserName" Title="User name" />
                    <RadzenDataGridColumn TItem="UserDto" Property="FullName" Title="Full name" />
                    <RadzenDataGridColumn TItem="UserDto" Property="EMail" Title="Email"  />
                    <RadzenDataGridColumn TItem="UserDto" Property="RoleDefinition" Title="Roles" />                
                </Columns> 
            </RadzenDataGrid>
        </AllItems>
    </EntityList>
</RadzenStack>

@code {

    private List<UserDto>? users { get; set; }
    

    protected async override Task OnInitializedAsync()
    {
        await Load();
    }

    // The list asked for last: reading it again (after a change) or leaving the page cancels the one being read.
    private readonly KntLatestRequest listRequest = new();

    public void Dispose() => listRequest.Dispose();

    // The list could not be read: EntityList says so, with Retry (else it would show "loading" for ever).
    private bool loadFailed;

    private async Task Load()
    {
        var request = await listRequest.RunAsync(ct => store.Users.GetAllAsync(cancellationToken: ct));
        if (request.Canceled)
            return;

        var result = request.Value;
        loadFailed = !result.IsValid;
        if (result.IsValid)
        {
            users = result.Entity;
            selection = users.Where(x => selection.Any(s => s.UserId == x.UserId)).ToList();
        }

        StateHasChanged();
    }

    private string RolesDescriptions(string rolesString)
    {
        if (rolesString == null)
            return "";

        string rolesDes = "";
        var rolesCole = rolesString.Split(", ");
        foreach (var r in rolesCole)
        {
            Enum.TryParse(r, out EnumRoles myRol);
            var rol = KntConst.Roles.Where(_ => _.Key == myRol).Select(_ => _.Value).FirstOrDefault();
            if (rol != null)
            {
                if (rolesDes != "")
                    rolesDes += ", ";
                rolesDes += rol;
            }
        }
        return rolesDes;
    }

    async Task OnNew()
    {        
        var res = await dialogService.OpenAsync<UserNew>($"New user",
               new Dictionary<string, object?>() {  },
               KntDialogs.Framed(KntDialogs.Medium()));

        if(res != null)           
            await Load();        
    }

    // The selected row: what the header's Edit and Delete act on.
    private IList<UserDto> selection = new List<UserDto>();
    private UserDto? Selected => selection.FirstOrDefault();

    private void OnCellContextMenu(DataGridCellMouseEventArgs<UserDto> args)
    {
        selection = [args.Data!];
        KntActionsMenu.Open(contextMenuService, args, ActionsOf(args.Data!));
    }

    private List<KntAction> ActionsOf(UserDto user) =>
    [
        new("Edit", "edit", () => OnEdit(user)),
        new("Delete", "delete", () => OnDelete(user), Danger: true)
    ];

    async Task OnEdit(UserDto user)
    {        
        var res = await dialogService.OpenAsync<UserEdit>($"Edit user",
               new Dictionary<string, object?>() { { "UserId", user.UserId.ToString() } },
               KntDialogs.Framed(KntDialogs.Medium()));

        if(res != null)
        {
            await Load();
        }        
    }

    // One delete at a time: a click or the Delete key repeated asks and deletes once.
    private readonly KntSingleFlight deleting = new();

    Task OnDelete(UserDto item) => deleting.RunAsync(() => DeleteAsync(item));

    async Task DeleteAsync(UserDto item)
    {                
        var resultDialog = await dialogService.Confirm(
            $"Are you sure you want delete user - {@item.UserName} - ({@item.FullName})?", 
            "Delete user", 
            new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });

        if (resultDialog == true)
        {
            var result = await store.Users.DeleteAsync(item.UserId);
            if (result.IsValid)                            
            {
                users = null;                
                await Load();
            }
        }
    }
    
}
