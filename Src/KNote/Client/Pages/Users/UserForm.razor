@inject NotificationService notificationService

<EditForm Model="User" Context="formContext">

    <DataAnnotationsValidator></DataAnnotationsValidator>

    <KntDialogFrame Icon="@(IsNew ? "person_add" : KntSections.Users.Icon)" Title="@Title" Subtitle="@Subtitle" OnClose="() => OnExit.InvokeAsync(null)">
        <ChildContent>

            <KntFormSection Icon="badge" Title="Account" Description="Who the user is and how to reach them.">
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeSM="5">
                        <KntField Label="User name" Component="UserName" Required="true" Help="To sign in.">
                            <RadzenTextBox Name="UserName" @bind-Value="@User.UserName" />
                            <ValidationMessage For="@(() => User.UserName)" />
                        </KntField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeSM="7">
                        <KntField Label="Email" Component="EMail" Required="true">
                            <RadzenTextBox Name="EMail" @bind-Value="@User.EMail" Placeholder="name@example.com" />
                            <ValidationMessage For="@(() => User.EMail)" />
                        </KntField>
                    </RadzenColumn>
                </RadzenRow>
                <KntField Label="Full name" Component="FullName" Required="true">
                    <RadzenTextBox Name="FullName" @bind-Value="@User.FullName" />
                    <ValidationMessage For="@(() => User.FullName)" />
                </KntField>
            </KntFormSection>

            <KntFormSection Icon="admin_panel_settings" Title="Roles" Description="What the user can do. The highest role selected is the one that counts.">
                <div class="knt-role-options">
                    @foreach (var role in roles)
                    {
                        var selected = valuesRoles.Contains(role.Key);
                        @* The whole tile toggles the role (the checkbox only shows it). *@
                        <div class="knt-role-option @(selected ? "knt-role-option-selected" : null)" role="checkbox" aria-checked="@(selected ? "true" : "false")"
                             tabindex="0" @onclick="() => OnRoleChanged(role.Key, !selected)" @onkeydown="e => OnRoleKey(e, role.Key, selected)">
                            <RadzenCheckBox TValue="bool" Value="@selected" ReadOnly="true" Style="pointer-events: none" TabIndex="-1" />
                            <span class="knt-role-option-text">
                                <span class="knt-role-option-name">@role.Value</span>
                                <span class="knt-role-option-description">@RoleDescription(role.Key)</span>
                            </span>
                        </div>
                    }
                </div>
                <ValidationMessage For="@(() => User.RoleDefinition)" />
            </KntFormSection>

        </ChildContent>
        <Footer>
            <RadzenButton Text="Cancel" Click="() => OnExit.InvokeAsync(null)" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" />
            <RadzenButton Text="Save" Icon="save" Click="() => Save(formContext)" ButtonStyle="ButtonStyle.Primary" />
        </Footer>
    </KntDialogFrame>

</EditForm>

@code {
    [Parameter] [EditorRequired] public UserDto User { get; set; } = null!;
    [Parameter] public string Title { get; set; } = "...";
    [Parameter] public EventCallback OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnExit { get; set; }

    List<MultiSelectListDto> roles = new List<MultiSelectListDto>();
    
    IEnumerable<string> valuesRoles = null!;

    private bool IsNew => User.UserId == Guid.Empty;

    private string Subtitle => IsNew ? "A new user of the app." : $"{User.UserName} · {User.FullName}";

    private void OnRoleChanged(string role, bool selected)
    {
        valuesRoles = selected ? valuesRoles.Append(role).Distinct().ToArray() : valuesRoles.Where(r => r != role).ToArray();
    }

    private void OnRoleKey(KeyboardEventArgs e, string role, bool selected)
    {
        if (e.Key == " " || e.Key == "Enter")
            OnRoleChanged(role, !selected);
    }

    private static string RoleDescription(string role) => role switch
    {
        nameof(EnumRoles.Guest) => "Reads the notes.",
        nameof(EnumRoles.Staff) => "Creates and edits notes, and uses the AI assistant.",
        nameof(EnumRoles.ProjectManager) => "Also manages folders and note types.",
        nameof(EnumRoles.Admin) => "Manages everything, users included.",
        _ => ""
    };

    protected override void OnInitialized()
    {
        foreach (var r in KntConst.Roles)
        {
            var selected = false;
            if (User.RoleDefinition?.IndexOf(r.Key.ToString()) >= 0)
            {
                selected = true;                
            }

            roles.Add(new MultiSelectListDto(selected, r.Key.ToString(), r.Value));          
        }

        valuesRoles = roles
                .Where(x => x.Selected == true)
                .Select(_ => _.Key).ToArray();
       
        base.OnInitialized();
    }

    protected async Task Save(EditContext formContext)
    {
        User.RoleDefinition = GetRolesDefinition();

        bool formIsValid = formContext.Validate();
        if (formIsValid == false)
        {            
            notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Save user.", Detail =  "Incorrect data, check the required attributes.", Duration = 12000 });
            return;
        }

        await OnValidSubmit.InvokeAsync(formContext);
    }

    private string GetRolesDefinition()
    {
        var strReturn = string.Join(", ", valuesRoles
            .Select(_ => _).ToArray());

        return strReturn;
    }
}
