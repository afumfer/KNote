@using KNote.Client.Pages.Auth

@implements IDisposable

@inject IStore store
@inject DialogService dialogService
@inject NotificationService notificationService

@* An Admin sets the password of a user (Users/UserEdit → "Set password"; api/users/{id}/password): for a user who
   forgot it, or one created without it. The user's open sessions are closed. The result is true if it was set, or
   null. *@

<EditForm Model="@this" Context="formContext" OnSubmit="OnSave">

    <KntDialogFrame Icon="key" Title="Set password" Subtitle="@User.UserName" OnClose="OnExit">
        <ChildContent>
            <RadzenStack Gap="1rem">
                <KntField Label="New password" Component="NewPassword" Required="true" Help="@ChangePassword.NewPasswordHelp">
                    <RadzenPassword Name="NewPassword" @bind-Value="@newPassword" AutoCompleteType="AutoCompleteType.NewPassword" />
                </KntField>
                <KntField Label="Confirm the new password" Component="ConfirmPassword" Required="true">
                    <RadzenPassword Name="ConfirmPassword" @bind-Value="@confirmPassword" AutoCompleteType="AutoCompleteType.NewPassword" />
                </KntField>
                <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" Size="AlertSize.Small" class="rz-m-0">
                    The sessions the user has open will be closed. Give them the new password in a safe way.
                </RadzenAlert>
            </RadzenStack>
        </ChildContent>
        <Footer>
            <RadzenButton Text="Cancel" Click="OnExit" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Disabled="@saving.IsBusy" />
            <RadzenButton Text="Set password" Icon="key" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Primary" IsBusy="@saving.IsBusy" />
        </Footer>
    </KntDialogFrame>

</EditForm>

@code {
    [Parameter] [EditorRequired] public UserDto User { get; set; } = null!;

    private readonly KntSingleFlight saving = new();
    private bool closed;

    private string? newPassword;
    private string? confirmPassword;

    private Task OnSave() => saving.RunAsync(SaveAsync);

    private async Task SaveAsync()
    {
        var error = KntPasswordPolicy.Validate(newPassword, User.UserName)
            ?? (newPassword != confirmPassword ? "The new password and its confirmation are not the same." : null);
        if (error != null)
        {
            notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Set password", Detail = error, Duration = 12000 });
            return;
        }

        var result = await store.Users.SetPasswordAsync(User.UserId, newPassword!);
        if (result.IsValid)
            CloseDialog(true);
    }

    private void OnExit()
    {
        if (!saving.IsBusy)
            CloseDialog(null);
    }

    public void Dispose() => closed = true;

    private void CloseDialog(object? result)
    {
        if (!closed)
            dialogService.Close(result);
    }
}
