@page "/users/edit/{UserId}"

@implements IDisposable

@inject IStore store
@inject DialogService dialogService

@attribute [Authorize(Roles = "Admin")]


<NavigationLock ConfirmExternalNavigation=true />

@if (user != null)
{
    <UserForm Title="Edit user" OnValidSubmit="OnSave" OnExit="OnExit" OnSetPassword="OnSetPassword" Saving="saving.IsBusy" User="user"></UserForm>
}
else
{
    <text>Loading ... </text>
}

@code {
    // One save at a time (a double click saves once), and leaving waits for it.
    private readonly KntSingleFlight saving = new();
    // Closed meanwhile (Esc): no result to give, and Radzen's Close would close the dialog on top, another one.
    private bool closed;

    [Parameter] public string UserId { get; set; } = string.Empty;

    private UserDto? user;

    protected async override Task OnInitializedAsync()
    {
        base.OnInitialized();

        Guid id;
        var parseOk = Guid.TryParse(UserId, out id);
        if (!parseOk)
        {
            await dialogService.Alert("Invalid user identifier.");
            CloseDialog(null);
            return;
        }

        var result = await store.Users.GetAsync(id);
        if (!result.IsValid)                    
            CloseDialog(null);
        else
        {
            user = result.Entity;
            user.SetIsDirty(false);
        }
    }

    private Task OnSave() => saving.RunAsync(SaveAsync);

    private async Task SaveAsync()
    {
        if (!user!.IsDirty())
        {            
            CloseDialog(user);
        }
        else
        {
            if (user.IsValid())                            
            {
                var result = await store.Users.SaveAsync(user);
                if (result.IsValid)                                    
                {                    
                    CloseDialog(result.Entity);
                }
            }
        }
    }

    private async Task OnSetPassword()
    {
        if (saving.IsBusy)
            return;

        await dialogService.OpenAsync<UserSetPassword>("Set password",
            new Dictionary<string, object?>() { { "User", user } },
            KntDialogs.Framed(KntDialogs.Small()));
    }

    private async Task OnExit()
    {                
        if (saving.IsBusy)
            return;

        if (user == null)
        {
            CloseDialog(null);
            return;
        }
                  
        if (user.IsDirty())
        {
            var resultDialog = await dialogService.Confirm(
                @"Do you want to leave the page and lose your changes?",
                $"{KntConst.AppName}",
                new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });

            if (resultDialog == true)
            {
                CloseDialog(null);
            }
        }
        else
        {
            CloseDialog(null);
        }
    }

    public void Dispose() => closed = true;

    private void CloseDialog(object? result)
    {
        if (!closed)
            dialogService.Close(result);
    }
}
