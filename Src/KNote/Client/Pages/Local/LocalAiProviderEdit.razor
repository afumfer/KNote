@* An AI provider of KNote Local's computer (LocalAiProviders): its alias, kind (chat or embeddings), provider, model,
   host (Ollama), context size (Ollama chat models) and API key. The key is never shown: empty keeps the saved one.
   "Test" asks the provider as it is being edited. Gives back the provider changed (a copy), saved by the list. *@

@implements IDisposable
@inject IStore store
@inject DialogService dialogService

<KntDialogFrame Icon="smart_toy" Title="AI provider" Subtitle="@(string.IsNullOrEmpty(Provider.Alias) ? "A new AI provider." : Provider.Alias)"
                OnClose="() => dialogService.Close(null)">
    <ChildContent>
        <KntFormSection Icon="badge" Title="General">
            <KntField Label="Alias" Component="Alias" Required="true" Help="The name you choose it by.">
                <RadzenTextBox Name="Alias" @bind-Value="@provider.Alias" />
            </KntField>
            <KntField Label="Kind" Component="Kind" Help="A chat model (the AI assistant) or an embedding model (the search by meaning).">
                <RadzenSelectBar Name="Kind" TValue="string" Value="@provider.Kind" ValueChanged="OnKindChanged" Size="ButtonSize.Small">
                    <Items>
                        <RadzenSelectBarItem Text="Chat" Value="@EnumAiProviderKind.Chat" />
                        <RadzenSelectBarItem Text="Embeddings" Value="@EnumAiProviderKind.Embeddings" />
                    </Items>
                </RadzenSelectBar>
            </KntField>
            <KntField Label="Provider" Component="ProviderName" Required="true"
                      Help="@(IsEmbeddings ? "Only Ollama and OpenAI offer embedding models." : null)">
                <RadzenDropDown Name="ProviderName" @bind-Value="@provider.Provider" Data="@(IsEmbeddings ? EnumAiProvider.WithEmbeddings : EnumAiProvider.All)" />
            </KntField>
            <KntField Label="Model" Component="Model" Required="true" Help="@ModelHelp">
                <RadzenTextBox Name="Model" @bind-Value="@provider.Model" />
            </KntField>
            @if (provider.Provider == EnumAiProvider.Ollama)
            {
                <KntField Label="Host" Component="Host" Required="true" Help="Where Ollama runs, for example http://localhost:11434.">
                    <RadzenTextBox Name="Host" @bind-Value="@provider.Host" />
                </KntField>
                @if (!IsEmbeddings)
                {
                    <KntField Label="Context size" Component="ContextWindow" Help="@ContextWindowHelp">
                        <RadzenNumeric Name="ContextWindow" TValue="int?" @bind-Value="@provider.ContextWindow" Min="AiProviderRef.MinContextWindow"
                                       Max="AiProviderRef.MaxContextWindow" Step="1024" ShowUpDown="false" />
                    </KntField>
                    <KntField Label="Web search API key" Component="WebSearchApiKey" Help="@WebSearchKeyHelp">
                        <RadzenPassword Name="WebSearchApiKey" @bind-Value="@provider.WebSearchApiKey" AutoCompleteType="AutoCompleteType.Off"
                                        Disabled="@provider.RemoveWebSearchApiKey" />
                    </KntField>
                    @if (Provider.HasWebSearchApiKey)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <RadzenCheckBox Name="RemoveWebSearchApiKey" TValue="bool" @bind-Value="@provider.RemoveWebSearchApiKey" />
                            <RadzenLabel Text="Remove the saved web search key" Component="RemoveWebSearchApiKey" />
                        </RadzenStack>
                    }
                }
            }
            else
            {
                <KntField Label="API key" Component="ApiKey" Help="@(Provider.HasApiKey ? "Saved: leave it empty to keep it." : "The key the provider gives you. It is kept encrypted.")">
                    <RadzenPassword Name="ApiKey" @bind-Value="@provider.ApiKey" AutoCompleteType="AutoCompleteType.Off" />
                </KntField>
            }
            @if (testMessage != null)
            {
                <RadzenAlert AlertStyle="@(testPassed ? AlertStyle.Success : AlertStyle.Danger)" Shade="Shade.Lighter" Variant="Variant.Flat"
                             AllowClose="false" Size="AlertSize.Small" class="rz-mt-2">
                    @testMessage
                </RadzenAlert>
            }
        </KntFormSection>
    </ChildContent>
    <Footer>
        <RadzenButton Text="Test" Icon="network_check" Click="OnTest" IsBusy="@testing.IsBusy" BusyText="Testing..."
                      ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="knt-footer-start" />
        <RadzenButton Text="Cancel" Click="() => dialogService.Close(null)" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" />
        <RadzenButton Text="Save" Icon="save" Click="OnSave" ButtonStyle="ButtonStyle.Primary" />
    </Footer>
</KntDialogFrame>

@code {
    [Parameter][EditorRequired] public LocalAiProviderDto Provider { get; set; } = null!;

    private const string ContextWindowHelp =
        "How much text the model reads at once, in tokens (for example 131072). Empty: the model's own. Each change makes Ollama load the model again.";

    private LocalAiProviderDto provider = new();
    private readonly KntSingleFlight testing = new();
    private readonly CancellationTokenSource disposal = new();
    private string? testMessage;
    private bool testPassed;

    private bool IsEmbeddings => provider.Kind == EnumAiProviderKind.Embeddings;

    // Optional: the key of an ollama.com account, only for the Internet search of the assistant.
    private string WebSearchKeyHelp => Provider.HasWebSearchApiKey
        ? "Saved: leave it empty to keep it."
        : "Optional: the key of an ollama.com account, so that the assistant can search the Internet (ollama.com's web search). The model still runs where Host says. It is kept encrypted.";

    private string ModelHelp => IsEmbeddings
        ? "The embedding model, for example qwen3-embedding:0.6b or text-embedding-3-small."
        : "The model of the provider, for example gpt-4o-mini, claude-haiku-4-5 or qwen3.5:9b.";

    protected override void OnInitialized() => provider = new LocalAiProviderDto
    {
        Index = Provider.Index,
        Alias = Provider.Alias,
        Provider = Provider.Provider,
        Model = Provider.Model,
        Kind = Provider.Kind ?? EnumAiProviderKind.Chat,
        ContextWindow = Provider.ContextWindow,
        Host = Provider.Host,
        HasApiKey = Provider.HasApiKey,
        HasWebSearchApiKey = Provider.HasWebSearchApiKey
    };

    private void OnKindChanged(string kind)
    {
        provider.Kind = kind;
        if (IsEmbeddings && !EnumAiProvider.WithEmbeddings.Contains(provider.Provider))
            provider.Provider = EnumAiProvider.Ollama;
        testMessage = null;
    }

    private Task OnTest() => testing.RunAsync(async () =>
    {
        testMessage = null;
        var result = await store.Local.TestAiProviderAsync(provider, disposal.Token);
        if (disposal.IsCancellationRequested)
            return;
        testPassed = result.IsValid;
        testMessage = result.IsValid ? result.Entity : result.ErrorMessage;
    });

    private void OnSave() => dialogService.Close(provider);

    public void Dispose()
    {
        disposal.Cancel();
        disposal.Dispose();
    }
}
