@page "/"
@page "/index"

@using KNote.Client.Pages.Notes

@implements IDisposable

@inject IStore store
@inject KntWindows kntWindows
@inject TooltipService tooltipService
@inject DialogService dialogService
@inject AuthenticationStateProvider authenticationStateProvider

@*@attribute [Authorize(Roles = "Guest, Staff, ProjectManager, Admin")]*@

@* Home header: the app's entry point, with more presence than the section headers (KntIndexHeader). *@
<div class="knt-home-hero">
    <div class="knt-home-hero-brand">
        <KntLogo Size="48" Class="knt-home-hero-logo" />
        <h1 class="knt-home-hero-title">@Title</h1>
    </div>
    <div class="knt-home-hero-info">
        <span class="knt-home-hero-subtitle">@KntConst.AppDescription</span>
        <span class="knt-home-hero-version">v@(store.AppState.AppVersion)</span>
    </div>
</div>

@* At the right of the notes, Home and the folders directly inside it (only when it has any). *@
<div class="@(HasFolders ? "knt-home-content knt-home-with-folders" : "knt-home-content")">
    <div class="knt-home-notes">
        <NotesList Notes="notes" LoadFailed="notesFailed" Retry="LoadNotes" EmptyTitle="@EmptyTitle" EmptyText="@EmptyText"
                   OnNoteDelete="OnNoteDelete" OnNoteEdit="OnNoteEdit" OnNoteView="OnNoteView" />
    </div>
    @if (HasFolders)
    {
        <HomeFolders Folders="folders!" SelectedFolderId="selectedFolderId" SelectedFolderIdChanged="SelectFolderAsync" />
    }
</div>


@code {    

    private List<NoteInfoDto>? notes;
    // The notes could not be read: the list says so, with Retry (the error is already notified). Without it the list
    // would show "loading" for ever.
    private bool notesFailed;

    // The folders directly inside Home, and the one whose notes are shown (null: Home's own).
    private List<FolderInfoDto>? folders;
    private Guid? selectedFolderId;

    private bool HasFolders => folders?.Count > 0;

    // Without notes, Home says which folder they come from: Home itself or the one chosen in the side panel.
    private string? SelectedFolderName => folders?.FirstOrDefault(f => f.FolderId == selectedFolderId)?.Name;

    private string EmptyTitle => SelectedFolderName is { } name ? $"No notes in {name} yet" : "No notes in Home yet";

    private string EmptyText => SelectedFolderName is { } name
        ? $"The notes saved in the folder {name} are shown here."
        : "The notes saved in the Home folder are shown here.";

    // The repository's name (read by MainLayout): empty while it is read, the application's name if it can't be.
    private string Title => store.AppState.RepositoryName switch
    {
        null => "",
        "" => KntConst.AppName,
        var name => name
    };


    protected override async Task OnInitializedAsync()
    {        
        store.AppState.OnChange += StateHasChanged;
        kntWindows.NoteSaved += OnNoteSaved;
        authenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;

        selectedFolderId = store.AppState.HomeFolderId;
        await LoadFolders();
        await LoadNotes();
    }

    // Signed in, out or in another repository: Home is the one of the session's repository (or, without a session, of
    // the server's default one).
    private void OnAuthenticationStateChanged(Task<AuthenticationState> state)
    {
        _ = InvokeAsync(async () =>
        {
            await state;
            selectedFolderId = store.AppState.HomeFolderId;
            await LoadFolders();
            await LoadNotes();
            StateHasChanged();
        });
    }

    // Leaving Home: what is being read is no longer needed.
    private readonly CancellationTokenSource disposal = new();
    // The notes of the folder chosen last: choosing another one (or a note saved) meanwhile cancels the ones being read.
    private readonly KntLatestRequest notesRequest = new();

    public void Dispose()
    {
        store.AppState.OnChange -= StateHasChanged;
        kntWindows.NoteSaved -= OnNoteSaved;
        authenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        disposal.Cancel();
        notesRequest.Dispose();
    }

    private async Task LoadFolders()
    {
        var result = await store.Folders.GetHomeChildrenAsync(disposal.Token);
        // Left: the folder shown is kept for the next time.
        if (disposal.IsCancellationRequested)
            return;
        folders = result.IsValid ? result.Entity : null;

        // The folder shown last time may have been deleted or moved meanwhile.
        if (selectedFolderId != null && folders?.Any(f => f.FolderId == selectedFolderId) != true)
            selectedFolderId = store.AppState.HomeFolderId = null;
    }

    private async Task LoadNotes()
    {
        var folderId = selectedFolderId;
        notes = null;
        notesFailed = false;
        var request = await notesRequest.RunAsync(ct => store.Notes.GetHomeNotesAsync(folderId, ct));

        // Another folder was chosen while these notes were read: its own notes are on their way.
        if (request.Canceled)
            return;

        if (request.Value.IsValid)
            notes = request.Value.Entity;
        else
            notesFailed = true;
    }

    private async Task SelectFolderAsync(Guid? folderId)
    {
        if (folderId == selectedFolderId)
            return;

        selectedFolderId = store.AppState.HomeFolderId = folderId;
        await LoadNotes();
    }

    private Task OnNoteView(NoteInfoDto note) => kntWindows.OpenViewAsync(note.NoteId);

    private Task OnNoteEdit(NoteInfoDto note) => kntWindows.OpenEditAsync(note.NoteId);

    // A note saved in its window: Home shows it changed.
    private void OnNoteSaved(Guid noteId)
    {
        _ = InvokeAsync(async () => { await LoadNotes(); StateHasChanged(); });
    }

    // One delete at a time: a click or the Delete key repeated asks and deletes once.
    private readonly KntSingleFlight deleting = new();

    Task OnNoteDelete(NoteInfoDto item) => deleting.RunAsync(() => DeleteAsync(item));

    async Task DeleteAsync(NoteInfoDto item)
    {
        var resultDialog = await dialogService.Confirm(
            $"Are you sure you want delete note - {@item.Topic} - ({@item.NoteNumber})?",
            "Delete note",
            new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });

        if (resultDialog == true)
        {
            var result = await store.Notes.DeleteAsync(item.NoteId);
            if (result.IsValid)                            
            {            
                await LoadNotes();
            }
        }
    }

}
