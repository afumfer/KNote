@page "/aiassistant"

@using System.Text

@inject IStore store
@inject DialogService dialogService
@inject NotificationService notificationService
@inject TooltipService tooltipService
@inject IJSRuntime jsRuntime
@inject KntWindows kntWindows

@implements IAsyncDisposable

@attribute [Authorize(Roles = "Staff, ProjectManager, Admin")]

@* The AI assistant: the conversation and the prompt on the left, the user's sessions on the right. It can go on in a
   window of its own (AIAssistantWindow, InWindow), resuming the session shown. *@

<NavigationLock OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

<KntIndexHeader Section="KntSections.AiAssistant">
    <IndexMenu>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenIcon Icon="psychology" Style="color: var(--rz-text-secondary-color)"
                        MouseEnter="@(args => tooltipService.Open(args, "AI model", new TooltipOptions { Position = TooltipPosition.Left }))" />
            <RadzenDropDown TValue="string" Data="@providers" TextProperty="Alias" ValueProperty="Alias"
                            Value="@providerAlias" Change="@OnProviderChange" Disabled="@(streaming || providers.Count == 0)"
                            Placeholder="No AI providers" Style="width: 16rem" />
            <RadzenButton Icon="add_comment" ButtonStyle="ButtonStyle.Secondary" Click="NewConversation" Disabled="@streaming"
                          MouseEnter="@(args => tooltipService.Open(args, "New conversation", new TooltipOptions { Position = TooltipPosition.Left }))" />
            @if (!InWindow)
            {
                <RadzenButton Icon="open_in_new" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Click="OpenInWindow"
                              Disabled="@(streaming || pendingSave)"
                              MouseEnter="@(args => tooltipService.Open(args, "Open in a new window", new TooltipOptions { Position = TooltipPosition.Left }))" />
            }
        </RadzenStack>
    </IndexMenu>
</KntIndexHeader>

@* Both panes sized in %: a pane without a size, or sized in px, left the sessions out of view. *@
<div class="ai-assistant">
<RadzenSplitter Style="@($"height: {Height}")" class="rz-mt-2">
    <RadzenSplitterPane Size="75%">
        @* The prompt pane starts as tall as the box had (Rows="3"), 82px; its bar makes it taller or shorter. The chat
           pane needs a size: without one Radzen gives it 100% and the prompt is left out of view. *@
        <RadzenSplitter Orientation="Orientation.Vertical" class="ai-chat-split">
            <RadzenSplitterPane Size="calc(100% - 90px)" Min="40%">
                <AiChatView Turns="@session.Turns" PendingPrompt="@pendingPrompt" PendingAnswer="@pendingAnswer.ToString()"
                            PendingAttachments="@sentAttachments" SessionNoteId="@session.NoteId" AttachmentShown="OnAttachmentShown"
                            PendingReasoning="@pendingReasoning.ToString()" Thinking="@thinking"
                            PendingAutomatic="@pendingAutomatic" ActionsAnswered="OnActionsAnswered" ActionsDisabled="@(streaming || runningActions)"
                            ToolInUse="@toolInUse" CreatedNotes="@createdNotes" ContainerId="@ChatContainerId" />
            </RadzenSplitterPane>
            <RadzenSplitterPane Size="82px" Min="62px">
                <div @ref="promptArea" class="ai-prompt-area">
                @if (!streaming && pendingFiles.Count > 0)
                {
                    <div class="ai-prompt-files">
                        @foreach (var file in pendingFiles)
                        {
                            <span class="ai-prompt-file">
                                @file.Upload.FileName
                                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.ExtraSmall"
                                              Click="@(() => pendingFiles.Remove(file))" />
                            </span>
                        }
                        @if (SentToProvider != null)
                        {
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-my-0">Images are sent to @SentToProvider.</RadzenText>
                        }
                    </div>
                }
                @if (WebSearchOn)
                {
                    <div class="ai-prompt-files">
                        <RadzenIcon Icon="public" Style="font-size: 1rem; color: var(--rz-warning)" />
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-my-0">@AiWebSearchRules.Notice(currentProvider?.Provider)</RadzenText>
                    </div>
                }
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" Gap="0.5rem" class="ai-prompt">
                    @if (currentProvider?.SupportsWebSearch == true)
                    {
                        <RadzenToggleButton Icon="public" @bind-Value="webSearch" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                                            ToggleButtonStyle="ButtonStyle.Warning" ToggleShade="Shade.Default" Disabled="@streaming"
                                            MouseEnter="@(args => tooltipService.Open(args, AiWebSearchRules.ToggleText, new TooltipOptions { Position = TooltipPosition.Top }))" />
                    }
                    <RadzenButton Icon="attach_file" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Click="PickFiles"
                                  Disabled="@(streaming || uploadingFiles || currentProvider == null)"
                                  MouseEnter="@(args => tooltipService.Open(args, "Attach files (you can also paste or drop them here)", new TooltipOptions { Position = TooltipPosition.Top }))" />
                    <RadzenTextArea @bind-Value="promptInput" Immediate="true" class="ai-prompt-input"
                                    Placeholder="Ask the assistant ... (Ctrl+Enter to send)" Disabled="@(streaming || currentProvider == null)"
                                    @onkeydown="OnPromptKeyDown" />
                    @if (streaming)
                    {
                        <RadzenButton Icon="stop" ButtonStyle="ButtonStyle.Danger" Click="StopAnswer"
                                      MouseEnter="@(args => tooltipService.Open(args, "Stop the answer", new TooltipOptions { Position = TooltipPosition.Left }))" />
                    }
                    else
                    {
                        <RadzenButton Icon="send" ButtonStyle="ButtonStyle.Primary" Click="Send"
                                      Disabled="@(string.IsNullOrWhiteSpace(promptInput) || currentProvider == null)"
                                      MouseEnter="@(args => tooltipService.Open(args, "Send (Ctrl+Enter)", new TooltipOptions { Position = TooltipPosition.Left }))" />
                    }
                </RadzenStack>
                </div>
            </RadzenSplitterPane>
        </RadzenSplitter>
    </RadzenSplitterPane>
    <RadzenSplitterPane Size="25%" Min="200px" Max="45%" Collapsible="true">
        <AiSessionsList Sessions="@sessions" SelectedNoteId="@session.NoteId" SelectedTokens="@TotalTokens"
                        Disabled="@streaming" OnSelect="OpenSession" />
    </RadzenSplitterPane>
</RadzenSplitter>
</div>

@code {
    // In the assistant's own window (AIAssistantWindow): no button to open it in another one, as tall as the window
    // (no app header and footer), and closing the window asks first while there is something to lose.
    [Parameter] public bool InWindow { get; set; }

    // The session to resume first (in a window, the one the main window showed).
    [Parameter] public Guid? SessionId { get; set; }

    private const string ChatContainerId = "aichatcontainer";
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromMilliseconds(100);

    private List<AiProviderInfoDto> providers = new();
    private AiProviderInfoDto? currentProvider;
    private string? providerAlias;

    private List<AiChatSessionInfoDto> sessions = new();
    private AiChatSessionDto session = new();
    // The session has turns not saved yet (a save failed): saved again before leaving it.
    private bool pendingSave;

    private string? promptInput;
    private bool streaming;
    private string? pendingPrompt;
    private readonly StringBuilder pendingAnswer = new();
    private readonly StringBuilder pendingReasoning = new();
    private bool thinking;
    private string? toolInUse;
    private bool pendingAutomatic;
    private bool runningActions;
    // The kinds of action not to ask about again in this conversation.
    private readonly HashSet<string> autoApprovedKinds = new();
    private CancellationTokenSource? answerCancellation;
    private DateTime lastRefresh;
    private bool scrollToBottom;

    // The notes created by the assistant in this session, by turn (shown only while the page is open).
    private readonly Dictionary<int, List<AiChatStreamEventDto>> createdNotes = new();

    private DotNetObjectReference<AIAssistant>? selfReference;
    private IJSObjectReference? unsavedChangesWatch;

    // A file of the message being written. Saved: already in the note of the session, if the message has to be sent again.
    private sealed class PendingFile
    {
        public required AiChatAttachmentUploadDto Upload { get; init; }
        public AiChatAttachmentDto? Saved { get; set; }
    }

    private readonly List<PendingFile> pendingFiles = new();
    private IReadOnlyList<AiChatAttachmentDto> sentAttachments = Array.Empty<AiChatAttachmentDto>();
    private bool uploadingFiles;
    private ElementReference promptArea;
    private IJSObjectReference? attachmentsModule;
    private IJSObjectReference? attachments;

    // A paid provider: the images leave the computer, and KNote says so.
    private string? SentToProvider => pendingFiles.Any(f => AiAttachmentRules.IsImage(f.Upload.ContentType)) && currentProvider?.Provider != EnumAiProvider.Ollama
        ? currentProvider?.Provider
        : null;

    private long TotalTokens => session.Turns.Sum(t => t.TotalTokens);

    // "Search the Internet" (KNote Atlas, chapter 23): off in each new or resumed conversation, and only with a provider
    // that can search.
    private bool webSearch;

    private bool WebSearchOn => webSearch && currentProvider?.SupportsWebSearch == true;

    private string Height => InWindow ? "calc(100vh - 5rem)" : "calc(100vh - 10rem)";

    #region Life cycle

    protected override async Task OnInitializedAsync()
    {
        var resProviders = await store.AiAssistant.GetProvidersAsync();
        if (resProviders.IsValid)
            providers = resProviders.Entity ?? new();
        SetProvider(providers.FirstOrDefault(p => p.IsDefault) ?? providers.FirstOrDefault());

        if (providers.Count == 0)
            notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "AI Assistant",
                Detail = "No AI providers are configured in the server (section \"ai\" of its configuration).",
                Duration = 10000
            });

        // Also creates, the first time, the note type and folder where the sessions are kept.
        await LoadSessionsAsync();

        if (SessionId is Guid sessionId && sessionId != Guid.Empty)
            await OpenSession(sessionId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            selfReference = DotNetObjectReference.Create(this);
            if (InWindow)
                unsavedChangesWatch = await kntWindows.WatchUnsavedChangesAsync(selfReference);

            // Without its script (the server not reachable, already notified) files can't be attached.
            attachmentsModule = await jsRuntime.ImportModuleAsync("./js/aiAttachments.js", store.AppState);
            if (attachmentsModule != null)
                attachments = await attachmentsModule.InvokeAsync<IJSObjectReference>("init", promptArea, selfReference, KntConst.MaxLenResourceFile);
        }

        if (!scrollToBottom)
            return;
        scrollToBottom = false;
        try
        {
            await jsRuntime.InvokeVoidAsync("ScrollToBottom", ChatContainerId);
        }
        catch
        {
            // Only a convenience.
        }
    }

    public async ValueTask DisposeAsync()
    {
        answerCancellation?.Cancel();
        answerCancellation?.Dispose();

        try
        {
            if (unsavedChangesWatch != null)
            {
                await unsavedChangesWatch.InvokeVoidAsync("dispose");
                await unsavedChangesWatch.DisposeAsync();
            }
            if (attachments != null)
            {
                await attachments.InvokeVoidAsync("dispose");
                await attachments.DisposeAsync();
            }
            if (attachmentsModule != null)
                await attachmentsModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The window is being closed: nothing left to clean up in the browser.
        }
        selfReference?.Dispose();
    }

    /// <summary>Asked by the browser before the assistant's window is closed or reloaded
    /// (KntWindows.WatchUnsavedChangesAsync): the answer being written, or a conversation not saved, would be lost.</summary>
    [JSInvokable]
    public bool HasUnsavedChanges() => streaming || pendingSave;

    // The assistant goes on in its own window, with the session shown (saved: the button waits for it), and this one
    // goes Home. The window is opened first thing: the browser only allows it right after the click.
    private async Task OpenInWindow()
    {
        if (await kntWindows.OpenAiAssistantAsync(session.NoteId))
            store.NavigateTo("index");
    }

    private async Task OnBeforeInternalNavigation(LocationChangingContext context)
    {
        if (streaming)
        {
            var leave = await dialogService.Confirm("The assistant is still answering. Do you want to leave and lose the answer?",
                "AI Assistant", new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" });
            if (leave != true)
            {
                context.PreventNavigation();
                return;
            }
            answerCancellation?.Cancel();
        }

        if (!await SaveSessionAsync())
        {
            var leave = await dialogService.Confirm("The conversation could not be saved. Do you want to leave and lose its last messages?",
                "AI Assistant", new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" });
            if (leave != true)
                context.PreventNavigation();
        }
    }

    #endregion

    #region Conversation

    private async Task OnPromptKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey && e.Key == "Enter")
            await Send();
    }

    private async Task Send()
    {
        var prompt = promptInput;
        if (streaming || runningActions || uploadingFiles || currentProvider == null || string.IsNullOrWhiteSpace(prompt))
            return;

        if (!await SaveFilesAsync(prompt!))
            return;

        // A new message without answering the card rejects what it proposed: the model is told.
        AiActionRules.RejectPending(session.Turns);
        sentAttachments = pendingFiles.Select(f => f.Saved!).ToList();
        await SendTurnAsync(prompt!, automatic: false);
    }

    // The files of the message go to the note of the session first: from there they reach the model and the conversation.
    private async Task<bool> SaveFilesAsync(string prompt)
    {
        uploadingFiles = true;
        try
        {
            foreach (var file in pendingFiles.Where(f => f.Saved == null))
            {
                file.Upload.SessionNoteId = session.NoteId;
                file.Upload.Provider = currentProvider!.Provider;
                file.Upload.Model = currentProvider.Model;
                file.Upload.Topic = prompt;

                var res = await store.AiAssistant.AddAttachmentAsync(file.Upload);
                if (!res.IsValid)
                    return false;

                file.Saved = res.Entity;
                session.NoteId = res.Entity.SessionNoteId;
            }
            return true;
        }
        finally
        {
            uploadingFiles = false;
        }
    }

    private async Task PickFiles()
    {
        if (attachments != null)
            await attachments.InvokeVoidAsync("pick");
    }

    // A file pasted, dropped or chosen (js/aiAttachments.js). A pasted screenshot comes without a name.
    [JSInvokable]
    public async Task OnAttachment(string fileName, string contentType, string contentBase64)
    {
        if (pendingFiles.Count >= AiAttachmentRules.MaxPerMessage)
        {
            NotifyFile("Too many files", $"A message can have {AiAttachmentRules.MaxPerMessage} files at most.");
            return;
        }

        if (string.IsNullOrWhiteSpace(fileName))
            fileName = $"image-{DateTime.Now:yyyyMMdd-HHmmss}.{contentType.Split('/')[^1].Replace("jpeg", "jpg")}";
        if (string.IsNullOrWhiteSpace(contentType))
            contentType = AiAttachmentRules.ContentTypeOf(fileName);

        pendingFiles.Add(new PendingFile
        {
            Upload = new AiChatAttachmentUploadDto { FileName = fileName, ContentType = contentType, ContentBase64 = contentBase64 }
        });
        StateHasChanged();

        if (AiAttachmentRules.IsImage(contentType) && currentProvider != null)
        {
            var capabilities = await store.AiAssistant.GetCapabilitiesAsync(currentProvider.Alias);
            if (capabilities.IsValid && capabilities.Entity?.SupportsImages == false)
                NotifyFile("This model does not see images", $"{currentProvider.Alias} will not receive {fileName}: it is only saved with the conversation.");
        }
    }

    [JSInvokable]
    public void OnAttachmentTooBig(string fileName) =>
        NotifyFile("File too big", $"{fileName}: {KntConst.MaxLenResourceFile / 1_000_000.0:0.#} MB at most.");

    private void NotifyFile(string summary, string detail) =>
        notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = summary, Detail = detail, Duration = 8000 });

    // automatic: the turn the app sends after a card, not a question of the user.
    private async Task SendTurnAsync(string prompt, bool automatic)
    {
        var provider = currentProvider;
        if (provider == null)
            return;

        var request = new AiChatRequestDto
        {
            ProviderAlias = provider.Alias,
            History = session.Turns.ToList(),
            Prompt = prompt,
            AutoApprovedActionKinds = autoApprovedKinds.ToList(),
            WebSearch = WebSearchOn,
            SessionNoteId = session.NoteId,
            Attachments = automatic ? new() : sentAttachments.ToList()
        };

        streaming = true;
        pendingAutomatic = automatic;
        if (!automatic)
            promptInput = "";
        pendingPrompt = prompt;
        pendingAnswer.Clear();
        pendingReasoning.Clear();
        thinking = false;
        toolInUse = null;
        answerCancellation = new CancellationTokenSource();
        scrollToBottom = true;
        StateHasChanged();

        AiChatTurnDto? completedTurn = null;
        try
        {
            await foreach (var e in store.AiAssistant.ChatAsync(request, answerCancellation.Token))
            {
                switch (e.Type)
                {
                    case AiChatStreamEventTypes.Delta:
                        pendingAnswer.Append(e.Text);
                        toolInUse = null;
                        thinking = false;
                        RefreshWhileStreaming();
                        break;
                    case AiChatStreamEventTypes.Reasoning:
                        var started = !thinking;
                        pendingReasoning.Append(e.Text);
                        toolInUse = null;
                        thinking = true;
                        RefreshWhileStreaming(force: started);
                        break;
                    case AiChatStreamEventTypes.Tool:
                        toolInUse = e.Text;
                        thinking = false;
                        RefreshWhileStreaming(force: true);
                        break;
                    case AiChatStreamEventTypes.NoteCreated:
                        AddCreatedNote(session.Turns.Count, e);
                        break;
                    case AiChatStreamEventTypes.OpenNote:
                        await OpenNoteAsync(session.Turns.Count, e);
                        break;
                    case AiChatStreamEventTypes.Completed:
                        completedTurn = e.Turn;
                        // It does not travel with the turn: it is not saved, nor sent back with the history.
                        if (completedTurn != null && pendingReasoning.Length > 0)
                            completedTurn.Reasoning = pendingReasoning.ToString().Trim();
                        break;
                    // Error: already notified by the service; the turn stays unanswered.
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Stopped by the user, or the page was left.
        }
        finally
        {
            streaming = false;
            pendingPrompt = null;
            sentAttachments = Array.Empty<AiChatAttachmentDto>();
            pendingAnswer.Clear();
            pendingReasoning.Clear();
            thinking = false;
            toolInUse = null;
            answerCancellation?.Dispose();
            answerCancellation = null;
        }

        if (completedTurn != null)
        {
            // The session is held with the provider of its last answer (see AiProviderSelection).
            session.Provider = provider.Provider;
            session.Model = provider.Model;
            completedTurn.Automatic = automatic;
            session.Turns.Add(completedTurn);
            if (!automatic)
                pendingFiles.Clear();
            await NotifyChangedNotesAsync(completedTurn.Actions);
            pendingSave = true;
            scrollToBottom = true;
            StateHasChanged();
            await SaveSessionAsync();
        }
        else
        {
            // Not answered (stopped or failed): the question is back in the box, to send it again.
            if (!automatic)
                promptInput = prompt;
            createdNotes.Remove(session.Turns.Count);
        }

        StateHasChanged();
    }

    private void StopAnswer() => answerCancellation?.Cancel();

    // They only load with their message or on opening the session, so this does not move what the user is reading.
    private void OnAttachmentShown() => scrollToBottom = true;

    // The card of the last turn: what is not accepted is rejected, the rest is run and, if anything was accepted, the assistant
    // goes on by itself (D3): what was asked may depend on it.
    private async Task OnActionsAnswered(AiActionsCard.AiActionsAnswer answer)
    {
        if (streaming || runningActions || session.Turns.Count == 0)
            return;

        var proposed = session.Turns[^1].Actions.Where(a => a.Status == EnumAiActionStatus.Proposed).ToList();
        var accepted = proposed.Where(a => answer.Accepted.Contains(a.ActionId)).ToList();
        proposed.Except(accepted).ToList().ForEach(a => a.Status = EnumAiActionStatus.Rejected);

        if (accepted.Count > 0)
        {
            runningActions = true;
            var res = await store.AiAssistant.RunActionsAsync(accepted);
            runningActions = false;
            foreach (var action in accepted)
            {
                var ran = res.Entity?.FirstOrDefault(a => a.ActionId == action.ActionId);
                action.Status = ran?.Status ?? EnumAiActionStatus.Failed;
                action.Result = ran != null ? ran.Result : res.ErrorMessage;
            }
            if (answer.DontAskAgain)
                autoApprovedKinds.UnionWith(accepted.Select(a => a.Kind));
            await NotifyChangedNotesAsync(accepted);
        }

        pendingSave = true;
        scrollToBottom = true;
        StateHasChanged();
        await SaveSessionAsync();

        if (accepted.Count > 0)
            await SendTurnAsync(AiActionRules.ContinuePrompt, automatic: true);
    }

    // The lists and the windows of the notes show them changed.
    private async Task NotifyChangedNotesAsync(IEnumerable<AiActionDto> actions)
    {
        foreach (var noteId in actions.Where(a => a.Status == EnumAiActionStatus.Done && a.NoteId != null).Select(a => a.NoteId!.Value).Distinct())
            await kntWindows.NotifyNoteSavedAsync(noteId);
    }

    private void RefreshWhileStreaming(bool force = false)
    {
        if (!force && DateTime.Now - lastRefresh < RefreshInterval)
            return;
        lastRefresh = DateTime.Now;
        scrollToBottom = true;
        StateHasChanged();
    }

    private void AddNoteLink(int turnIndex, AiChatStreamEventDto note)
    {
        if (!createdNotes.TryGetValue(turnIndex, out var notes))
            createdNotes[turnIndex] = notes = new();
        notes.Add(note);
    }

    // No click opens this window, so a browser may block it: the link stays in the conversation for that.
    private async Task OpenNoteAsync(int turnIndex, AiChatStreamEventDto note)
    {
        AddNoteLink(turnIndex, note);
        StateHasChanged();
        await kntWindows.OpenEditAsync(note.NoteId!.Value);
    }

    private void AddCreatedNote(int turnIndex, AiChatStreamEventDto note)
    {
        AddNoteLink(turnIndex, note);

        notificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Success,
            Summary = "AI Assistant",
            Detail = $"Note #{note.NoteNumber} created: {note.Text}",
            Duration = 6000
        });
        StateHasChanged();
    }

    #endregion

    #region Sessions and provider

    private async Task LoadSessionsAsync()
    {
        var res = await store.AiAssistant.GetSessionsAsync();
        if (res.IsValid)
            sessions = res.Entity ?? new();
    }

    // The save running, if any.
    private Task<bool>? savingSession;

    // Saved after each answer; again before leaving the session when that failed. False if it could not be saved.
    // Once at a time: who asks meanwhile (e.g. leaving the page while it is saved after an answer) waits for that save.
    private async Task<bool> SaveSessionAsync()
    {
        savingSession ??= SaveSessionOnceAsync();
        var saving = savingSession;
        var saved = await saving;
        if (savingSession == saving)
            savingSession = null;
        return saved;
    }

    private async Task<bool> SaveSessionOnceAsync()
    {
        if (!pendingSave || session.Turns.Count == 0)
            return true;

        var res = await store.AiAssistant.SaveSessionAsync(session);
        if (!res.IsValid)
            return false;

        session.NoteId = res.Entity.NoteId;
        session.NoteNumber = res.Entity.NoteNumber;
        session.Topic = res.Entity.Topic;
        session.CreationDateTime = res.Entity.CreationDateTime;
        session.ModificationDateTime = res.Entity.ModificationDateTime;
        pendingSave = false;

        await LoadSessionsAsync();
        StateHasChanged();
        return true;
    }

    private async Task NewConversation()
    {
        if (streaming || !await LeaveSessionAsync())
            return;

        StartSession(new AiChatSessionDto());
    }

    private async Task OpenSession(Guid noteId)
    {
        if (streaming || noteId == session.NoteId || !await LeaveSessionAsync())
            return;

        var res = await store.AiAssistant.GetSessionAsync(noteId);
        if (!res.IsValid)
            return;

        StartSession(res.Entity);

        // Resumed with its provider and model, or with the default one when they are no longer configured.
        var provider = AiProviderSelection.ForSession(providers, session.Provider, session.Model);
        if (provider == null)
        {
            provider = providers.FirstOrDefault(p => p.IsDefault) ?? providers.FirstOrDefault();
            if (provider != null)
                notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Info,
                    Summary = "AI Assistant",
                    Detail = $"{session.Provider} {session.Model}, the model of this session, is no longer available: it continues with {provider.Alias}.",
                    Duration = 8000
                });
        }
        SetProvider(provider);
    }

    // A different provider can't continue the conversation: it starts a new one.
    private async Task OnProviderChange(object value)
    {
        var alias = value as string;
        if (alias == currentProvider?.Alias)
            return;

        if (session.Turns.Count > 0)
        {
            var confirm = await dialogService.Confirm("Changing the AI provider starts a new conversation. Do you want to continue?",
                "AI Assistant", new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" });
            if (confirm != true || !await LeaveSessionAsync())
            {
                // Back to the provider in use.
                providerAlias = currentProvider?.Alias;
                return;
            }
            StartSession(new AiChatSessionDto());
        }

        SetProvider(providers.FirstOrDefault(p => p.Alias == alias));
    }

    // Before leaving the session in the chat: saved, if it has something unsaved.
    private async Task<bool> LeaveSessionAsync()
    {
        if (await SaveSessionAsync())
            return true;

        var discard = await dialogService.Confirm("The conversation could not be saved. Do you want to discard its last messages?",
            "AI Assistant", new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" });
        return discard == true;
    }

    private void StartSession(AiChatSessionDto newSession)
    {
        session = newSession;
        pendingSave = false;
        promptInput = "";
        pendingFiles.Clear();
        createdNotes.Clear();
        autoApprovedKinds.Clear();
        webSearch = false;
        scrollToBottom = true;
    }

    private void SetProvider(AiProviderInfoDto? provider)
    {
        currentProvider = provider;
        providerAlias = provider?.Alias;
    }

    #endregion
}
