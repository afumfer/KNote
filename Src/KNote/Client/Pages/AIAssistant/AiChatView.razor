@* The conversation of the AI assistant: each turn as a question and its answer (Markdown) with what it cost,
   the answer being written, and the notes the assistant created (they open in their edit window, KntWindows).
   Presentation only (see AIAssistant). *@

@inject KntWindows kntWindows

<div id="@ContainerId" class="ai-chat">
    @if (Turns.Count == 0 && PendingPrompt == null)
    {
        <div class="ai-empty">
            <RadzenIcon Icon="smart_toy" />
            <RadzenText TextStyle="TextStyle.Body1" class="rz-my-0">
                Ask the assistant anything. It can also search your notes and create tasks for you.
            </RadzenText>
        </div>
    }

    @for (var i = 0; i < Turns.Count; i++)
    {
        var turn = Turns[i];
        @UserMessage(turn.Prompt)
        <div class="ai-row">
            <span class="ai-avatar ai-avatar-assistant"><RadzenIcon Icon="smart_toy" /></span>
            <div class="ai-msg ai-assistant">
                <ViewMarkdown MarkdownContent="@turn.Answer" DisableHtml="true" />
                @if (turn.Truncated)
                {
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-color-warning rz-my-0">@AiChatTurnDto.TruncatedNotice</RadzenText>
                }
                <div class="ai-usage">@turn.UsageSummary()</div>
            </div>
        </div>
        @CreatedNotesOf(i)
    }

    @if (PendingPrompt != null)
    {
        @UserMessage(PendingPrompt)
        <div class="ai-row">
            @* While it answers: a ring turning round the avatar and dots bouncing in the bubble. *@
            <span class="ai-avatar ai-avatar-assistant ai-avatar-thinking"><RadzenIcon Icon="smart_toy" /></span>
            <div class="ai-msg ai-assistant">
                @if (!string.IsNullOrEmpty(PendingAnswer))
                {
                    <ViewMarkdown MarkdownContent="@PendingAnswer" DisableHtml="true" />
                }
                <div class="ai-usage ai-thinking" role="status" aria-label="@(string.IsNullOrEmpty(ToolInUse) ? "Writing" : $"Using {ToolInUse}")">
                    <span class="ai-dots"><span></span><span></span><span></span></span>
                    @if (!string.IsNullOrEmpty(ToolInUse))
                    {
                        <span>Using @ToolInUse</span>
                    }
                </div>
            </div>
        </div>
        @CreatedNotesOf(Turns.Count)
    }
</div>

@code {
    [Parameter] [EditorRequired] public IReadOnlyList<AiChatTurnDto> Turns { get; set; } = null!;

    // The question being answered and what has arrived of its answer (null when there is none).
    [Parameter] public string? PendingPrompt { get; set; }
    [Parameter] public string? PendingAnswer { get; set; }
    [Parameter] public string? ToolInUse { get; set; }

    // The notes created by the assistant (create_task), by the index of the turn they were created in.
    [Parameter] public IReadOnlyDictionary<int, List<AiChatStreamEventDto>>? CreatedNotes { get; set; }

    [Parameter] public string ContainerId { get; set; } = "aichatcontainer";

    private static RenderFragment UserMessage(string prompt) => __builder =>
    {
        <div class="ai-row ai-row-user">
            <div class="ai-msg ai-user">@prompt</div>
            <span class="ai-avatar ai-avatar-user"><RadzenIcon Icon="person" /></span>
        </div>
    };

    private RenderFragment CreatedNotesOf(int turnIndex) => __builder =>
    {
        if (CreatedNotes != null && CreatedNotes.TryGetValue(turnIndex, out var notes))
        {
            foreach (var note in notes)
            {
                <div class="ai-note">
                    @* Markup of a RadzenLink, which has no click of its own. *@
                    <a class="rz-link" href="@($"notes/edit/{note.NoteId}")"
                       @onclick="@(() => kntWindows.OpenEditAsync(note.NoteId!.Value))" @onclick:preventDefault="true">
                        <i class="notranslate rzi">note_add</i><span class="rz-link-text">Note #@note.NoteNumber created: @note.Text</span>
                    </a>
                </div>
            }
        }
    };
}
