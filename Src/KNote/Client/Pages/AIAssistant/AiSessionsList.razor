@* The user's AI assistant sessions, most recent first: choosing one resumes it. The one in the chat also shows
   its tokens. Presentation only (see AIAssistant). *@

<div class="ai-sessions">
    <div class="ai-sessions-header">
        <span class="ai-sessions-icon"><RadzenIcon Icon="forum" /></span>
        <span class="ai-sessions-title">Sessions</span>
        @if (Sessions.Count > 0)
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Primary" Shade="Shade.Lighter" IsPill="true" Text="@Sessions.Count.ToString()" />
        }
    </div>

    @if (Sessions.Count == 0)
    {
        <div class="ai-sessions-empty">
            <RadzenIcon Icon="history" />
            <RadzenText TextStyle="TextStyle.Body2" class="rz-my-0">No sessions yet.</RadzenText>
        </div>
    }
    else
    {
        <RadzenListBox TValue="Guid" Data="@Sessions" ValueProperty="NoteId" Value="@SelectedNoteId"
                       Change="@OnChange" Disabled="@Disabled" class="ai-sessions-list">
            <Template>
                @{ var session = (AiChatSessionInfoDto)context; }
                <div class="ai-session">
                    <RadzenIcon Icon="chat" />
                    <div class="ai-session-text">
                        <div class="ai-session-topic" title="@session.Topic">@session.Topic</div>
                        <div class="ai-session-info">
                            <span>@session.ModificationDateTime.ToString("g")</span>
                            @if (session.NoteId == SelectedNoteId && SelectedTokens > 0)
                            {
                                <span class="ai-session-tokens"><RadzenIcon Icon="toll" />@SelectedTokens.ToString("N0") tokens</span>
                            }
                        </div>
                    </div>
                </div>
            </Template>
        </RadzenListBox>
    }
</div>

@code {
    [Parameter] [EditorRequired] public List<AiChatSessionInfoDto> Sessions { get; set; } = null!;

    // The session in the chat (Guid.Empty for a new one, not saved yet).
    [Parameter] public Guid SelectedNoteId { get; set; }

    // The tokens of the session in the chat (the list doesn't have the others').
    [Parameter] public long SelectedTokens { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public EventCallback<Guid> OnSelect { get; set; }

    private async Task OnChange(object value)
    {
        if (value is Guid noteId && noteId != SelectedNoteId)
            await OnSelect.InvokeAsync(noteId);
    }
}
