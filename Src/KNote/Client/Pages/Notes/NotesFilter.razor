@page "/notes/filter"
@page "/filter"

@using KNote.Client.Auth

@implements IDisposable

@inject IStore store
@inject KntWindows kntWindows
@inject KntAccess access
@inject TooltipService tooltipService
@inject DialogService dialogService
@inject IJSRuntime js

@attribute [Authorize(Roles = "Guest, Staff, ProjectManager, Admin")]


<KntIndexHeader Section="KntSections.NotesFilter">
    <IndexMenu>
        <RadzenMenu>
            <RadzenMenuItem Text="New note" Icon="post_add"  Click="OnNew"></RadzenMenuItem>
            <RadzenMenuItem Text="Edit note ..." Icon="edit" Disabled="@(!(notesGrid?.HasCurrent ?? false))" Click="@(() => notesGrid!.EditCurrentAsync())"></RadzenMenuItem>
            <RadzenMenuItem Text="Delete note ..." Icon="delete" Disabled="@(!(notesGrid?.HasCurrent ?? false) || deleting.IsBusy)" Click="@(() => notesGrid!.DeleteCurrentAsync())"></RadzenMenuItem>
            <NotesViewOptionsMenu Grid="notesGrid" Changed="StateHasChanged" />
            <NotesPrintExportMenu Grid="notesGrid" Request="ReportRequest" ListName="Filtered notes" />
        </RadzenMenu>
    </IndexMenu>
</KntIndexHeader>

@* The panel takes the height left in the window (below the notice of a search by meaning, if any): the criteria and
   the notes list scroll each on its own. *@
<RadzenStack Gap="0.5rem" class="rz-mt-2" Style="height: calc(100vh - 10rem)">
@* The notes not up to date (4.6b: why, and «Update index», the full indexing, for an Admin). *@
@if (meaningPages != null)
{
    <SemanticPendingNotice Pending="@meaningPages.PendingNotes" ForFullRun="@meaningPages.NotesForFullRun" WithoutFiles="@meaningPages.NotesWithoutFiles"
                           ListKey="@filterVersion.ToString()" Indexed="OnUpdateIndex" />
}
<RadzenCard class="rz-p-1" Style="flex: 1; min-height: 0">
    <RadzenSplitter class="@(appState.NotesPreviewVisible == true ? null : "knt-preview-hidden")" Resize="paneSizes.Resized">
        <RadzenSplitterPane Size="@paneSizes[0]" Min="200px" Max="50%" Style="overflow: auto">
            <div class="rz-p-2">
                <NotesFilterCriteria Filter="appState.NotesFilter" @bind-FolderName="folderName" FilterSelected="FilterSelected" MeaningAvailable="meaningAvailable" />
            </div>
        </RadzenSplitterPane>
        <RadzenSplitterPane Size="@paneSizes[1]" Min="320px" class="knt-notes-list-pane">
            @* A new grid for each filter applied: it starts at the top (or where it was left) with its own data. *@
            <NotesGrid @ref="notesGrid" CurrentChanged="StateHasChanged" Compact="@(appState.NotesListCompact ?? true)" @key="filterVersion" LoadPage="LoadNotesPage" Position="appState.NotesFilterPosition"
                       ShowSimilarity="@(meaningPages != null)"
                       OnNoteDelete="OnDelete" OnNoteEdit="OnEdit" OnNoteView="OnView" />
        </RadzenSplitterPane>
        @* Always there, with the sizes of all the panes set from the start (Radzen sizes the panes when they are
           added): hidden with knt-preview-hidden, see knt-theme.css. *@
        <RadzenSplitterPane Size="@paneSizes[2]" Min="240px" class="knt-note-preview-pane">
            @if (appState.NotesPreviewVisible == true)
            {
                <NotePreviewPane NoteId="@notesGrid?.Current?.NoteId" />
            }
        </RadzenSplitterPane>
    </RadzenSplitter>
</RadzenCard>
</RadzenStack>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = null!;

    private NotesGrid? notesGrid;
    private AppState appState = null!;
    private string? folderName;
    private int filterVersion;
    // The search by meaning can be offered (the criteria's «Talks about…», SemanticIndexTexts.CanSearch).
    private bool meaningAvailable;
    // The notes found by meaning of the filter applied, if it has a «Talks about…» (null: the filter of always).
    private KntMeaningSearchPages? meaningPages;
    private readonly CancellationTokenSource disposal = new();
    // The sizes of the panes the user left, kept in the browser.
    private KntPaneSizes paneSizes = null!;

    protected override void OnInitialized()
    {
        paneSizes = new KntPaneSizes(js, "KNoteNotesFilterPanes", "22%", "43%", "35%");

        // Back to the page: the filter applied before (and the list where it was), or all the notes.
        appState = store.AppState;
        appState.NotesFilter ??= new NotesFilterDto();
        appState.NotesFilterPosition ??= new NotesListPosition { ListKey = "filter" };
        folderName = appState.NotesFilterFolderName;
        NewMeaningPages();

        kntWindows.NoteSaved += OnNoteSaved;
    }

    protected override async Task OnInitializedAsync()
    {
        var status = await store.SemanticSearch.GetIndexStatusAsync(disposal.Token);
        if (!disposal.IsCancellationRequested)
            meaningAvailable = status.IsValid && SemanticIndexTexts.CanSearch(status.Entity);
    }

    public void Dispose()
    {
        kntWindows.NoteSaved -= OnNoteSaved;
        DisposeMeaningPages();
        disposal.Cancel();
        disposal.Dispose();
    }

    private void FilterSelected(NotesFilterDto filter)
    {
        appState.NotesFilter = filter;
        appState.NotesFilterFolderName = folderName;
        appState.NotesFilterPosition = new NotesListPosition { ListKey = "filter" };
        NewMeaningPages();
        filterVersion++;
    }

    // The same filter again (4.6b: when the full indexing started from the notice ends).
    private void OnUpdateIndex()
    {
        NewMeaningPages();
        filterVersion++;
    }

    private async Task<Result<List<NoteMinimalDto>>> LoadNotesPage(PageIdentifier page, NotesOrder? order, CancellationToken cancellationToken)
    {
        if (meaningPages != null)
            return await meaningPages.LoadPageAsync(page, order, cancellationToken);

        // A new filter for each request: the grid may ask for several pages at the same time.
        var filter = appState.NotesFilter!.GetSimpleDto<NotesFilterDto>();
        filter.PageIdentifier = page;
        filter.OrderColumn = order?.Column;
        filter.OrderAscending = order?.Ascending ?? true;
        return await store.Notes.GetFilter(filter, cancellationToken);
    }

    // With a «Talks about…», the filter applied by meaning, done when the grid asks for its first page (not paged).
    private void NewMeaningPages()
    {
        DisposeMeaningPages();
        if (appState.NotesFilter?.HasMeaningText != true)
            return;
        var request = SemanticSearchRequestDto.ForFilter(appState.NotesFilter.GetSimpleDto<NotesFilterDto>());
        meaningPages = new KntMeaningSearchPages(ct => store.SemanticSearch.SearchAsync(request, ct));
        meaningPages.Found += OnMeaningFound;
    }

    private void DisposeMeaningPages()
    {
        if (meaningPages == null)
            return;
        meaningPages.Found -= OnMeaningFound;
        meaningPages.Dispose();
        meaningPages = null;
    }

    // The notice of the notes not up to date.
    private void OnMeaningFound() => _ = InvokeAsync(StateHasChanged);

    // The notes of the filter applied (not of criteria changed and not applied yet), to print or export them
    // (NotesPrintExportMenu adds the list's order and view).
    private NotesListReportRequestDto ReportRequest() => new()
    {
        Source = NotesListReportSource.Filter,
        NotesFilter = appState.NotesFilter
    };

    // Creating a note needs Staff (KntAccess, checked with no wait before: it opens a window).
    async Task OnNew()
    {
        if (await access.CheckAsync(AuthenticationState, EnumRoles.Staff, "Creating notes"))
            await kntWindows.OpenNewAsync();
    }

    Task OnView(NoteMinimalDto note) => kntWindows.OpenViewAsync(note.NoteId);

    Task OnEdit(NoteMinimalDto note) => kntWindows.OpenEditAsync(note.NoteId);

    // A note saved in its window: the list shows it changed (or moved, or gone from it).
    void OnNoteSaved(Guid noteId)
    {
        _ = InvokeAsync(() =>
        {
            // By meaning, the search again (the note saved may be found, or not, by its new content).
            if (meaningPages != null)
                NewMeaningPages();
            return notesGrid?.RefreshAsync() ?? Task.CompletedTask;
        });
    }

    // One delete at a time: a click or the Delete key repeated asks and deletes once.
    private readonly KntSingleFlight deleting = new();

    Task OnDelete(NoteMinimalDto item) => deleting.RunAsync(() => DeleteAsync(item));

    async Task DeleteAsync(NoteMinimalDto item)
    {
        var resultDialog = await dialogService.Confirm(
            $"Are you sure you want delete note - {@item.Topic} - ({@item.NoteNumber})?",
            "Delete note",
            new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });

        if (resultDialog == true)
        {
            var result = await store.Notes.DeleteAsync(item.NoteId);
            if (result.IsValid && notesGrid != null)
            {
                await notesGrid.ReloadAsync();
            }
        }
    }

}
