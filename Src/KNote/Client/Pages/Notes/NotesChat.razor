@page "/chat"

@using Microsoft.AspNetCore.SignalR.Client

@inject IStore store
@inject NavigationManager navigationManager

@implements IDisposable

@attribute [Authorize(Roles = "Guest, Staff, ProjectManager, Admin")]

<KntIndexHeader TextHead="Simple chat room">
    <IndexMenu> 
    </IndexMenu>
</KntIndexHeader>

<div class="rz-pt-2 rz-pb-2 rz-mb-2 rz-border-bottom">
    <AuthorizeView>
        <Authorized>
            <RadzenStack Gap="1rem">
                <RadzenCard>
                    <RadzenStack Gap="0.5rem">
                        <RadzenText class="rz-text-align-end rz-my-0">@(userInput = context?.User?.Identity?.Name)</RadzenText>
                        <RadzenLabel Text="Your message" Component="MessageInput" />
                        <RadzenTextBox Name="MessageInput" @bind-Value="messageInput" Immediate="true" Style="width: 100%"
                                       @onkeypress="@((KeyboardEventArgs e) => MessageKeyPress(e))" />
                    </RadzenStack>
                </RadzenCard>

                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center">
                    <RadzenButton Text="Send" Click="() => Send()" ButtonStyle="ButtonStyle.Primary" Disabled="@(!store.ChatIsConnected)" />
                </RadzenStack>
            </RadzenStack>
        </Authorized>
    </AuthorizeView>
</div>

<ul>
    @foreach (var message in messages)
    {
        <li>@message</li>
    }
</ul>

@code
{    
    private List<string> messages = null!;
    private string? userInput;
    private string? messageInput;

    protected override void OnInitialized()
    {        
        store.AppState.OnChange += StateHasChanged;
        messages = store.AppState.ChatMessages;
    }
    
    protected async Task Send()
    {    
        await store.ChatSendMessageAsync("SendMessage", userInput, messageInput);
        messageInput = "";
    }

    private async Task MessageKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Send();
        }
    }

    public void Dispose()
    {
        store.AppState.OnChange -= StateHasChanged;     
    }
}
