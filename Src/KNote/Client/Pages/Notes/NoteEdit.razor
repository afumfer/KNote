@page "/notes/edit/{NoteId:guid}"
@page "/notes/new"
@layout KntWindowLayout

@implements IAsyncDisposable

@inject IStore store
@inject KntWindows kntWindows
@inject DialogService dialogService

@attribute [Authorize(Roles = "Staff, ProjectManager, Admin")]

@* The window where a note is edited (KntWindows.OpenEditAsync) or created (KntWindows.OpenNewAsync, in the
   folder of the query string), apart from the main window: exit closes it, and each note saved is told to the
   other windows (their lists show it changed). Closing it with unsaved changes asks first. *@

<PageTitle>@(string.IsNullOrEmpty(note?.Topic) ? KntConst.AppName : note.Topic)</PageTitle>

@* A link inside the description (e.g. a javascript: link made empty by the editor) could take the window to another
   page of the app: with unsaved changes, it asks first. *@
<NavigationLock OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

@if (showForm)
{
    <NoteForm Title="@(note!.IsNew() ? "New note" : "Edit note")" Note="note" OnValidSubmit="OnSave" OnValidSubmitWithNew="OnSaveAndNew" OnExit="OnExit" NoteTypes="noteTypes"></NoteForm>
}
else if (loadFailed)
{
    <text>The note could not be loaded.</text>
}
else
{
    <text>Loading ... </text>
}

@code {
    // None: a new note.
    [Parameter] public Guid? NoteId { get; set; }

    // The folder of a new note.
    [SupplyParameterFromQuery] public Guid? FolderId { get; set; }

    private NoteDto? note;
    private List<NoteTypeDto>? noteTypes;

    private bool showForm = false;
    private bool loadFailed;
    private bool closing;
    private DotNetObjectReference<NoteEdit>? dotNetRef;
    private IJSObjectReference? unsavedChangesWatch;

    #region Initialize and Dispose

    protected async override Task OnInitializedAsync()
    {
        var result = await store.NoteTypes.GetAllAsync();
        if (result.IsValid)
        {
            noteTypes = result.Entity;
            if (NoteId == null)
                await GetNewNote(await GetFolder(FolderId));
            else
                await GetNote(NoteId.Value);
        }

        loadFailed = !showForm;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            unsavedChangesWatch = await kntWindows.WatchUnsavedChangesAsync(dotNetRef);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (unsavedChangesWatch != null)
        {
            await unsavedChangesWatch.InvokeVoidAsync("dispose");
            await unsavedChangesWatch.DisposeAsync();
        }
        dotNetRef?.Dispose();
    }

    #endregion

    #region Data methods

    private async Task GetNote(Guid noteId)
    {
        var result = await store.Notes.GetAsync(noteId);
        if (result.IsValid)
        {
            note = result.Entity;
            note.SetIsDirty(false);
            showForm = true;
        }
    }

    private async Task<bool> SaveNote()
    {
        if (!note!.IsNew() && !note.IsDirty())
            return true;

        var isNew = note.IsNew();
        var result = await store.Notes.SaveAsync(note);
        if (!result.IsValid)
            return false;

        note = result.Entity;
        note.SetIsNew(false);
        note.SetIsDirty(false);
        if (isNew)
            await kntWindows.BecomeEditWindowAsync(note.NoteId);
        await kntWindows.NotifyNoteSavedAsync(note.NoteId);
        return true;
    }

    private async Task<FolderDto?> GetFolder(Guid? folderId)
    {
        if (folderId == null)
            return null;

        var result = await store.Folders.GetAsync(folderId.Value);
        return result.IsValid ? result.Entity : null;
    }

    // A new note (IsNew: resources and tasks wait until it is saved), in the given folder.
    private async Task GetNewNote(FolderInfoDto? folder)
    {
        var result = await store.Notes.NewAsync();

        if (result.IsValid)
        {
            note = result.Entity;
            if (folder != null && folder.FolderId != Guid.Empty)
            {
                note.FolderDto = folder.GetSimpleDto<FolderDto>();
                note.FolderId = folder.FolderId;
            }
            note.SetIsNew(true);
            note.SetIsDirty(false);
            showForm = true;
        }
    }

    #endregion

    #region Events management

    private async Task OnSave()
    {
        await SaveNote();
    }

    private async Task OnSaveAndNew()
    {
        // In the folder of the note saved.
        if (await SaveNote())
            await GetNewNote(note!.FolderDto);
    }

    private async Task OnExit()
    {
        if (note != null && note.IsDirty())
        {
            var resultDialog = await dialogService.Confirm(
                @"Do you want to close the window and lose your changes?",
                $"{KntConst.AppName}",
                new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });

            if (resultDialog != true)
                return;
        }

        closing = true;
        await kntWindows.CloseAsync();
    }

    private async Task OnBeforeInternalNavigation(LocationChangingContext context)
    {
        if (!HasUnsavedChanges())
            return;

        var resultDialog = await dialogService.Confirm(
            "Do you want to leave the note and lose your changes?",
            $"{KntConst.AppName}",
            new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });

        if (resultDialog != true)
            context.PreventNavigation();
    }

    /// <summary>Asked by the browser before the window is closed or reloaded (KntWindows.WatchUnsavedChangesAsync).</summary>
    [JSInvokable]
    public bool HasUnsavedChanges() => !closing && (note?.IsDirty() ?? false);

    #endregion

}
