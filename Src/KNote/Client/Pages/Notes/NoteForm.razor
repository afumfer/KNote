@inject IStore webApiService
@inject NotificationService notificationService
@inject DialogService dialogService
@inject TooltipService tooltipService
@inject KntWindows kntWindows

<EditForm Model="Note" Context="formContext">

    <DataAnnotationsValidator></DataAnnotationsValidator>

    <div class="knt-note-editor">

    @* The note: what it is and where it is, and the buttons to save it or leave. *@
    <div class="knt-note-header">
        <span class="knt-note-header-icon"><RadzenIcon Icon="@(Note.IsNew() ? "note_add" : "edit_note")" /></span>
        <div class="knt-note-header-caption">
            <div class="knt-note-header-kicker">
                @Title
                @if (!Note.IsNew())
                {
                    <span class="knt-note-header-number">#@Note.NoteNumber</span>
                }
            </div>
            <h1 class="knt-note-header-title">@(string.IsNullOrWhiteSpace(Note.Topic) ? "Untitled note" : Note.Topic)</h1>
            <div class="knt-note-header-meta">
                <span><RadzenIcon Icon="folder" />@(string.IsNullOrEmpty(folderPath) ? "No folder" : folderPath)</span>
                @if (Note.NoteTypeId != null && Note.NoteTypeDto != null)
                {
                    <span><RadzenIcon Icon="@KntSections.NoteTypes.Icon" />@Note.NoteTypeDto.Name</span>
                }
                <span><RadzenIcon Icon="schedule" />@(Note.IsNew() ? "Not saved yet" : $"Modified {Note.ModificationDateTime:g}")</span>
            </div>
        </div>
        <div class="knt-note-header-actions">
            <RadzenButton Text="Save and new" Icon="library_add" Click="() => Save(formContext, true)" ButtonStyle="ButtonStyle.Base" />
            <RadzenButton Text="Save" Icon="save" Click="() => Save(formContext, false)" ButtonStyle="ButtonStyle.Primary" />
            <RadzenButton Icon="close" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Click="() => OnExit.InvokeAsync(null)"
                          MouseEnter="@(args => tooltipService.Open(args, "Close", new TooltipOptions { Position = TooltipPosition.Left }))" />
        </div>
    </div>

    <RadzenTabs Change=@ShowPanel TabPosition="TabPosition.Top" @bind-SelectedIndex="tabsSelectedIndex" class="knt-note-tabs">
        <Tabs>
            <RadzenTabsItem Text="Overview" Icon="article">

                <RadzenRow Gap="1.5rem">
                    <RadzenColumn Size="12" SizeLG="8">
                        <RadzenStack Gap="1rem">
                            <KntField Label="Topic" Component="Topic" Required="true">
                                <RadzenTextBox Name="Topic" @bind-Value="@Note.Topic" Placeholder="What the note is about" class="knt-note-topic" />
                                <ValidationMessage For="@(() => Note.Topic)" />
                            </KntField>
                            <KntField Label="Description">
                                <KntMarkdownEditor @bind-Value="@Note.Description" Locked="@ContentLocked" />
                                <ValidationMessage For="@(() => Note.Description)" />
                            </KntField>
                        </RadzenStack>
                    </RadzenColumn>

                    <RadzenColumn Size="12" SizeLG="4">
                        <div class="knt-note-side">
                            <KntFormSection Icon="info" Title="Details" Description="Where the note is and how it is classified.">
                                <KntField Label="Folder" Required="true">
                                    <KntFolderPicker FolderName="@folderPath" FolderSelected="OnFolderSelected" />
                                    <ValidationMessage For="@(() => Note.FolderId)" />
                                </KntField>
                                <KntField Label="Type" Component="NoteTypeId" Help="The type gives the note its attributes.">
                                    <RadzenDropDown Name="NoteTypeId" TValue="Guid?" Data="@NoteTypes" TextProperty="Name" ValueProperty="NoteTypeId"
                                                    Value="@Note.NoteTypeId"
                                                    ValueChanged="@((Guid? noteTypeId) => OnChangeNoteTypeActions(noteTypeId))"
                                                    ValueExpression="@(() => Note.NoteTypeId)"
                                                    AllowClear="true" Placeholder="No type" />
                                    <ValidationMessage For="@(() => Note.NoteTypeId)" />
                                </KntField>
                                <RadzenRow Gap="1rem">
                                    <RadzenColumn Size="12" SizeSM="4" SizeLG="5">
                                        <KntField Label="Priority" Component="Priority">
                                            <RadzenNumeric Name="Priority" @bind-Value="@Note.Priority" />
                                            <ValidationMessage For="@(() => Note.Priority)" />
                                        </KntField>
                                    </RadzenColumn>
                                    <RadzenColumn Size="12" SizeSM="8" SizeLG="7">
                                        <KntField Label="Tags" Component="Tags">
                                            <RadzenTextBox Name="Tags" @bind-Value="@Note.Tags" />
                                            <ValidationMessage For="@(() => Note.Tags)" />
                                        </KntField>
                                    </RadzenColumn>
                                </RadzenRow>
                            </KntFormSection>

                            <KntFormSection Icon="history" Title="Record" Description="Assigned by the app, and whether the content can be edited.">
                                <dl class="knt-note-facts">
                                    <dt>Number</dt>
                                    <dd>@(Note.IsNew() ? "When it is saved" : $"#{Note.NoteNumber}")</dd>
                                    <dt>Created</dt>
                                    <dd>@(Note.IsNew() ? "-" : Note.CreationDateTime.ToString("g"))</dd>
                                    <dt>Modified</dt>
                                    <dd>@(Note.IsNew() ? "-" : Note.ModificationDateTime.ToString("g"))</dd>
                                    <dt>Status</dt>
                                    <dd>@(string.IsNullOrEmpty(Note.InternalTags) ? "-" : Note.InternalTags)</dd>
                                    <dt>Content</dt>
                                    <dd class="knt-note-lock">
                                        <RadzenSwitch Value="@ContentLocked" ValueChanged="@((bool locked) => SetContentLocked(locked))" />
                                        <span>
                                            <RadzenIcon Icon="@(ContentLocked ? "lock" : "lock_open")" />
                                            @(ContentLocked ? "Locked content" : "Editable content")
                                        </span>
                                    </dd>
                                </dl>
                            </KntFormSection>
                        </div>
                    </RadzenColumn>
                </RadzenRow>

            </RadzenTabsItem>

            <RadzenTabsItem Icon="fact_check">
                <Template Context="tab">
                    <span class="knt-tab-text">Attributes</span><span class="knt-tab-count">@Note.KAttributesDto.Count</span>
                </Template>
                <ChildContent>
                    <NoteKAttributes Attributes="Note.KAttributesDto"></NoteKAttributes>
                </ChildContent>
            </RadzenTabsItem>

            <RadzenTabsItem Icon="attach_file">
                <Template Context="tab">
                    <span class="knt-tab-text">Resources</span>
                    @if (resources != null)
                    {
                        <span class="knt-tab-count">@resources.Count</span>
                    }
                </Template>
                <ChildContent>
                    @if (resources == null && !Note.IsNew())
                    {
                        <p>Loading resources ...</p>
                    }
                    else
                    {
                        <NoteKResources Resources="resources ?? new()"
                                        OnEdit="OnEditResource"
                                        OnDelete="OnDeleteResource"
                                        OnInsertInDesription="InsertInDescription"
                                        OnNew="OnNewResource">
                        </NoteKResources>
                    }
                </ChildContent>
            </RadzenTabsItem>

            <RadzenTabsItem Icon="task_alt">
                <Template Context="tab">
                    <span class="knt-tab-text">Tasks</span>
                    @if (tasks != null)
                    {
                        <span class="knt-tab-count">@tasks.Count</span>
                    }
                </Template>
                <ChildContent>
                    @if (tasks == null && !Note.IsNew())
                    {
                        <p>Loading tasks ...</p>
                    }
                    else
                    {
                        <NoteKTasks Tasks="tasks ?? new()"
                                    OnDelete="OnDeleteTask"
                                    OnNew="OnNewTask"
                                    OnEdit="OnEditTask">
                        </NoteKTasks>
                    }
                </ChildContent>
            </RadzenTabsItem>

            <RadzenTabsItem Icon="@KntSections.TraceNoteTypes.Icon">
                <Template Context="tab">
                    <span class="knt-tab-text">Trace notes</span>
                    @if (traceNotes != null)
                    {
                        <span class="knt-tab-count">@(traceNotes.TraceNotesFrom.Count + traceNotes.TraceNotesTo.Count)</span>
                    }
                </Template>
                <ChildContent>
                    @if (traceNotes == null && !Note.IsNew())
                    {
                        <p>Loading trace notes ...</p>
                    }
                    else
                    {
                        <NoteTraceNotes TraceNotes="traceNotes ?? new()"
                                        OnNew="OnNewTraceNote"
                                        OnEdit="OnEditTraceNote"
                                        OnDelete="OnDeleteTraceNote"
                                        OnOpenNote="OnOpenTraceNote">
                        </NoteTraceNotes>
                    }
                </ChildContent>
            </RadzenTabsItem>

        </Tabs>
    </RadzenTabs>

    </div>

</EditForm>

@code {
    [Parameter] [EditorRequired] public NoteDto Note { get; set; } = null!;
    [Parameter] public List<NoteTypeDto>? NoteTypes { get; set; } 
    [Parameter] public string Title { get; set; } = "...";
    [Parameter] public EventCallback OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnValidSubmitWithNew { get; set; }
    [Parameter] public EventCallback OnExit { get; set; }

    private List<ResourceInfoDto>? resources;
    private List<NoteTaskDto>? tasks;
    private NoteTaskDto? taskEdit;
    private List<UserDto>? users;
    private NoteTraceNotesDto? traceNotes;
    // Read the first time a trace note is added or edited.
    private List<TraceNoteTypeDto>? traceNoteTypes;

    private Guid? oldNoteType = null;

    // The note's content (its description) is locked: shown, not edited (ContentType's DescriptionBlocked, saved with
    // the note).
    private bool ContentLocked => Note.GetContentTypeExt().DescriptionBlocked;

    private void SetContentLocked(bool locked)
    {
        var ct = Note.GetContentTypeExt();
        ct.DescriptionBlocked = locked;
        Note.SetContentTypeExt(ct);
    }

    // The note whose path, resources and tasks are loaded (another one after "Save and new").
    private Guid? loadedNoteId;
    private string folderPath = "";

    private int tabsSelectedIndex { get; set; } = 0;

    #region Initialized

    protected override async Task OnInitializedAsync()
    {
        var result = await webApiService.Users.GetAllAsync();
        if (result.IsValid)
        {
            users = result.Entity;
        }

        await base.OnInitializedAsync();
    }

    // A note shown for the first time, or another one (after "Save and new"): its folder's path, and its resources,
    // tasks and trace notes (the tabs show how many there are).
    protected override async Task OnParametersSetAsync()
    {
        if (Note.NoteId == loadedNoteId)
            return;

        loadedNoteId = Note.NoteId;
        oldNoteType = Note.NoteTypeId;
        resources = null;
        tasks = null;
        traceNotes = null;

        await LoadFolderPathAsync();
        if (!Note.IsNew())
            await Task.WhenAll(LoadResourcesAsync(), LoadTasksAsync(), LoadTraceNotesAsync());
    }

    // The path of the note's folder, as ClientWin shows it (Service: Folders.GetPathAsync).
    private async Task LoadFolderPathAsync()
    {
        folderPath = "";
        if (Note.FolderId == Guid.Empty)
            return;

        var result = await webApiService.Folders.GetPathAsync(Note.FolderId);
        folderPath = result.IsValid ? result.Entity : Note.FolderDto?.Name ?? "";
    }

    private async Task LoadResourcesAsync()
    {
        var result = await webApiService.Notes.GetResourcesAsync(Note.NoteId);
        if (result.IsValid)
            resources = result.Entity;
    }

    private async Task LoadTasksAsync()
    {
        var result = await webApiService.Notes.GetNoteTasksAsync(Note.NoteId);
        if (result.IsValid)
            tasks = result.Entity;
    }

    private async Task LoadTraceNotesAsync()
    {
        var result = await webApiService.Notes.GetTraceNotesAsync(Note.NoteId);
        if (result.IsValid)
            traceNotes = result.Entity;
    }

    #endregion

    #region Data management

    protected async Task Save(EditContext formContext, bool saveAndNew)
    {
        string addMessage = "";

        bool formIsValid = formContext.Validate();

        foreach (var KAttribute in Note.KAttributesDto)
        {
            switch (KAttribute.KAttributeDataType)
            {
                case EnumKAttributeDataType.String:
                    KAttribute.Value = KAttribute.ValueString;
                    break;
                case EnumKAttributeDataType.TextArea:
                    KAttribute.Value = KAttribute.ValueString;
                    break;
                case EnumKAttributeDataType.Int:                    
                    KAttribute.Value = KAttribute.ValueInt.ToString();
                    break;
                case EnumKAttributeDataType.Double:                    
                    KAttribute.Value = KAttribute.ValueDouble.ToString();
                    break;
                case EnumKAttributeDataType.DateTime:                    
                    KAttribute.Value = KAttribute.ValueDateTime.ToString();
                    break;
                case EnumKAttributeDataType.Bool:
                    KAttribute.Value = KAttribute.ValueBool.ToString();
                    break;
                case EnumKAttributeDataType.TabulatedValue:
                    KAttribute.Value = KAttribute.ValueTabulate;
                    break;
                case EnumKAttributeDataType.TagsValue:
                    KAttribute.Value = KAttribute.ValueTags;
                    break;
                default:
                    break;
            }

            if (KAttribute.RequiredValue == true && string.IsNullOrEmpty(KAttribute.Value))
            {
                formIsValid = false;
                addMessage += $" {KAttribute.Name} is required.";
            }
        }

        if (formIsValid == false)
        {            
            var msgErr = "Incorrect data, check the required attributes. " + addMessage;
            notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Save note.", Detail =  msgErr, Duration = 12000 });
            return;
        }

        var xx = Note.KAttributesDto;

        if (saveAndNew)
            await OnValidSubmitWithNew.InvokeAsync(formContext);
        else
            await OnValidSubmit.InvokeAsync(formContext);
    }

    #endregion

    #region Panel management

    private async Task ShowPanel(int panel)
    {        
        if (panel == 2 && resources == null && !Note.IsNew())
            await LoadResourcesAsync();

        if (panel == 3 && tasks == null && !Note.IsNew())
            await LoadTasksAsync();

        // Read again each time: a relation is also changed from the other note's window.
        if (panel == 4 && !Note.IsNew())
            await LoadTraceNotesAsync();

        StateHasChanged();
    }

    #endregion

    #region Management FolderSelector

    private async Task OnFolderSelected(FolderDto f)
    {
        Note.FolderDto = f.GetSimpleDto<FolderDto>();
        Note.FolderId = f.FolderId;
        await LoadFolderPathAsync();
    }

    #endregion

    #region Management ResourceSelector

    private async Task OnNewResource()
    {
        if (Note.IsNew())
        {            
            notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "New resource for this note.", Detail =  "You must save the note before assigning resources to it.", Duration = 12000 });
        }
        else
        {            
            var resultDialog = await dialogService.OpenAsync<NoteResourceEditor>($"New resource and upload resource file",
                   new Dictionary<string, object?>() { { "NoteTopic", Note.Topic } },
                   KntDialogs.Framed(KntDialogs.Medium()));

            if(resultDialog != null)
            {                
                resultDialog.NoteId = Note.NoteId;
                resultDialog.Name = Note.NoteId.ToString() + "_" + resultDialog.Name;

                var resultApi = await webApiService.Notes.SaveResourceAsync(resultDialog);
                if (resultApi.IsValid)
                {
                    // Option 1. TODO: test this not refresh UI, ??
                    //resources?.Add(resultApi.Entity);
                    //StateHasChanged();

                    // Option 2. Alternative implementation
                    resources = null;
                    await ShowPanel(2);
                }
            }
        }
    }

    // Its description and order (not its file).
    private async Task OnEditResource(ResourceInfoDto resource)
    {
        var resultDialog = await dialogService.OpenAsync<NoteResourceEditor>("Edit resource",
               new Dictionary<string, object?>() { { "Resource", resource }, { "NoteTopic", Note.Topic } },
               KntDialogs.Framed(KntDialogs.Medium()));
        if (resultDialog is not ResourceInfoDto edited)
            return;

        // Server keeps the file as it is: no need to send it back.
        edited.ContentBase64 = null;
        var resultApi = await webApiService.Notes.SaveResourceAsync(edited);
        if (resultApi.IsValid)
        {
            resources = null;
            await ShowPanel(2);
        }
    }

    private async Task OnDeleteResource(ResourceInfoDto resource)
    {
        var confirmed = await dialogService.Confirm(
            $"Are you sure you want to delete the resource - {resource.Description} -?", "Delete resource",
            new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });
        if (confirmed != true)
            return;

        var result = await webApiService.Notes.DeleteResourceAsync(resource.ResourceId);
        if (result.IsValid)
        {
            // Option 1. TODO: test this not refresh UI, ??
            //resources.Add(resultApi.Entity);
            //StateHasChanged();

            // Option 2. Alternative implementation
            resources = null;
            await ShowPanel(2);
        }
    }

    private void InsertInDescription(ResourceInfoDto resource)
    {
        if (KntFileTypes.IsImage(resource.FileType, resource.Name))
            Note.Description += "\n\n![alt text](" + resource?.FullUrl + " '" + resource?.Description + "' )";
        else
            Note.Description += "\n\n<a href=" + resource?.FullUrl + " target='_blank'>" + resource?.Description + "</a>";

        tabsSelectedIndex = 0;
        StateHasChanged();        
    }

    #endregion

    #region Tasks management

    private async Task OnNewTask()
    {
        if (Note.IsNew())
        {            
            notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "New task for this note.", Detail =  "You must save the note before assigning tasks to it.", Duration = 12000 });
        }
        else
        {
            taskEdit = null;

            // As ClientWin starts it: for the user signed in, after the other tasks, started now.
            var user = users?.FirstOrDefault(u => u.UserName == webApiService.AppState.UserName);
            var newTask = new NoteTaskDto
            {
                NoteId = Note.NoteId,
                UserId = user?.UserId ?? Guid.Empty,
                UserFullName = user?.FullName,
                Priority = (tasks?.Count ?? 0) + 1,
                StartDate = DateTime.Now
            };

            var result = await dialogService.OpenAsync<NoteTaskEditor>($"New task",
                   new Dictionary<string, object?>() { { "TaskEdit", newTask }, { "Users" , users}, { "NoteTopic", Note.Topic } },
                   KntDialogs.Framed(KntDialogs.Large()));

            if(result != null)
                await SaveEditedTask(result); 
        }
    }

    private async Task OnEditTask(NoteTaskDto task)
    {
        taskEdit = task;        

        var result = await dialogService.OpenAsync<NoteTaskEditor>($"Edit task",
               new Dictionary<string, object?>() { { "TaskEdit", task }, { "Users" , users}, { "NoteTopic", Note.Topic } },
               KntDialogs.Framed(KntDialogs.Large()));

        if(result != null)
        {
            await SaveEditedTask(result); 
        }
    }

    private async Task SaveEditedTask(NoteTaskDto task)
    {
        task.NoteId = Note.NoteId;

        var result = await webApiService.Notes.SaveNoteTaskAsync(task);
        if (result.IsValid)
        {
            tasks = null;
            await ShowPanel(3);
        }
    }

    private async Task OnDeleteTask(NoteTaskDto task)
    {
        var confirmed = await dialogService.Confirm(
            $"Are you sure you want to delete the task - {task.Description} -?", "Delete task",
            new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });
        if (confirmed != true)
            return;

        var result = await webApiService.Notes.DeleteNoteTaskAsync(task.NoteTaskId);
        if (result.IsValid)
        {
            tasks = null;
            await ShowPanel(3);
        }
    }

    #endregion

    #region Trace notes management

    // Saved at once, as the tasks and the resources (not with the note, as ClientWin does).
    private async Task OnNewTraceNote(bool outgoing)
    {
        if (Note.IsNew())
        {
            notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "New trace note for this note.", Detail = "You must save the note before tracing it to other notes.", Duration = 12000 });
            return;
        }

        await OpenTraceNoteEditor(new TraceNoteInfoDto { Weight = 1 }, outgoing);
    }

    private Task OnEditTraceNote(TraceNoteInfoDto traceNote) =>
        OpenTraceNoteEditor(traceNote, outgoing: traceNote.FromId == Note.NoteId);

    private async Task OpenTraceNoteEditor(TraceNoteInfoDto traceNote, bool outgoing)
    {
        if (traceNoteTypes == null)
        {
            var resTypes = await webApiService.TraceNoteTypes.GetAllAsync();
            traceNoteTypes = resTypes.IsValid ? resTypes.Entity.OrderBy(t => t.Name).ToList() : new();
        }

        var result = await dialogService.OpenAsync<NoteTraceNoteEditor>(traceNote.TraceNoteId == Guid.Empty ? "New trace note" : "Edit trace note",
               new Dictionary<string, object?>()
               {
                   { "TraceNote", traceNote }, { "Outgoing", outgoing }, { "NoteId", Note.NoteId },
                   { "NoteDisplay", $"#{Note.NoteNumber} · {Note.Topic}" }, { "TraceNoteTypes", traceNoteTypes },
                   { "Save", (Func<TraceNoteDto, Task<bool>>)SaveTraceNote }
               },
               KntDialogs.Framed(KntDialogs.Medium()));

        if (result != null)
            await ShowPanel(4);
    }

    private async Task<bool> SaveTraceNote(TraceNoteDto traceNote)
    {
        var result = await webApiService.Notes.SaveTraceNoteAsync(traceNote);
        return result.IsValid;
    }

    private async Task OnDeleteTraceNote(TraceNoteInfoDto traceNote)
    {
        var confirmed = await dialogService.Confirm(
            $"Are you sure you want to remove the relation with the note {traceNote.RelatedNoteNumber} - {traceNote.RelatedNoteTopic} -? The note itself is not deleted.",
            "Remove trace note",
            new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });
        if (confirmed != true)
            return;

        var result = await webApiService.Notes.DeleteTraceNoteAsync(traceNote.TraceNoteId);
        if (result.IsValid)
            await ShowPanel(4);
    }

    // The other note of the relation, in its own window (as ClientWin opens it in its note editor). Nothing is awaited
    // before it: the browser only opens a window right after a click or a key.
    private Task OnOpenTraceNote(TraceNoteInfoDto traceNote) => kntWindows.OpenEditAsync(traceNote.RelatedNoteId);

    #endregion

    #region NoteType change control

    private async Task OnChangeNoteTypeActions(Guid? noteType)
    {
        Note.NoteTypeId = noteType;

        if (Note.NoteTypeId == null)
        {
            Note.KAttributesDto.RemoveAll(_ => _.KAttributeNoteTypeId != null);

            oldNoteType = null;
            Note.NoteTypeDto = null;
            return;
        }

        if (Note.NoteTypeId == oldNoteType)
            return;

        var result = await webApiService.KAttributes.GetAllAsync(Note.NoteTypeId);
        if (result.IsValid)
        {
            var listA = result.Entity;

            Note.KAttributesDto.RemoveAll(_ => _.KAttributeNoteTypeId != null);

            foreach (var a in listA)
            {
                var newA = a.GetSimpleDto<NoteKAttributeDto>();
                newA.NoteId = Note.NoteId;
                newA.KAttributeNoteTypeId = Note.NoteTypeId;
                Note.KAttributesDto.Add(newA);
            }

            foreach (var a in Note.KAttributesDto)
            {
                if (a.KAttributeDataType == EnumKAttributeDataType.TabulatedValue)
                    a.TabulatedValues = await NoteKAttributes.GetTabulatedValues(webApiService, a.KAttributeId);
                if (a.KAttributeDataType == EnumKAttributeDataType.TagsValue)
                    a.TagsValues = await NoteKAttributes.GetTagsValues(webApiService, a.KAttributeId, "");
            }

            if (NoteTypes != null)
            {
                Note.NoteTypeDto = NoteTypes.Where(_ => _.NoteTypeId == Note.NoteTypeId).FirstOrDefault();
                oldNoteType = Note.NoteTypeId;                
            }
        }
    }

    #endregion

}

