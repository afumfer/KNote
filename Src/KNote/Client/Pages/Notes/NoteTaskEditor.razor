@inject NotificationService notificationService
@inject DialogService dialogService


<EditForm Model="task" Context="formContextTask">

    <DataAnnotationsValidator></DataAnnotationsValidator>

    <RadzenStack Gap="1rem">

        <KntFormField Label="User:" Component="UserId" LabelSize="2">
            <RadzenDropDown Name="UserId" TValue="Guid" @bind-Value="@task.UserId"
                            Data="@Users" TextProperty="FullName" ValueProperty="UserId" Style="width: 100%" />
            <ValidationMessage For="@(() => task.UserId)" />
        </KntFormField>

        <KntFormField Label="Description:" Component="Description" LabelSize="2">
            <RadzenTextArea Name="Description" @bind-Value="@task.Description" Style="width: 100%" />
            <ValidationMessage For="@(() => task.Description)" />
        </KntFormField>

        <KntFormField Label="Tags:" Component="Tags" LabelSize="2">
            <RadzenTextBox Name="Tags" @bind-Value="@task.Tags" Style="width: 100%" />
            <ValidationMessage For="@(() => task.Tags)" />
        </KntFormField>

        @* Two fields per row: a column per field, each with its KntFormField (LabelSize relative to the column). *@
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <KntFormField Label="Priority:" Component="Priority" LabelSize="4">
                    <RadzenNumeric Name="Priority" @bind-Value="@task.Priority" Style="width: 100%" />
                    <ValidationMessage For="@(() => task.Priority)" />
                </KntFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <KntFormField Label="Difficulty:" Component="DifficultyLevel" LabelSize="4">
                    <RadzenNumeric Name="DifficultyLevel" TValue="double?" @bind-Value="@task.DifficultyLevel" Style="width: 100%" />
                    <ValidationMessage For="@(() => task.DifficultyLevel)" />
                </KntFormField>
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <KntFormField Label="Exp. start:" LabelSize="4">
                    <RadzenDatePicker TValue="DateTime?" @bind-Value="@task.ExpectedStartDate" ShowTime="true" DateFormat="dd/MM/yyyy HH:mm" Style="width: 100%" />
                    <ValidationMessage For="@(() => task.ExpectedStartDate)" />
                </KntFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <KntFormField Label="Exp. end:" LabelSize="4">
                    <RadzenDatePicker TValue="DateTime?" @bind-Value="@task.ExpectedEndDate" ShowTime="true" DateFormat="dd/MM/yyyy HH:mm" Style="width: 100%" />
                    <ValidationMessage For="@(() => task.ExpectedEndDate)" />
                </KntFormField>
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <KntFormField Label="Start:" LabelSize="4">
                    <RadzenDatePicker TValue="DateTime?" @bind-Value="@task.StartDate" ShowTime="true" ShowSeconds="true" HoursStep="1.5" DateFormat="dd/MM/yyyy HH:mm" Style="width: 100%" />
                    <ValidationMessage For="@(() => task.StartDate)" />
                </KntFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <KntFormField Label="Resolv:" LabelSize="4">
                    <RadzenDatePicker TValue="DateTime?" @bind-Value="@task.EndDate" ShowTime="true" DateFormat="dd/MM/yyyy HH:mm" Style="width: 100%" />
                    <ValidationMessage For="@(() => task.EndDate)" />
                </KntFormField>
            </RadzenColumn>
        </RadzenRow>

        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMD="6">
                <KntFormField Label="Resolved:" Component="Resolved" LabelSize="4">
                    <RadzenCheckBox Name="Resolved" TValue="bool" @bind-Value="@task.Resolved" />
                </KntFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMD="6">
                <KntFormField Label="Spent time:" Component="SpentTime" LabelSize="4">
                    <RadzenNumeric Name="SpentTime" TValue="double?" @bind-Value="@task.SpentTime" Style="width: 100%" />
                    <ValidationMessage For="@(() => task.SpentTime)" />
                </KntFormField>
            </RadzenColumn>
        </RadzenRow>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton Text="Ok" Click="() => OnConfirm(formContextTask)" ButtonStyle="ButtonStyle.Primary" />
            <RadzenButton Text="Cancel" Click="() => OnCancel()" ButtonStyle="ButtonStyle.Secondary" />
        </RadzenStack>

    </RadzenStack>

</EditForm>

@code {
    [Parameter] public List<UserDto> Users { get; set; }    
    [Parameter] public  NoteTaskDto TaskEdit { get; set; }

    private NoteTaskDto task;

    protected override Task OnInitializedAsync()
    {
        if (TaskEdit != null)
            task = TaskEdit.GetSimpleDto<NoteTaskDto>();
        else
        {
            task = new NoteTaskDto();            
        }        
        return base.OnInitializedAsync();
    }

    private void OnConfirm(EditContext formContext)
    {
        bool formIsValid = formContext.Validate();
        if (formIsValid == false)
        {            
            notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Validating task.", Detail =  "Incorrect data, check the required attributes.", Duration = 12000 });
            return;
        }

        task.UserFullName = Users.Where(u => u.UserId == task.UserId).Select(u => u.FullName).SingleOrDefault();

        dialogService.Close(task);
    }

    private void OnCancel()
    {        
        dialogService.Close(null);
    }
}
