@inject NotificationService notificationService
@inject DialogService dialogService

@implements IDisposable

@* Dialog of a note's task (NoteForm opens it framed): who it is for and what (its topic, and its description in
   Markdown), its planning and its progress. The result is the task edited, or null if cancelled. *@

<EditForm Model="task" Context="formContextTask">

    <DataAnnotationsValidator></DataAnnotationsValidator>

    <KntDialogFrame Icon="@(IsNew ? "add_task" : "task_alt")" Title="@(IsNew ? "New task" : "Edit task")"
                    Subtitle="@(string.IsNullOrEmpty(NoteTopic) ? "A task of the note." : NoteTopic)">
        <ChildContent>

            <KntFormSection Icon="person" Title="Assignment" Description="Who the task is for, and what it is.">
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeSM="7">
                        <KntField Label="Topic / Tags" Component="Tags" Help="A short title, or the words to find the task by.">
                            <RadzenTextBox Name="Tags" @bind-Value="@task.Tags" />
                            <ValidationMessage For="@(() => task.Tags)" />
                        </KntField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeSM="5">
                        <KntField Label="User" Component="UserId" Required="true">
                            <RadzenDropDown Name="UserId" TValue="Guid" @bind-Value="@task.UserId"
                                            Data="@Users" TextProperty="FullName" ValueProperty="UserId" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" Placeholder="Choose a user" />
                            <ValidationMessage For="@(() => task.UserId)" />
                        </KntField>
                    </RadzenColumn>
                </RadzenRow>
                <KntField Label="Description" Component="Description">
                    <KntMarkdownEditor @ref="descriptionEditor" @bind-Value="@task.Description" Height="18rem" StorageKey="KNoteTaskEditorMode"
                                       Name="Description" />
                    <ValidationMessage For="@(() => task.Description)" />
                </KntField>
            </KntFormSection>

            <KntFormSection Icon="event" Title="Planning" Description="How important and hard it is, and when it is expected.">
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeSM="4">
                        <KntField Label="Priority" Component="Priority">
                            <RadzenNumeric Name="Priority" @bind-Value="@task.Priority" />
                            <ValidationMessage For="@(() => task.Priority)" />
                        </KntField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeSM="4">
                        <KntField Label="Difficulty" Component="DifficultyLevel">
                            <RadzenNumeric Name="DifficultyLevel" TValue="double?" @bind-Value="@task.DifficultyLevel" />
                            <ValidationMessage For="@(() => task.DifficultyLevel)" />
                        </KntField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeSM="4">
                        <KntField Label="Estimated time (h)" Component="EstimatedTime">
                            <RadzenNumeric Name="EstimatedTime" TValue="double?" @bind-Value="@task.EstimatedTime" />
                            <ValidationMessage For="@(() => task.EstimatedTime)" />
                        </KntField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeSM="6">
                        <KntField Label="Expected start">
                            <RadzenDatePicker TValue="DateTime?" @bind-Value="@task.ExpectedStartDate" ShowTime="true" DateFormat="dd/MM/yyyy HH:mm" />
                            <ValidationMessage For="@(() => task.ExpectedStartDate)" />
                        </KntField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeSM="6">
                        <KntField Label="Expected end">
                            <RadzenDatePicker TValue="DateTime?" @bind-Value="@task.ExpectedEndDate" ShowTime="true" DateFormat="dd/MM/yyyy HH:mm" />
                            <ValidationMessage For="@(() => task.ExpectedEndDate)" />
                        </KntField>
                    </RadzenColumn>
                </RadzenRow>
            </KntFormSection>

            <KntFormSection Icon="trending_up" Title="Progress" Description="When the work started and ended, and the time spent.">
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeSM="6">
                        <KntField Label="Start">
                            <RadzenDatePicker TValue="DateTime?" @bind-Value="@task.StartDate" ShowTime="true" DateFormat="dd/MM/yyyy HH:mm" />
                            <ValidationMessage For="@(() => task.StartDate)" />
                        </KntField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeSM="6">
                        <KntField Label="End">
                            <RadzenDatePicker TValue="DateTime?" @bind-Value="@task.EndDate" ShowTime="true" DateFormat="dd/MM/yyyy HH:mm" />
                            <ValidationMessage For="@(() => task.EndDate)" />
                        </KntField>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeSM="6">
                        <KntField Label="Spent time (h)" Component="SpentTime">
                            <RadzenNumeric Name="SpentTime" TValue="double?" @bind-Value="@task.SpentTime" />
                            <ValidationMessage For="@(() => task.SpentTime)" />
                        </KntField>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeSM="6">
                        <KntField Label="Resolved" Component="Resolved" Help="The task is done (its end is now, if it has none).">
                            <RadzenSwitch Name="Resolved" Value="@task.Resolved" ValueChanged="@((bool resolved) => SetResolved(resolved))" />
                        </KntField>
                    </RadzenColumn>
                </RadzenRow>
            </KntFormSection>

        </ChildContent>
        <Footer>
            <RadzenButton Text="Cancel" Click="() => OnCancel()" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" />
            <RadzenButton Text="Ok" Icon="check" Click="() => OnConfirmAsync(formContextTask)" ButtonStyle="ButtonStyle.Primary" />
        </Footer>
    </KntDialogFrame>

</EditForm>

@code {
    [Parameter] public List<UserDto> Users { get; set; }
    // The task to edit (a new one, with its default values, has no id); none for an empty new one.
    [Parameter] public  NoteTaskDto TaskEdit { get; set; }
    // The note the task belongs to (the dialog's subtitle).
    [Parameter] public string? NoteTopic { get; set; }

    private NoteTaskDto task;
    private KntMarkdownEditor? descriptionEditor;
    private bool closed;

    private bool IsNew => TaskEdit == null || TaskEdit.NoteTaskId == Guid.Empty;

    protected override Task OnInitializedAsync()
    {
        if (TaskEdit != null)
            task = TaskEdit.GetSimpleDto<NoteTaskDto>();
        else
        {
            task = new NoteTaskDto();
        }
        return base.OnInitializedAsync();
    }

    private async Task OnConfirmAsync(EditContext formContext)
    {
        // The description as typed until now (the editor gives it back after a pause in the typing).
        if (descriptionEditor != null)
            await descriptionEditor.FlushAsync();
        // Closed meanwhile (Esc): Close would close another dialog.
        if (closed)
            return;

        bool formIsValid = formContext.Validate();
        if (formIsValid == false)
        {
            notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Validating task.", Detail =  "Incorrect data, check the required attributes.", Duration = 12000 });
            return;
        }

        task.UserFullName = Users.Where(u => u.UserId == task.UserId).Select(u => u.FullName).SingleOrDefault();

        closed = true;
        dialogService.Close(task);
    }

    // As in ClientWin: a task resolved ends now, unless its end is already set.
    private void SetResolved(bool resolved)
    {
        task.Resolved = resolved;
        if (resolved && task.EndDate == null)
            task.EndDate = DateTime.Now;
    }

    private void OnCancel()
    {
        closed = true;
        dialogService.Close(null);
    }

    public void Dispose() => closed = true;
}
