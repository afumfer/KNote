@page "/notes/view/{NoteId:guid}"
@page "/notes/number/{NoteNumber:int}"
@layout KntWindowLayout

@implements IDisposable

@inject IStore store
@inject KntWindows kntWindows
@inject TooltipService tooltipService

@attribute [Authorize(Roles = "Guest, Staff, ProjectManager, Admin")]

@* The window where a note is read (KntWindows.OpenViewAsync), apart from the main window, also by its number (a citation,
   #123, opened with a click: see KntWindows). It shows the note again when it is saved in another window. *@

<PageTitle>@(note?.Topic ?? KntConst.AppName)</PageTitle>

<ToolingHeader Title="Note view" Icon="article">
    <Buttons>
        <RadzenButton Icon="close" Click="kntWindows.CloseAsync" ButtonStyle="ButtonStyle.Secondary"
                      MouseEnter="@(args => tooltipService.Open(args, "Close", new TooltipOptions { Position = TooltipPosition.Left }))" />
    </Buttons>
</ToolingHeader>

@if (note != null)
{
    <NoteViewer Note="note" />
}
else if (notFound)
{
    <text>@(NoteNumber != null ? $"Note #{NoteNumber} not found." : "The note could not be loaded.")</text>
}
else
{
    <text>Loading ... </text>
}


@code {
    [Parameter] public Guid NoteId { get; set; }
    [Parameter] public int? NoteNumber { get; set; }

    private NoteDto? note;
    private bool notFound;

    protected override async Task OnInitializedAsync()
    {
        kntWindows.NoteSaved += OnNoteSaved;
        await LoadNote();
    }

    // The note read last: read again (saved in another window) or the window closed cancels the one being read.
    private readonly KntLatestRequest noteRequest = new();

    public void Dispose()
    {
        kntWindows.NoteSaved -= OnNoteSaved;
        noteRequest.Dispose();
    }

    private async Task LoadNote()
    {
        if (NoteId == Guid.Empty && NoteNumber is int noteNumber)
        {
            var cited = await noteRequest.RunAsync(ct => store.Notes.GetCitedAsync(noteNumber, ct));
            if (cited.Canceled)
                return;
            if (cited.Value.Entity == null)
            {
                notFound = true;
                return;
            }
            NoteId = cited.Value.Entity.NoteId;
        }

        var request = await noteRequest.RunAsync(ct => store.Notes.GetAsync(NoteId, ct));
        if (request.Canceled)
            return;

        var result = request.Value;
        if (result.IsValid)
            note = result.Entity;
        else
            notFound = note == null;
    }

    private void OnNoteSaved(Guid noteId)
    {
        if (noteId == NoteId)
            _ = InvokeAsync(async () => { await LoadNote(); StateHasChanged(); });
    }
}
