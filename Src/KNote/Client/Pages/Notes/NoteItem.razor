<RadzenCard class="rz-m-1 rz-p-1">

    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween"
                 Wrap="FlexWrap.Wrap" class="rz-m-1 rz-p-2 knt-background-subtle rz-border-radius-1">
        <RadzenStack Gap="0.25rem">
            <strong>@((MarkupString)Note.Topic) (#@Note.NoteNumber)</strong>
            <small class="rz-ml-4"><i>Creation: @(Note.CreationDateTime.ToShortDateString()) - Tags: @(Note.Tags)</i></small>
        </RadzenStack>
        <KntActionsMenu Actions="@actions" />
    </RadzenStack>

    <div class="rz-p-2">
        <ViewMarkdown MarkdownContent="@Note.Description" />
    </div>

</RadzenCard>



@code {
    [Parameter] public NoteInfoDto Note { get; set; } = new NoteInfoDto();
    [Parameter] public EventCallback<NoteInfoDto> OnNoteDelete { get; set; }
    [Parameter] public EventCallback<NoteInfoDto> OnNoteEdit { get; set; }
    [Parameter] public EventCallback<NoteInfoDto> OnNoteView { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = null!;

    private List<KntAction> actions = [];

    protected override async Task OnParametersSetAsync()
    {
        var user = (await AuthenticationState).User;
        var canEdit = user.IsInRole("Admin") || user.IsInRole("ProjectManager") || user.IsInRole("Staff");

        actions = [new("View", "launch", () => OnNoteView.InvokeAsync(Note))];
        if (canEdit)
        {
            actions.Add(new("Edit", "edit", () => OnNoteEdit.InvokeAsync(Note)));
            actions.Add(new("Delete", "delete", () => OnNoteDelete.InvokeAsync(Note), Danger: true));
        }
    }
}
