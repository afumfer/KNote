@using KNote.Client.Auth

@inject KntAccess access

<RadzenCard class="rz-m-1 rz-p-1">

    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween"
                 Wrap="FlexWrap.Wrap" class="rz-m-1 rz-p-2 knt-background-subtle rz-border-radius-1">
        <RadzenStack Gap="0.25rem">
            <span class="knt-note-card-title">@Note.Topic (#@Note.NoteNumber)</span>
            <span class="knt-note-card-info">Last modification: @(Note.ModificationDateTime.ToShortDateString()) - Tags: @(Note.Tags)</span>
        </RadzenStack>
        <KntActionsMenu Actions="@actions" />
    </RadzenStack>

    <div class="rz-p-2">
        @* HomeNotes gives the descriptions as HTML already made safe (Home is shown without signing in). *@
        <ViewMarkdown SafeHtml="@Note.Description" />
    </div>

</RadzenCard>



@code {
    [Parameter] public NoteInfoDto Note { get; set; } = new NoteInfoDto();
    [Parameter] public EventCallback<NoteInfoDto> OnNoteDelete { get; set; }
    [Parameter] public EventCallback<NoteInfoDto> OnNoteEdit { get; set; }
    [Parameter] public EventCallback<NoteInfoDto> OnNoteView { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = null!;

    // Always offered: editing and deleting check the role when chosen (KntAccess), with no wait before (editing opens
    // a window).
    private List<KntAction> actions = [];

    protected override void OnParametersSet()
    {
        actions =
        [
            new("View", "launch", () => OnNoteView.InvokeAsync(Note)),
            new("Edit", "edit", async () =>
            {
                if (await access.CheckAsync(AuthenticationState, EnumRoles.Staff, "Editing notes"))
                    await OnNoteEdit.InvokeAsync(Note);
            }),
            new("Delete", "delete", async () =>
            {
                if (await access.CheckAsync(AuthenticationState, EnumRoles.Staff, "Deleting notes"))
                    await OnNoteDelete.InvokeAsync(Note);
            }, Danger: true)
        ];
    }
}
