@inject TooltipService tooltipService
@inject DialogService dialogService

@* The note's resources as a gallery: a card for each, with its image (any image type) or an icon of its kind of
   file, its description and name, and its actions (view, edit, open, insert in the description, delete). *@

<div class="knt-list-header">
    <span>@Resources.Count @(Resources.Count == 1 ? "resource" : "resources")</span>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        @if (Describing != null)
        {
            <span class="knt-resource-describing">@Describing</span>
            <RadzenButton Text="Cancel" Click="() => OnCancelDescribing.InvokeAsync(null)" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small" />
        }
        else if (Resources.Any(AiPhotoRules.CanDescribe))
        {
            <RadzenButton Text="Describe photos" Icon="auto_awesome" Click="() => OnDescribePhotos.InvokeAsync(null)" ButtonStyle="ButtonStyle.Base"
                          Variant="Variant.Text" Size="ButtonSize.Small" Disabled="@Busy"
                          MouseEnter="@(args => tooltipService.Open(args, "Describe the photos with the AI (those not locked)"))" />
        }
        <RadzenButton Text="Add resource" Icon="upload_file" Click="() => OnNew.InvokeAsync(null)" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Disabled="@Busy" />
    </RadzenStack>
</div>

@if (Resources.Count == 0)
{
    <div class="knt-empty-state">
        <RadzenIcon Icon="attach_file" />
        <div class="knt-empty-state-title">No resources yet</div>
        <div class="knt-empty-state-text">Add images, documents or any file to the note (a new note has to be saved first).</div>
    </div>
}
else
{
    <div class="knt-resources">
        @foreach (var resource in Resources.OrderBy(r => r.Order))
        {
            var image = ImageSource(resource);
            <div class="knt-resource">
                <div class="knt-resource-thumb @(image == null ? "knt-resource-thumb-icon" : null)"
                     @onclick="() => ViewAsync(resource)" title="@(CanView(resource) ? "View" : "Open")">
                    @if (image != null)
                    {
                        <img src="@image" alt="@resource.GetTitle()" loading="lazy" />
                    }
                    else
                    {
                        <RadzenIcon Icon="@KntFileTypes.Icon(resource.FileType, resource.Name)" />
                        <span class="knt-resource-ext">@Extension(resource)</span>
                    }
                </div>
                <div class="knt-resource-body">
                    <div class="knt-resource-title" title="@resource.Description">@resource.GetTitle()</div>
                    <div class="knt-resource-meta">
                        <span class="knt-resource-order">@resource.Order</span>
                        <span class="knt-resource-name">@resource.NameOut</span>
                        @if (resource.DescriptionByUser)
                        {
                            <RadzenIcon Icon="lock" class="knt-resource-locked" title="Description locked: the AI won't change it" />
                        }
                    </div>
                </div>
                <div class="knt-resource-actions">
                    @if (AiPhotoRules.CanDescribe(resource))
                    {
                        <RadzenButton Icon="auto_awesome" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                                      Click="@(() => OnDescribe.InvokeAsync(resource))" Disabled="@Busy" MouseEnter="@(args => tooltipService.Open(args, "Describe photo with the AI"))" />
                    }
                    <RadzenButton Icon="edit" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                                  Click="@(() => OnEdit.InvokeAsync(resource))" Disabled="@Busy" MouseEnter="@(args => tooltipService.Open(args, "Edit resource"))" />
                    <RadzenButton Icon="open_in_new" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                                  Click="@(() => OpenAsync(resource))" MouseEnter="@(args => tooltipService.Open(args, "Open in a new tab"))" />
                    <RadzenButton Icon="add_link" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                                  Click="@(() => OnInsertInDesription.InvokeAsync(resource))" MouseEnter="@(args => tooltipService.Open(args, "Insert in the description"))" />
                    <RadzenButton Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                  Click="@(() => OnDelete.InvokeAsync(resource))" Disabled="@Busy" MouseEnter="@(args => tooltipService.Open(args, "Delete resource"))" />
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public List<ResourceInfoDto> Resources { get; set; } = new();
    [Parameter] public EventCallback<ResourceInfoDto> OnEdit { get; set; }
    [Parameter] public EventCallback<ResourceInfoDto> OnDelete { get; set; }
    [Parameter] public EventCallback<ResourceInfoDto> OnInsertInDesription { get; set; }
    [Parameter] public EventCallback OnNew { get; set; }
    // A change being saved (NoteForm): adding, editing and deleting wait for it.
    [Parameter] public bool Busy { get; set; }
    // KNote Atlas, stage 4: describing the photos with the AI (Describing: its progress while it runs).
    [Parameter] public EventCallback OnDescribePhotos { get; set; }
    [Parameter] public EventCallback<ResourceInfoDto> OnDescribe { get; set; }
    [Parameter] public EventCallback OnCancelDescribing { get; set; }
    [Parameter] public string? Describing { get; set; }

    [Inject] private IJSRuntime js { get; set; } = null!;

    // The image of a resource that is one (by its type or its name): its content if it came with the resource (and
    // its type says which image it is), otherwise its URL.
    public static string? ImageSource(ResourceInfoDto resource)
    {
        if (!KntFileTypes.IsImage(resource.FileType, resource.Name))
            return null;
        return string.IsNullOrEmpty(resource.ContentBase64) || !KntFileTypes.IsImage(resource.FileType)
            ? resource.FullUrl
            : $"data:{resource.FileType};base64,{resource.ContentBase64}";
    }

    private static string Extension(ResourceInfoDto resource)
    {
        var name = resource.NameOut ?? resource.Name ?? "";
        var dot = name.LastIndexOf('.');
        return dot >= 0 && dot < name.Length - 1 ? name[(dot + 1)..].ToUpperInvariant() : "";
    }

    // Every resource is shown in this window (NoteResourceViewer), over the note: what the browser can show (an image, a PDF,
    // a video, an audio or a text), the text of a document (KNote Atlas 4.4b) and, for any other file (a .doc, a .zip...), its
    // description with «Open in a new tab». Only one without a URL nor an image is opened directly.
    private static bool CanView(ResourceInfoDto resource) =>
        ImageSource(resource) != null
        || DocumentTextRules.IsDocument(resource)
        || !string.IsNullOrEmpty(resource.FullUrl);

    private async Task ViewAsync(ResourceInfoDto resource)
    {
        if (!CanView(resource))
        {
            await OpenAsync(resource);
            return;
        }

        await dialogService.OpenAsync<NoteResourceViewer>("View resource",
            new Dictionary<string, object?> { { "Resource", resource } }, NoteResourceViewer.Options());
    }

    private async Task OpenAsync(ResourceInfoDto resource) =>
        await js.InvokeVoidAsync("open", resource.FullUrl, "_blank", "noopener");
}
