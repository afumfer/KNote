@implements IDisposable

@inject IStore store
@inject DialogService dialogService
@inject TooltipService tooltipService

@* A note to read: topic, description, tags and dates. Used by the note's window (NoteView) and the preview
   beside the notes lists (NotePreviewPane). With a semantic index, «Similar notes» shows the notes most similar to it
   when pressed (KNote Atlas: not before, so changing of note is not slower). *@

<RadzenCard>
    <RadzenStack Gap="0.5rem">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem"
                     class="rz-pb-2 rz-border-bottom">
            <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H4" class="rz-m-0">@Note.Topic</RadzenText>
            @if (canSearchByMeaning)
            {
                <RadzenButton Text="Similar notes" Icon="@NoteSimilarNotes.Icon" Variant="Variant.Text" Size="ButtonSize.Small" Click="OnSimilarNotes"
                              MouseEnter="@(args => tooltipService.Open(args, "The notes that talk about the same"))" />
            }
        </RadzenStack>
        <div class="rz-p-2 rz-border-bottom">
            @* The preview gives the HTML read with the note; otherwise ViewMarkdown asks Server for it. *@
            <ViewMarkdown MarkdownContent="@(DescriptionHtml == null ? Note.Description : null)" SafeHtml="@DescriptionHtml" />
        </div>
        <i>
            <p>Tags: @(Note.Tags)</p>
            <p>Creation date: @(Note.CreationDateTime)</p>
            <p>Modification date: @(Note.ModificationDateTime)</p>
        </i>
    </RadzenStack>
</RadzenCard>

@code {
    [Parameter][EditorRequired] public NoteDto Note { get; set; } = null!;
    // The description's HTML, already made safe by Server (NotePreviewPane reads it with the note); null: ViewMarkdown
    // gets it.
    [Parameter] public string? DescriptionHtml { get; set; }

    private bool canSearchByMeaning;
    private readonly CancellationTokenSource disposal = new();

    protected override async Task OnInitializedAsync()
    {
        var status = await store.SemanticSearch.GetIndexStatusAsync(disposal.Token);
        if (!disposal.IsCancellationRequested)
            canSearchByMeaning = status.IsValid && SemanticIndexTexts.CanSearch(status.Entity);
    }

    private Task OnSimilarNotes() =>
        dialogService.OpenAsync<NoteSimilarNotesDialog>("Similar notes",
            new Dictionary<string, object?> { { "NoteId", Note.NoteId }, { "Subtitle", $"#{Note.NoteNumber} · {Note.Topic}" } },
            KntDialogs.Framed(KntDialogs.Medium()));

    public void Dispose()
    {
        disposal.Cancel();
        disposal.Dispose();
    }
}
