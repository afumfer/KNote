@inject IStore store


@* The note's attributes (those of its type and the general ones): a field for each, with its label above, a mark
   if it is required and its description as help. *@

@if (Attributes.Count == 0)
{
    <div class="knt-empty-state">
        <RadzenIcon Icon="fact_check" />
        <div class="knt-empty-state-title">This note has no attributes</div>
        <div class="knt-empty-state-text">Choose a type in Overview: the note gets the attributes of its type.</div>
    </div>
}
else
{
    <KntFormSection Icon="fact_check" Title="Attributes" Description="The fields of the note's type, and the ones of all the notes.">
        <RadzenRow Gap="1rem">
            @foreach (var KAttribute in Attributes)
            {
                var wide = KAttribute.KAttributeDataType is EnumKAttributeDataType.TextArea or EnumKAttributeDataType.TagsValue;
                <RadzenColumn Size="12" SizeMD="@(wide ? 12 : 6)">
                    <KntField Label="@KAttribute.Name" Required="@KAttribute.RequiredValue" Help="@KAttribute.Description">
                        @if (KAttribute.KAttributeDataType == EnumKAttributeDataType.String)
                        {
                            <RadzenTextBox @bind-Value="@KAttribute.ValueString" />
                        }
                        else if (KAttribute.KAttributeDataType == EnumKAttributeDataType.TextArea)
                        {
                            <RadzenTextArea @bind-Value="@KAttribute.ValueString" Rows="3" />
                        }
                        else if (KAttribute.KAttributeDataType == EnumKAttributeDataType.DateTime)
                        {
                            <RadzenDatePicker TValue="DateTime?" @bind-Value="@KAttribute.ValueDateTime" DateFormat="dd/MM/yyyy" />
                        }
                        else if (KAttribute.KAttributeDataType == EnumKAttributeDataType.Int)
                        {
                            <RadzenNumeric TValue="int?" @bind-Value="@KAttribute.ValueInt" />
                        }
                        else if (KAttribute.KAttributeDataType == EnumKAttributeDataType.Double)
                        {
                            <RadzenNumeric TValue="double?" @bind-Value="@KAttribute.ValueDouble" />
                        }
                        else if (KAttribute.KAttributeDataType == EnumKAttributeDataType.Bool)
                        {
                            <RadzenSwitch @bind-Value="@KAttribute.ValueBool" />
                        }
                        else if (KAttribute.KAttributeDataType == EnumKAttributeDataType.TagsValue)
                        {
                            <RadzenDropDown TValue="IEnumerable<string>" Multiple="true" Chips="true" AllowClear="true" AllowSelectAll="false"
                                            Data="@KAttribute.TagsValues" TextProperty="Value" ValueProperty="Key"
                                            Value="@SelectedTags(KAttribute)"
                                            ValueChanged="@((IEnumerable<string> tags) => onAttributeChange(KAttribute, string.Join(", ", tags ?? [])))"
                                            Placeholder="Choose tags" />
                        }
                        else if (KAttribute.KAttributeDataType == EnumKAttributeDataType.TabulatedValue)
                        {
                            <RadzenDropDown TValue="string" @bind-Value="@KAttribute.ValueTabulate"
                                            Data="@KAttribute.TabulatedValues" TextProperty="Value" ValueProperty="Value"
                                            AllowClear="true" Placeholder="Choose a value" />
                        }
                    </KntField>
                </RadzenColumn>
            }
        </RadzenRow>
    </KntFormSection>
}

@code {
    [Parameter] public List<NoteKAttributeDto> Attributes { get; set; }

    protected override async Task OnInitializedAsync()
    {
        foreach (var KAttribute in Attributes)
        {
            switch (KAttribute.KAttributeDataType)
            {
                case EnumKAttributeDataType.String:
                    KAttribute.ValueString = KAttribute.Value;
                    break;
                case EnumKAttributeDataType.TextArea:
                    KAttribute.ValueString = KAttribute.Value;
                    break;
                case EnumKAttributeDataType.Int:
                    int val;
                    if (int.TryParse(KAttribute.Value, out val))
                        KAttribute.ValueInt = val;
                    break;
                case EnumKAttributeDataType.Double:
                    double valD;
                    if (double.TryParse(KAttribute.Value, out valD))
                        KAttribute.ValueDouble = valD;
                    break;
                case EnumKAttributeDataType.DateTime:
                    DateTime valDT;
                    if (DateTime.TryParse(KAttribute.Value, out valDT))
                        KAttribute.ValueDateTime = valDT;
                    break;
                case EnumKAttributeDataType.Bool:
                    bool valB;
                    if (bool.TryParse(KAttribute.Value, out valB))
                        KAttribute.ValueBool = valB;
                    break;
                case EnumKAttributeDataType.TabulatedValue:
                    KAttribute.TabulatedValues = await GetTabulatedValues(store, KAttribute.KAttributeId);
                    KAttribute.ValueTabulate = KAttribute.Value;
                    break;
                case EnumKAttributeDataType.TagsValue:
                    KAttribute.TagsValues = await GetTagsValues(store, KAttribute.KAttributeId, KAttribute.Value);
                    KAttribute.ValueTags = KAttribute.Value;
                    break;
                default:
                    break;
            }
        }

        await base.OnInitializedAsync();
    }

    // Static so NoteForm can load the values of a new note type's attributes even when this component
    // doesn't exist (RadzenTabs only renders the selected tab). A failed call is already notified by
    // BaseService (AppState.NotifyError).
    public static async Task<List<KAttributeTabulatedValueDto>> GetTabulatedValues(IStore store, Guid idAttribute)
    {
        var result = await store.KAttributes.GetKAttributeTabulatedValuesAsync(idAttribute);
        if (!result.IsValid)
            return new List<KAttributeTabulatedValueDto>();
        else
            return result.Entity.ToList();
    }

    public static async Task<List<MultiSelectListDto>> GetTagsValues(IStore store, Guid idAttribute, string tags)
    {
        List<MultiSelectListDto> tagsSel;

        var result = await store.KAttributes.GetKAttributeTabulatedValuesAsync(idAttribute);
        if (!result.IsValid)
        {
            tagsSel = new List<MultiSelectListDto>();
        }
        else
        {
            var tagsList = result.Entity.ToList();
            tagsSel = new List<MultiSelectListDto>();

            foreach (var t in tagsList)
            {
                var selected = false;
                if (tags?.IndexOf(t.Value.ToString()) >= 0)
                    selected = true;

                tagsSel.Add(new MultiSelectListDto(selected, t.Value.ToString(), t.Value.ToString()));
            }
        }

        return tagsSel;
    }

    private static IEnumerable<string> SelectedTags(NoteKAttributeDto item) =>
        item.TagsValues.Where(t => t.Selected).Select(t => t.Key).ToList();

    private void onAttributeChange(NoteKAttributeDto item, string value)
    {
        item.ValueTags = value;

        foreach (var t in item.TagsValues)
        {
            var selected = false;
            if (value.IndexOf(t.Value.ToString()) >= 0)
                selected = true;

            t.Selected = selected;
        }
    }

}
