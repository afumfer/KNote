@implements IAsyncDisposable

@inject TooltipService tooltipService
@inject ContextMenuService contextMenuService
@inject IJSRuntime js

@*
    Notes list that loads its own data through LoadPage while it is scrolled (virtualized rows), filling the
    height of its container. A click selects a row (the current row, js/notesGrid.js), which the arrows, page
    keys, Home and End move too (a right click selects it as well); double click or Enter edits its note (views it,
    for who can't edit); a right click, the context menu key or Shift+F10 show its actions, and Delete deletes it.
    View and edit open the note in a window of its own (the page's OnNoteView/OnNoteEdit, see KntWindows). The
    page's header acts on the selected note too (Current, ViewCurrentAsync, EditCurrentAsync, DeleteCurrentAsync).
    The headers sort the list (in the server: LoadPage gets the order). With Position it remembers where the user
    was when the page is left, to show the list there again.
*@

<div @ref="host" class="knt-notes-grid-host" data-count="@count" @oncontextmenu:preventDefault="true">
    <div class="knt-notes-grid-summary">@count notes</div>
    <RadzenDataGrid @ref="grid" TItem="NoteMinimalDto" KeyProperty="NoteId" class="knt-notes-grid"
                    Data="@notes" Count="@count" LoadData="OnLoadData" IsLoading="@isLoading"
                    AllowVirtualization="true" VirtualizationOverscanCount="10"
                    Density="Density.Compact" GridLines="DataGridGridLines.Horizontal" AllowAlternatingRows="false"
                    AllowColumnResize="true" AllowSorting="true" EmptyText="No notes found."
                    RowRender="OnRowRender" RowDoubleClick="OnRowDoubleClick" CellContextMenu="OnCellContextMenu">
        @* The columns of ClientWin's notes selector, in the same order. *@
        <Columns>
            <RadzenDataGridColumn TItem="NoteMinimalDto" Property="NoteNumber" Title="#" Width="64px" TextAlign="TextAlign.Right"
                                  SortOrder="@SortOrderOf("NoteNumber")">
                <Template Context="note">
                    <span class="knt-notes-grid-muted">@note.NoteNumber</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="NoteMinimalDto" Property="Topic" Title="Topic" MinWidth="220px" SortOrder="@SortOrderOf("Topic")">
                <Template Context="note">
                    <span class="knt-notes-grid-title">@note.Topic</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="NoteMinimalDto" Property="Priority" Title="Priority" Width="96px" TextAlign="TextAlign.Center"
                                  SortOrder="@SortOrderOf("Priority")" />
            <RadzenDataGridColumn TItem="NoteMinimalDto" Property="Tags" Title="Tags" Width="120px" SortOrder="@SortOrderOf("Tags")">
                <Template Context="note">
                    <span class="knt-notes-grid-muted">@note.Tags</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="NoteMinimalDto" Property="InternalTags" Title="Status" Width="110px" Visible="@(!Compact)" SortOrder="@SortOrderOf("InternalTags")">
                <Template Context="note">
                    <span class="knt-notes-grid-muted">@note.InternalTags</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="NoteMinimalDto" Property="ModificationDateTime" Title="Modified" Width="100px" TextAlign="TextAlign.Right" Visible="@(!Compact)"
                                  SortOrder="@SortOrderOf("ModificationDateTime")">
                <Template Context="note">
                    <span class="knt-notes-grid-muted">@note.ModificationDateTime.ToShortDateString()</span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="NoteMinimalDto" Property="CreationDateTime" Title="Created" Width="100px" TextAlign="TextAlign.Right" Visible="@(!Compact)"
                                  SortOrder="@SortOrderOf("CreationDateTime")">
                <Template Context="note">
                    <span class="knt-notes-grid-muted">@note.CreationDateTime.ToShortDateString()</span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@code {
    // Loads a page of the list in an order (null: the list's own order).
    [Parameter][EditorRequired] public Func<PageIdentifier, NotesOrder?, Task<Result<List<NoteMinimalDto>>>> LoadPage { get; set; } = null!;
    [Parameter] public NotesListPosition? Position { get; set; }
    // Compact view: number, topic, priority and tags (NotesListViewToggle).
    [Parameter] public bool Compact { get; set; } = true;
    // The order the list starts with, unless Position remembers another one.
    [Parameter] public NotesOrder? Order { get; set; }
    // The user sorted the list with a header (null: removed the sort, back to the list's own order).
    [Parameter] public EventCallback<NotesOrder?> OrderChanged { get; set; }
    [Parameter] public EventCallback<NoteMinimalDto> OnNoteView { get; set; }
    [Parameter] public EventCallback<NoteMinimalDto> OnNoteEdit { get; set; }
    [Parameter] public EventCallback<NoteMinimalDto> OnNoteDelete { get; set; }
    // The selected (current) row changed: the page shows its header buttons again.
    [Parameter] public EventCallback CurrentChanged { get; set; }

    /// <summary>The note of the selected (current) row, if any.</summary>
    public NoteMinimalDto? Current { get; private set; }

    /// <summary>The order the list is shown in (null: the list's own order), e.g. to print it in the same one.</summary>
    public NotesOrder? CurrentOrder => order;

    /// <summary>How many notes the list has (all of them, not only the ones loaded); 0 until they are known.</summary>
    public int TotalCount => count;

    /// <summary>Whether there is a selected note to view.</summary>
    public bool CanViewCurrent => Current != null;

    /// <summary>Whether the user can edit or delete the selected note.</summary>
    public bool CanEditCurrent => Current != null && canEdit;

    public Task ViewCurrentAsync() => Current == null ? Task.CompletedTask : RunActionAsync(NoteAction.View, Current);

    public Task EditCurrentAsync() => Current == null ? Task.CompletedTask : RunActionAsync(NoteAction.Edit, Current);

    public Task DeleteCurrentAsync() => Current == null ? Task.CompletedTask : RunActionAsync(NoteAction.Delete, Current);

    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = null!;

    private enum NoteAction { View, Edit, Delete }

    // Notes are requested from the API in blocks of this size, whatever rows the grid asks for, and kept
    // until the next reload: scrolling back does not repeat requests. The pending request is what is kept,
    // so the grid asking twice for the same rows makes a single request.
    private const int FetchSize = 50;

    private ElementReference host;
    private IJSObjectReference? module;
    private IJSObjectReference? keyboardHelper;
    private DotNetObjectReference<NotesGrid>? dotNetRef;
    private RadzenDataGrid<NoteMinimalDto>? grid;
    private IEnumerable<NoteMinimalDto>? notes;
    private int count;
    private bool isLoading;
    private bool canEdit;
    private bool restoreScroll;
    private readonly Dictionary<int, Task<List<NoteMinimalDto>?>> blocks = new();
    // Position of each note loaded in the whole list (data-knt-index of its row, for js/notesGrid.js: Radzen's
    // aria-rowindex can't be trusted, it goes wrong when the grid is drawn again by its parent).
    private readonly Dictionary<Guid, int> noteIndexes = new();
    private int dataVersion;
    private NotesOrder? order;
    private NotesOrder? initialOrder;
    private NotesOrder? gridSort;
    private bool gridSortKnown;

    protected override async Task OnInitializedAsync()
    {
        renderedCompact = Compact;
        restoreScroll = Position?.ScrollTop > 0;
        order = initialOrder = Position?.Order ?? Order;

        var user = (await AuthenticationState).User;
        canEdit = user.IsInRole("Admin") || user.IsInRole("ProjectManager") || user.IsInRole("Staff");
    }

    // The page draws itself again often (its header follows the selected note, AppState changes...). If that
    // draws the grid again while Radzen loads rows (virtualization), the grid can be left without rows or with
    // old ones: the grid only draws again for the page when its view (Compact) changes. Its own changes (rows
    // loaded, order, selection) draw it as usual.
    private bool parentRender;
    private bool renderedCompact;

    protected override void OnParametersSet()
    {
        parentRender = true;
    }

    protected override bool ShouldRender()
    {
        if (!parentRender)
            return true;

        parentRender = false;
        if (renderedCompact == Compact)
            return false;
        renderedCompact = Compact;
        return true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            keyboardHelper = await (await GetModuleAsync()).InvokeAsync<IJSObjectReference>("initialize", host, dotNetRef);

            // A new list has no selected note yet: the page updates its header buttons (it may have shown those of
            // the previous list).
            await CurrentChanged.InvokeAsync();
        }

        // Back to a list left before: once the first rows (and so the total) are drawn, scroll to where it
        // was; the grid then asks for the rows of that place.
        if (restoreScroll && notes != null && count > 0)
        {
            restoreScroll = false;
            await (await GetModuleAsync()).InvokeVoidAsync("restoreScrollTop", host, Position!.ScrollTop);
        }
    }

    /// <summary>Forgets the loaded notes and loads again the ones in view (e.g. after deleting a note).</summary>
    public async Task ReloadAsync()
    {
        // The selected note may be gone: the current row tells the new one once it is drawn again.
        Current = null;
        await CurrentChanged.InvokeAsync();

        await RefreshAsync();
    }

    /// <summary>Loads again the notes in view, keeping the selected one (e.g. after a note is saved in its
    /// window).</summary>
    public async Task RefreshAsync()
    {
        blocks.Clear();
        noteIndexes.Clear();
        dataVersion++;

        if (grid != null)
        {
            await grid.RefreshDataAsync();
            // Radzen's virtualization (Virtualize.RefreshDataAsync) loads the rows again but doesn't draw them:
            // with the same rows as before (a note saved) the old ones would stay in view.
            StateHasChanged();
        }
    }

    // Only the initial sort of the headers: then Radzen keeps it (changing it while the grid reloads its rows
    // after a sort leaves the old rows in view).
    private SortOrder? SortOrderOf(string column) =>
        initialOrder?.Column != column ? null : initialOrder.Ascending ? SortOrder.Ascending : SortOrder.Descending;

    private async Task OnLoadData(LoadDataArgs args)
    {
        // The sort of the headers changed (not just reported again, nor the initial one by a column not shown).
        var sort = args.Sorts?.FirstOrDefault(s => s.SortOrder != null && s.Property != null);
        var sortAsked = sort == null ? null : new NotesOrder(sort.Property!, sort.SortOrder == SortOrder.Ascending);
        if (gridSortKnown && sortAsked != gridSort && sortAsked != order)
            await ChangeOrderAsync(sortAsked);
        gridSort = sortAsked;
        gridSortKnown = true;

        var version = dataVersion;
        var skip = args.Skip ?? 0;
        var top = args.Top ?? FetchSize;

        isLoading = true;

        var items = new List<NoteMinimalDto>();
        var firstBlock = skip / FetchSize;
        var lastBlock = (skip + top - 1) / FetchSize;
        for (var block = firstBlock; block <= lastBlock; block++)
        {
            var blockNotes = await GetBlockAsync(block);
            // A reload was requested while waiting: that reload will load the data.
            if (version != dataVersion)
                return;
            if (blockNotes == null)
                break;
            items.AddRange(blockNotes);
            if (blockNotes.Count < FetchSize)
                break;
        }

        notes = items.Skip(skip - firstBlock * FetchSize).Take(top).ToList();
        isLoading = false;
    }

    private Task<List<NoteMinimalDto>?> GetBlockAsync(int block)
    {
        if (!blocks.TryGetValue(block, out var blockTask))
        {
            blockTask = FetchBlockAsync(block, dataVersion);
            blocks[block] = blockTask;
        }
        return blockTask;
    }

    private async Task<List<NoteMinimalDto>?> FetchBlockAsync(int block, int version)
    {
        var result = await LoadPage(new PageIdentifier { PageNumber = block + 1, PageSize = FetchSize }, order);
        if (version != dataVersion)
            return null;

        if (!result.IsValid)
        {
            // The error is already notified; forget it so that the block is requested again.
            blocks.Remove(block);
            return null;
        }

        count = (int)result.TotalCount;
        var notesOfBlock = result.Entity ?? new List<NoteMinimalDto>();
        for (var i = 0; i < notesOfBlock.Count; i++)
            noteIndexes[notesOfBlock[i].NoteId] = block * FetchSize + i;
        return notesOfBlock;
    }

    // A new order: the notes loaded are no longer valid, and the list starts again at the top.
    private async Task ChangeOrderAsync(NotesOrder? newOrder)
    {
        order = newOrder;
        if (Position != null)
            Position.Order = newOrder;

        blocks.Clear();
        noteIndexes.Clear();
        dataVersion++;
        await (await GetModuleAsync()).InvokeVoidAsync("setScrollTop", host, 0);
        await OrderChanged.InvokeAsync(newOrder);
    }

    private void OnRowRender(RowRenderEventArgs<NoteMinimalDto> args)
    {
        if (args.Data == null)
            return;

        // Used by notesGrid.js: the note of each row and its position in the whole list.
        args.Attributes["data-note-id"] = args.Data.NoteId;
        if (noteIndexes.TryGetValue(args.Data.NoteId, out var index))
            args.Attributes["data-knt-index"] = index;
        if (args.Data.NoteId == Position?.LastNoteId)
            args.Attributes["data-last-selected"] = true;
    }

    private async Task OnRowDoubleClick(DataGridRowMouseEventArgs<NoteMinimalDto> args)
    {
        if (args.Data != null)
            await RunActionAsync(OpenAction, args.Data);
    }

    // Double click or Enter: edit the note, or view it for who can't edit.
    private NoteAction OpenAction => canEdit ? NoteAction.Edit : NoteAction.View;

    private async Task OnCellContextMenu(DataGridCellMouseEventArgs<NoteMinimalDto> args)
    {
        if (args.Data != null)
            await OpenActions(args.Data, args);
    }

    /// <summary>The current row changed (js/notesGrid.js): a click, the keyboard or a reload.</summary>
    [JSInvokable]
    public async Task OnCurrentChanged(string? noteId)
    {
        Current = noteId == null ? null : FindLoadedNote(noteId);
        await CurrentChanged.InvokeAsync();
    }

    /// <summary>A key pressed on the current row (js/notesGrid.js): "open", "menu" or "delete".</summary>
    [JSInvokable]
    public async Task OnKeyAction(string action, string noteId)
    {
        var note = FindLoadedNote(noteId);
        if (note == null)
            return;

        if (action == "menu")
            await OpenActions(note, null);
        else if (action == "delete")
        {
            if (canEdit)
                await RunActionAsync(NoteAction.Delete, note);
        }
        else
            await RunActionAsync(OpenAction, note);
    }

    // Among all the notes loaded: the grid draws rows from several requests, `notes` is only the last one.
    private NoteMinimalDto? FindLoadedNote(string noteId) =>
        blocks.Values
            .Where(blockTask => blockTask.IsCompletedSuccessfully && blockTask.Result != null)
            .SelectMany(blockTask => blockTask.Result!)
            .FirstOrDefault(n => n.NoteId.ToString() == noteId);

    private List<KntAction> ActionsOf(NoteMinimalDto note)
    {
        var actions = new List<KntAction> { new("View", "launch", () => RunActionAsync(NoteAction.View, note)) };
        if (canEdit)
        {
            actions.Add(new("Edit", "edit", () => RunActionAsync(NoteAction.Edit, note)));
            actions.Add(new("Delete", "delete", () => RunActionAsync(NoteAction.Delete, note), Danger: true));
        }
        return actions;
    }

    /// <summary>Shows the actions of a note at the mouse (args) or, from the keyboard, below its row.</summary>
    private async Task OpenActions(NoteMinimalDto note, MouseEventArgs? args)
    {
        tooltipService.Close();

        if (args == null)
        {
            var anchor = await (await GetModuleAsync()).InvokeAsync<Point?>("getActionsAnchor", host, note.NoteId);
            args = new MouseEventArgs { ClientX = anchor?.X ?? 0, ClientY = anchor?.Y ?? 0 };
        }

        KntActionsMenu.Open(contextMenuService, args, ActionsOf(note));
    }

    private Task RunActionAsync(NoteAction action, NoteMinimalDto note) => action switch
    {
        NoteAction.View => OnNoteView.InvokeAsync(note),
        NoteAction.Edit => OnNoteEdit.InvokeAsync(note),
        _ => OnNoteDelete.InvokeAsync(note)
    };

    private async Task<IJSObjectReference> GetModuleAsync() =>
        module ??= await js.InvokeAsync<IJSObjectReference>("import", "./js/notesGrid.js");

    private record Point(double X, double Y);

    public async ValueTask DisposeAsync()
    {
        if (keyboardHelper != null)
        {
            // The page is left (or the list replaced by another one): Position remembers where the list was
            // scrolled and its selected note, to show them again when the user comes back.
            if (Position != null)
            {
                Position.ScrollTop = await keyboardHelper.InvokeAsync<double>("scrollTop");
                if (Current != null)
                    Position.LastNoteId = Current.NoteId;
            }
            await keyboardHelper.InvokeVoidAsync("dispose");
            await keyboardHelper.DisposeAsync();
        }
        if (module != null)
            await module.DisposeAsync();
        dotNetRef?.Dispose();
    }
}
