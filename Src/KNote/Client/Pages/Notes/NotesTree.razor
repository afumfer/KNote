@page "/notes/tree"
@page "/tree"

@using KNote.Client.Auth
@using KNote.Model.Core
@using KNote.Client.Pages.Folders

@implements IDisposable

@inject IStore store
@inject KntWindows kntWindows
@inject KntAccess access
@inject TooltipService tooltipService
@inject DialogService dialogService
@inject IJSRuntime js

@attribute [Authorize(Roles = "Guest, Staff, ProjectManager, Admin")]

<KntIndexHeader TextHead="@(folder?.Name ?? "( No folder selected )")" Icon="@KntSections.TreePanel.Icon">
    <IndexMenu>
        <RadzenMenu>
            <RadzenMenuItem Text="New note" Icon="post_add"  Click="OnNew"></RadzenMenuItem>
            <RadzenMenuItem Text="Edit note ..." Icon="edit" Disabled="@(!(notesGrid?.HasCurrent ?? false))" Click="@(() => notesGrid!.EditCurrentAsync())"></RadzenMenuItem>
            <RadzenMenuItem Text="Delete note ..." Icon="delete" Disabled="@(!(notesGrid?.HasCurrent ?? false) || deleting.IsBusy)" Click="@(() => notesGrid!.DeleteCurrentAsync())"></RadzenMenuItem>
            @* The selected folder (managing folders needs ProjectManager, checked when chosen) and the tree. *@
            <RadzenMenuItem Text="Folder" Icon="folder" class="knt-menu-separator">
                <RadzenMenuItem Text="New folder ..." Icon="create_new_folder" Click="OnNewFolder" />
                <RadzenMenuItem Text="Edit folder ..." Icon="edit" Disabled="@(folder == null)" Click="@(() => OnEditFolder(folder!))" />
                <RadzenMenuItem Text="Delete folder ..." Icon="delete" Disabled="@(folder == null || folderAction.IsBusy)" Click="@(() => OnDeleteFolder(folder!))" />
                <RadzenMenuItem Text="Refresh tree" Icon="refresh" Click="RefreshTreeFolders" />
            </RadzenMenuItem>
            <NotesViewOptionsMenu Grid="notesGrid" Changed="StateHasChanged" />
            <NotesPrintExportMenu Grid="notesGrid" Request="ReportRequest" DefaultOrder="FolderOrder()" ListName="@folder?.Name" />
        </RadzenMenu>
    </IndexMenu>
</KntIndexHeader>

@* The panel takes the height left in the window: the tree and the notes list scroll each on its own, the page
   doesn't. *@
<RadzenCard class="rz-p-1 rz-mt-2" Style="height: calc(100vh - 10rem)">
    <RadzenSplitter class="@(appState.NotesPreviewVisible == true ? null : "knt-preview-hidden")" Resize="paneSizes.Resized">
        <RadzenSplitterPane Size="@paneSizes[0]" Min="160px" Max="45%" Style="overflow: auto">
            <KntFoldersTreeView FoldersInfo="foldersTree" FolderSelected="FolderSelected" FolderActions="FolderActionsOf" />
        </RadzenSplitterPane>
        <RadzenSplitterPane Size="@paneSizes[1]" Min="320px" class="knt-notes-list-pane">
            @if (folder != null)
            {
                @* A new grid for each folder: it starts at the top (or where it was left) with its own data, in the
                   folder's order (Folder.OrderNotes, as in ClientWin). *@
                <NotesGrid @ref="notesGrid" CurrentChanged="StateHasChanged" Compact="@(appState.NotesListCompact ?? true)" @key="folder.FolderId" LoadPage="LoadNotesPage" Position="appState.NotesTreePosition"
                           Order="FolderOrder()" OrderChanged="OnOrderChanged"
                           OnNoteDelete="OnDelete" OnNoteEdit="OnEdit" OnNoteView="OnView" />
            }
        </RadzenSplitterPane>
        @* Always there, with the sizes of all the panes set from the start (Radzen sizes the panes when they are
           added): hidden with knt-preview-hidden, see knt-theme.css. *@
        <RadzenSplitterPane Size="@paneSizes[2]" Min="240px" class="knt-note-preview-pane">
            @if (appState.NotesPreviewVisible == true)
            {
                <NotePreviewPane NoteId="@notesGrid?.Current?.NoteId" />
            }
        </RadzenSplitterPane>
    </RadzenSplitter>
</RadzenCard>


@code {
    private List<FolderDto>? foldersTree;
    private FolderDto? folder;
    private NotesGrid? notesGrid;
    private AppState appState = null!;
    private bool canSaveOrder;
    // The sizes of the panes the user left, kept in the browser.
    private KntPaneSizes paneSizes = null!;

    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        paneSizes = new KntPaneSizes(js, "KNoteNotesTreePanes", "20%", "45%", "35%");

        // The order chosen in the list is saved silently, only for who can (Staff and up).
        canSaveOrder = KntAccess.HasRole((await AuthenticationState).User, EnumRoles.Staff);

        appState = store.AppState;
        appState.OnChange += StateHasChanged;
        kntWindows.NoteSaved += OnNoteSaved;
        await Load();
    }

    private async Task Load()
    {
        if (appState.FoldersTree == null)
        {
            var result = await store.Folders.GetTreeAsync();
            if (result.IsValid)
                foldersTree = result.Entity;
            else
                foldersTree = new List<FolderDto>();

            // Only a tree read is kept: after a failure (the session refused, no network) it is asked again next time.
            if (result.IsValid)
                appState.FoldersTree = foldersTree;

            if (foldersTree?.Count > 0)
            {
                // The folder that was selected, if it is still there (the tree read again: refreshed, or a folder
                // changed), or the first one.
                var f = FindFolder(foldersTree, appState.SelectedFolder?.FolderId ?? Guid.Empty) ?? foldersTree.FirstOrDefault();
                if (f != null)
                {
                    f.Selected = true;
                    FolderSelected(f);
                }
            }
        }
        else
        {
            foldersTree = appState.FoldersTree;

            // Back to the page: the folder that was shown (with the list where it was, NotesTreePosition), as
            // it is in the tree (SelectedFolder is a copy, it may not have its last order of notes).
            if (appState.IsSelectedFolder())
                FolderSelected(FindFolder(foldersTree, appState.SelectedFolder!.FolderId) ?? appState.SelectedFolder!);
        }
    }

    public void Dispose()
    {
        appState.OnChange -= StateHasChanged;
        kntWindows.NoteSaved -= OnNoteSaved;
    }

    private void FolderSelected(FolderDto f)
    {
        // The tree also reports the folder it shows selected when it is drawn: nothing changes then.
        if (folder?.FolderId == f.FolderId)
            return;

        var listKey = f.FolderId.ToString();
        if (appState.NotesTreePosition?.ListKey != listKey)
            appState.NotesTreePosition = new NotesListPosition { ListKey = listKey };

        folder = f;
        appState.SelectedFolder = folder.GetSimpleDto<FolderDto>();
    }

    private static FolderDto? FindFolder(List<FolderDto>? folders, Guid folderId)
    {
        foreach (var f in folders ?? [])
        {
            var found = f.FolderId == folderId ? f : FindFolder(f.ChildFolders, folderId);
            if (found != null)
                return found;
        }
        return null;
    }

    private NotesOrder FolderOrder() => NotesOrder.From(NoteOrderCriteria.Parse(folder?.OrderNotes));

    private async Task<Result<List<NoteMinimalDto>>> LoadNotesPage(PageIdentifier page, NotesOrder? order, CancellationToken cancellationToken)
    {
        // Without an order chosen in the list, the folder's one.
        order ??= FolderOrder();

        // A new filter for each request: the grid may ask for several pages at the same time.
        return await store.Notes.GetFilter(new NotesFilterDto
        {
            FolderId = folder?.FolderId,
            PageIdentifier = page,
            OrderColumn = order.Column,
            OrderAscending = order.Ascending
        }, cancellationToken);
    }

    // The folder's notes, to print or export them (NotesPrintExportMenu adds the list's order and view).
    private NotesListReportRequestDto ReportRequest() => new()
    {
        Source = NotesListReportSource.Folder,
        FolderId = folder?.FolderId
    };

    // The order to save next, and whether one is being saved: sorting again meanwhile saves only the last order
    // chosen, after that one (in the order they are chosen, not as their answers arrive).
    private (FolderDto Folder, string OrderNotes)? orderToSave;
    private bool savingOrder;

    // Sorted with a header: a folder in Auto mode remembers it (NoteOrderCriteria.FormatUserOrder), as in ClientWin.
    private async Task OnOrderChanged(NotesOrder? order)
    {
        if (order == null || folder == null || !canSaveOrder)
            return;

        var orderNotes = NoteOrderCriteria.Parse(folder.OrderNotes).FormatUserOrder(order.Column, order.Ascending);
        if (orderNotes == null || orderNotes == folder.OrderNotes)
            return;

        orderToSave = (folder, orderNotes);
        if (savingOrder)
            return;

        savingOrder = true;
        try
        {
            while (orderToSave is var (folderToSave, orderNotesToSave))
            {
                orderToSave = null;
                var result = await store.Folders.UpdateOrderNotesAsync(folderToSave.FolderId, orderNotesToSave);
                if (result.IsValid)
                    folderToSave.OrderNotes = orderNotesToSave;
            }
        }
        finally
        {
            savingOrder = false;
        }
    }

    // Creating a note needs Staff (KntAccess, checked with no wait before: it opens a window).
    async Task OnNew()
    {
        if (await access.CheckAsync(AuthenticationState, EnumRoles.Staff, "Creating notes"))
            await kntWindows.OpenNewAsync();
    }

    Task OnView(NoteMinimalDto note) => kntWindows.OpenViewAsync(note.NoteId);

    Task OnEdit(NoteMinimalDto note) => kntWindows.OpenEditAsync(note.NoteId);

    // A note saved in its window: the list shows it changed (or moved, or gone from it).
    void OnNoteSaved(Guid noteId)
    {
        _ = InvokeAsync(() => notesGrid?.RefreshAsync() ?? Task.CompletedTask);
    }

    // One delete at a time: a click or the Delete key repeated asks and deletes once.
    private readonly KntSingleFlight deleting = new();

    Task OnDelete(NoteMinimalDto item) => deleting.RunAsync(() => DeleteAsync(item));

    async Task DeleteAsync(NoteMinimalDto item)
    {                
        var resultDialog = await dialogService.Confirm(
            $"Are you sure you want delete note - {@item.Topic} - ({@item.NoteNumber})?", 
            "Delete note", 
            new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });

        if (resultDialog == true)
        {
            var result = await store.Notes.DeleteAsync(item.NoteId);
            if (result.IsValid && notesGrid != null)
            {
                await notesGrid.ReloadAsync();
            }
        }
    }

    // Managing folders needs ProjectManager (KntAccess, as FolderEditorCtrl in ClientWin); one at a time. After a
    // change the tree is read again, with the selected folder.
    private readonly KntSingleFlight folderAction = new();

    private Task<bool> CanManageFoldersAsync() => access.CheckAsync(AuthenticationState, EnumRoles.ProjectManager, "Managing folders");

    // A right click on a folder of the tree.
    private List<KntAction> FolderActionsOf(FolderDto f) =>
    [
        new("Edit folder", "edit", () => OnEditFolder(f)),
        new("Delete folder", "delete", () => OnDeleteFolder(f), Danger: true)
    ];

    private Task OnNewFolder() => folderAction.RunAsync(async () =>
    {
        if (await CanManageFoldersAsync() && await FolderDialogs.NewAsync(dialogService))
            await RefreshTreeFolders();
    });

    private Task OnEditFolder(FolderDto f) => folderAction.RunAsync(async () =>
    {
        if (await CanManageFoldersAsync() && await FolderDialogs.EditAsync(dialogService, f))
            await RefreshTreeFolders();
    });

    private Task OnDeleteFolder(FolderDto f) => folderAction.RunAsync(async () =>
    {
        if (await CanManageFoldersAsync() && await FolderDialogs.DeleteAsync(dialogService, store, f))
            await RefreshTreeFolders();
    });

    private async Task RefreshTreeFolders()
    {
        foldersTree = null;
        folder = null;
        appState.FoldersTree = null;
        await Load();
    }
    
}
