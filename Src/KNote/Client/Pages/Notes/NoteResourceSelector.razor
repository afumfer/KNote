@inject DialogService dialogService

@* Dialog to add a resource to a note (NoteForm opens it framed): the file, its description and order. The result
   is the resource (with its content), or null if cancelled. *@

<KntDialogFrame Icon="upload_file" Title="Add resource" Subtitle="@(string.IsNullOrEmpty(NoteTopic) ? "Upload a file to the note." : NoteTopic)">
    <ChildContent>
        <RadzenStack Gap="1rem">
            <InputFileUpload OnSelectedFile="OnFileSelected" />
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeSM="9">
                    <KntField Label="Description" Component="Description" Help="How the resource is shown and inserted in the description.">
                        <RadzenTextBox Name="Description" @bind-Value="@resource.Description" Disabled="@(!fileChosen)" />
                    </KntField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeSM="3">
                    <KntField Label="Order" Component="Order">
                        <RadzenNumeric Name="Order" @bind-Value="@resource.Order" Disabled="@(!fileChosen)" />
                    </KntField>
                </RadzenColumn>
            </RadzenRow>
        </RadzenStack>
    </ChildContent>
    <Footer>
        <RadzenButton Text="Cancel" Click="() => OnCancel()" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" />
        <RadzenButton Text="Add" Icon="upload" Click="() => OnConfirm()" ButtonStyle="ButtonStyle.Primary" Disabled="@(!fileChosen)" />
    </Footer>
</KntDialogFrame>

@code {
    // The note the resource is for (the dialog's subtitle).
    [Parameter] public string? NoteTopic { get; set; }

    private ResourceInfoDto resource = new ResourceInfoDto();
    private bool fileChosen;

    private void OnFileSelected(KntFileInfo file)
    {
        resource.ContentBase64 = file.ContentBase64;
        resource.Name = file.Name;
        resource.Description = file.Name;
        resource.FileType = file.Type;
        fileChosen = true;
    }

    private void OnConfirm()
    {
        if (fileChosen)
            dialogService.Close(resource);
    }

    private void OnCancel()
    {
        dialogService.Close(null);
    }
}
