@inject DialogService dialogService


<RadzenStack Gap="1rem">

    <RadzenStack Gap="1rem" Style="height: 400px; overflow: auto;">

        <InputFileUpload OnSelectedFile="OnFileSelected" />

        <KntFormField Label="Description:" Component="Description">
            <RadzenTextBox Name="Description" @bind-Value="@resource.Description" Style="width: 100%" />
        </KntFormField>

        <KntFormField Label="Order:" Component="Order">
            <RadzenNumeric Name="Order" @bind-Value="@resource.Order" Style="width: 100%" />
        </KntFormField>

        @if (resourceFlowControl == null)
        {
            <RadzenText Text="Upload file .... " />
        }

    </RadzenStack>

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
        <RadzenButton Text="Ok" Click="() => OnConfirm()" ButtonStyle="ButtonStyle.Primary" />
        <RadzenButton Text="Cancel" Click="() => OnCancel()" ButtonStyle="ButtonStyle.Secondary" />
    </RadzenStack>

</RadzenStack>

@code {
    private ResourceInfoDto resource = new ResourceInfoDto();
    private string? resourceFlowControl = "0";

    private void OnFileSelected(KntFileInfo file)
    {
        resourceFlowControl = null;

        resource.ContentBase64 = file.ContentBase64;
        resource.Name = file.Name;
        resource.Description = file.Name;
        resource.FileType = file.Type;        

        resourceFlowControl = "1";
    }

    private void OnConfirm()
    {
        dialogService.Close(resource);
    }

    private void OnCancel()
    {        
        dialogService.Close(null);
    }
}