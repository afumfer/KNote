@page "/notes/search"
@page "/search"

@using KNote.Client.Auth

@implements IDisposable

@inject IStore store
@inject KntWindows kntWindows
@inject KntAccess access
@inject TooltipService tooltipService
@inject DialogService dialogService
@inject IJSRuntime js

@attribute [Authorize(Roles = "Guest, Staff, ProjectManager, Admin")]

<KntIndexHeader Section="KntSections.QuickSearch">
    <IndexMenu>
        <RadzenMenu>
            <RadzenMenuItem Text="New note" Icon="post_add"  Click="OnNew"></RadzenMenuItem>
            @if (ResourcesShown)
            {
                @* The photos or the documents found (4.6b): their notes, but no printing (the reports are of notes). *@
                <RadzenMenuItem Text="Edit note ..." Icon="edit" Disabled="@(selectedHit == null)" Click="@(() => OnOpenNote(selectedHit!))"></RadzenMenuItem>
                <NotesViewOptionsMenu Grid="null" Changed="StateHasChanged" />
            }
            else
            {
                <RadzenMenuItem Text="Edit note ..." Icon="edit" Disabled="@(!(notesGrid?.HasCurrent ?? false))" Click="@(() => notesGrid!.EditCurrentAsync())"></RadzenMenuItem>
                <RadzenMenuItem Text="Delete note ..." Icon="delete" Disabled="@(!(notesGrid?.HasCurrent ?? false) || deleting.IsBusy)" Click="@(() => notesGrid!.DeleteCurrentAsync())"></RadzenMenuItem>
                <NotesViewOptionsMenu Grid="notesGrid" Changed="StateHasChanged" />
                <NotesPrintExportMenu Grid="notesGrid" Request="ReportRequest" ListName="@($"Search: {SearchedText()}")" />
            }
        </RadzenMenu>
    </IndexMenu>
</KntIndexHeader>

@* The search box and, below, the notes list taking the height left in the window. *@
<RadzenStack Gap="0.5rem" class="rz-pt-2" Style="height: calc(100vh - 9.5rem)">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <RadzenFormField Text="Text search" Variant="Variant.Outlined" Style="flex: 1;">
            <Start><RadzenIcon Icon="search" /></Start>
            <ChildContent>
                <RadzenTextBox @bind-Value="textSearch" Immediate="true" @onkeypress="@((KeyboardEventArgs e) => TopicKeyPress(e))" />
            </ChildContent>
        </RadzenFormField>
        @* By words (the search of always) or by meaning: only with a semantic index this server can search. *@
        @if (meaningAvailable)
        {
            <RadzenSelectBar @bind-Value="searchMode" TValue="EnumNotesSearchMode" Size="ButtonSize.Medium"
                             MouseEnter="@(args => tooltipService.Open(args, "Words: the notes with these words. Meaning: the notes that talk about it (the 100 most similar)."))">
                <Items>
                    <RadzenSelectBarItem Text="Words" Value="EnumNotesSearchMode.Words" />
                    <RadzenSelectBarItem Text="Meaning" Value="EnumNotesSearchMode.Meaning" />
                </Items>
            </RadzenSelectBar>
            @* By meaning (4.6b): the notes, or the photos or the documents by their own fragments. *@
            @if (searchMode == EnumNotesSearchMode.Meaning)
            {
                <RadzenSelectBar @bind-Value="resourceKind" TValue="EnumResourceKind" Size="ButtonSize.Medium"
                                 MouseEnter="@(args => tooltipService.Open(args, "All: the notes. Photos or Documents: the photos or the documents that talk about it, by their own description and text."))">
                    <Items>
                        <RadzenSelectBarItem Text="All" Value="EnumResourceKind.All" />
                        <RadzenSelectBarItem Text="Photos" Value="EnumResourceKind.Photos" />
                        <RadzenSelectBarItem Text="Documents" Value="EnumResourceKind.Documents" />
                    </Items>
                </RadzenSelectBar>
            }
        }
        <RadzenButton Text="Search" Icon="search" Click="OnSearch" ButtonStyle="ButtonStyle.Primary" />
    </RadzenStack>

    @* The options of the search by words (KNote Atlas 4.6a, as ClientWin's): the topic and the tags always. *@
    @if (searchMode == EnumNotesSearchMode.Words)
    {
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenCheckBox Name="SearchInDescription" TValue="bool" @bind-Value="@inDescription" />
                <RadzenLabel Text="Search in note description" Component="SearchInDescription" />
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenCheckBox Name="SearchInNoteTasks" TValue="bool" @bind-Value="@inTasks" />
                <RadzenLabel Text="Search in note tasks" Component="SearchInNoteTasks" />
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenCheckBox Name="SearchInResources" TValue="bool" @bind-Value="@inResources" />
                <RadzenLabel Text="Search in resources" Component="SearchInResources"
                             MouseEnter="@(args => tooltipService.Open(args, "Also in the descriptions of the photos and documents, and in the text of the documents (also the transcriptions of the scanned pages)."))" />
            </RadzenStack>
        </RadzenStack>
    }

    @* The notes not up to date (4.6b: why, and «Update index», the full indexing, for an Admin). *@
    @if (ResourcesShown ? resourcesFound != null : meaningPages != null)
    {
        <SemanticPendingNotice Pending="@(ResourcesShown ? resourcesFound!.PendingNotes : meaningPages!.PendingNotes)"
                               ForFullRun="@(ResourcesShown ? resourcesFound!.NotesForFullRun : meaningPages!.NotesForFullRun)"
                               WithoutFiles="@(ResourcesShown ? resourcesFound!.NotesWithoutFiles : meaningPages!.NotesWithoutFiles)"
                               ListKey="@ListKey()" Indexed="OnUpdateIndex" />
    }

    <RadzenCard class="rz-p-1" Style="flex: 1; min-height: 0">
        @* The list and, at its right, the preview of the selected note (if shown). *@
        <RadzenSplitter class="@(appState.NotesPreviewVisible == true ? null : "knt-preview-hidden")" Resize="paneSizes.Resized">
            <RadzenSplitterPane Size="@paneSizes[0]" Min="320px" class="knt-notes-list-pane">
                @if (ResourcesShown)
                {
                    <ResourceSearchResults @key="searchVersion" Text="@SearchedText()" Kind="@SearchedKind()"
                                           SelectedChanged="OnHitSelected" OpenNote="OnOpenNote" Found="OnResourcesFound" />
                }
                else
                {
                    @* A new grid for each search: it starts at the top (or where it was left) with its own data. *@
                    <NotesGrid @ref="notesGrid" CurrentChanged="StateHasChanged" Compact="@(appState.NotesListCompact ?? true)" @key="searchVersion" LoadPage="LoadNotesPage" Position="appState.NotesSearchPosition"
                               ShowSimilarity="@(SearchedMode() == EnumNotesSearchMode.Meaning)"
                               OnNoteDelete="OnDelete" OnNoteEdit="OnEdit" OnNoteView="OnView" />
                }
            </RadzenSplitterPane>
            @* Always there, with the sizes of all the panes set from the start (Radzen sizes the panes when they are
               added): hidden with knt-preview-hidden, see knt-theme.css. *@
            <RadzenSplitterPane Size="@paneSizes[1]" Min="240px" class="knt-note-preview-pane">
                @if (appState.NotesPreviewVisible == true)
                {
                    <NotePreviewPane NoteId="@(ResourcesShown ? selectedHit?.NoteId : notesGrid?.Current?.NoteId)" />
                }
            </RadzenSplitterPane>
        </RadzenSplitter>
    </RadzenCard>
</RadzenStack>


@code {
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = null!;

    private NotesGrid? notesGrid;
    private AppState appState = null!;
    private string textSearch = "";
    // The mode chosen beside the box (the one of the list shown is the search's, SearchedMode).
    private EnumNotesSearchMode searchMode;
    // The options of the search by words chosen below the box (4.6a; the ones of the list shown are SearchedOptions). The
    // description too is off by default in the Web (decided by the owner; ClientWin has it on).
    private bool inDescription;
    private bool inTasks;
    private bool inResources;
    // By meaning (4.6b): what is found, chosen beside the mode (the one of the list shown is SearchedKind), the resource
    // selected and the notes not up to date of its search.
    private EnumResourceKind resourceKind;
    private ResourceSearchHitDto? selectedHit;
    private SemanticSearchResultDto? resourcesFound;
    // The search by meaning can be offered: a semantic index this server can search (SemanticIndexTexts.CanSearch).
    private bool meaningAvailable;
    // The notes found by meaning of the list shown (null: by words, or without text).
    private KntMeaningSearchPages? meaningPages;
    private int searchVersion;
    // The sizes of the panes the user left, kept in the browser.
    private KntPaneSizes paneSizes = null!;
    private readonly CancellationTokenSource disposal = new();

    // The list's key (NotesListPosition.ListKey) is the text searched; by meaning, after a mark that can't be typed: it
    // is another list, with a position of its own. By words with options (4.6a), after another mark and the options (three
    // 0 or 1: description, tasks, resources).
    private const string MeaningKeyMark = "\u0001";
    private const string OptionsKeyMark = "\u0002";
    // By meaning, the photos or the documents (4.6b): after the mark of the meaning, this one and p or d.
    private const string KindKeyMark = "\u0003";

    private sealed record WordOptions(bool Description, bool Tasks, bool Resources)
    {
        public static readonly WordOptions None = new(false, false, false);

        public bool Any => Description || Tasks || Resources;

        public string Key => $"{(Description ? 1 : 0)}{(Tasks ? 1 : 0)}{(Resources ? 1 : 0)}";

        public string Query => (Description ? "&inDescription=true" : "") + (Tasks ? "&inTasks=true" : "") + (Resources ? "&inResources=true" : "");

        public static WordOptions OfKey(string key) => key.Length == 3 ? new(key[0] == '1', key[1] == '1', key[2] == '1') : None;
    }

    protected override void OnInitialized()
    {
        paneSizes = new KntPaneSizes(js, "KNoteNotesSearchPanes", "60%", "40%");

        // The text searched comes in the URL (notes/search?textSearch=...&mode=meaning); back from a note, without it,
        // the last search (with the list where it was, NotesSearchPosition, whose ListKey is the text and the mode).
        appState = store.AppState;
        var queries = store.GetQueryStrings(store.GetUri());
        if (queries != null && queries.TryGetValue("textSearch", out var text))
        {
            var mode = queries.TryGetValue("mode", out var modeText) && modeText == "meaning" ? EnumNotesSearchMode.Meaning : EnumNotesSearchMode.Words;
            bool On(string name) => queries.TryGetValue(name, out var value) && value == "true";
            var options = new WordOptions(On("inDescription"), On("inTasks"), On("inResources"));
            var kind = !queries.TryGetValue("kind", out var kindText) ? EnumResourceKind.All
                : kindText == "photos" ? EnumResourceKind.Photos : kindText == "documents" ? EnumResourceKind.Documents : EnumResourceKind.All;
            if (appState.NotesSearchPosition?.ListKey != ListKeyOf(mode, text, options, kind))
                appState.NotesSearchPosition = new NotesListPosition { ListKey = ListKeyOf(mode, text, options, kind) };
        }
        else
            appState.NotesSearchPosition ??= new NotesListPosition { ListKey = "" };

        textSearch = SearchedText();
        searchMode = SearchedMode();
        (inDescription, inTasks, inResources) = (SearchedOptions().Description, SearchedOptions().Tasks, SearchedOptions().Resources);
        resourceKind = SearchedKind();
        NewMeaningPages();

        kntWindows.NoteSaved += OnNoteSaved;
    }

    protected override async Task OnInitializedAsync()
    {
        var status = await store.SemanticSearch.GetIndexStatusAsync(disposal.Token);
        if (disposal.IsCancellationRequested)
            return;
        meaningAvailable = status.IsValid && SemanticIndexTexts.CanSearch(status.Entity);
        if (!meaningAvailable)
            searchMode = EnumNotesSearchMode.Words;
    }

    public void Dispose()
    {
        kntWindows.NoteSaved -= OnNoteSaved;
        DisposeMeaningPages();
        disposal.Cancel();
        disposal.Dispose();
    }

    private void OnSearch() => Search(searchMode, textSearch, new WordOptions(inDescription, inTasks, inResources), resourceKind);

    // The same search again (4.6b: when the full indexing started from the notice ends).
    private void OnUpdateIndex() => Search(SearchedMode(), SearchedText(), WordOptions.None, SearchedKind());

    private void Search(EnumNotesSearchMode mode, string text, WordOptions options, EnumResourceKind kind)
    {
        appState.NotesSearchPosition = new NotesListPosition { ListKey = ListKeyOf(mode, text, options, kind) };
        selectedHit = null;
        resourcesFound = null;
        NewMeaningPages();
        searchVersion++;
        store.NavigateTo(string.IsNullOrEmpty(text)
            ? "notes/search"
            : $"notes/search?textSearch={Uri.EscapeDataString(text)}" + (mode == EnumNotesSearchMode.Meaning
                ? "&mode=meaning" + (kind == EnumResourceKind.All ? "" : $"&kind={kind.ToString().ToLowerInvariant()}")
                : options.Query));
    }

    // The photos or the documents found by meaning are shown instead of the notes (4.6b).
    private bool ResourcesShown => SearchedMode() == EnumNotesSearchMode.Meaning && SearchedKind() != EnumResourceKind.All
        && !string.IsNullOrWhiteSpace(SearchedText());

    private void OnHitSelected(ResourceSearchHitDto? hit) => selectedHit = hit;

    private void OnResourcesFound(SemanticSearchResultDto found) => resourcesFound = found;

    // Its note: in its editing window, or to read it if the user can't edit (as the notes grid). No wait before: it opens a window.
    private Task OnOpenNote(ResourceSearchHitDto hit)
    {
        var user = AuthenticationState.IsCompletedSuccessfully ? AuthenticationState.Result.User : null;
        return user != null && KntAccess.HasRole(user, EnumRoles.Staff) ? kntWindows.OpenEditAsync(hit.NoteId) : kntWindows.OpenViewAsync(hit.NoteId);
    }

    private void TopicKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            OnSearch();
    }

    private async Task<Result<List<NoteMinimalDto>>> LoadNotesPage(PageIdentifier page, NotesOrder? order, CancellationToken cancellationToken)
    {
        if (SearchedMode() == EnumNotesSearchMode.Meaning)
            return meaningPages != null
                ? await meaningPages.LoadPageAsync(page, order, cancellationToken)
                : new Result<List<NoteMinimalDto>>(new List<NoteMinimalDto>()) { TotalCount = 0 };

        var search = SearchedText();
        var options = SearchedOptions();
        var queryString = $"textSearch={Uri.EscapeDataString(search)}&pageNumber={page.PageNumber}&pageSize={page.PageSize}"
            + (options.Description ? "&searchInDescription=true" : "") + (options.Tasks ? "&searchInNoteTasks=true" : "")
            + (options.Resources ? "&searchInResources=true" : "");
        if (order != null)
            queryString += $"&orderColumn={order.Column}&orderAscending={order.Ascending}";
        return await store.Notes.GetSearch(queryString, cancellationToken);
    }

    // The search by meaning of the list shown, done when the grid asks for its first page (not paged in the server).
    private void NewMeaningPages()
    {
        DisposeMeaningPages();
        var text = SearchedText();
        if (SearchedMode() != EnumNotesSearchMode.Meaning || string.IsNullOrWhiteSpace(text) || SearchedKind() != EnumResourceKind.All)
            return;
        meaningPages = new KntMeaningSearchPages(ct => store.SemanticSearch.SearchAsync(new SemanticSearchRequestDto { Text = text }, ct));
        meaningPages.Found += OnMeaningFound;
    }

    private void DisposeMeaningPages()
    {
        if (meaningPages == null)
            return;
        meaningPages.Found -= OnMeaningFound;
        meaningPages.Dispose();
        meaningPages = null;
    }

    // The notice of the notes not up to date.
    private void OnMeaningFound() => _ = InvokeAsync(StateHasChanged);

    private string ListKey() => appState.NotesSearchPosition?.ListKey ?? "";

    private static string ListKeyOf(EnumNotesSearchMode mode, string text, WordOptions options, EnumResourceKind kind) =>
        mode == EnumNotesSearchMode.Meaning
            ? MeaningKeyMark + (kind switch { EnumResourceKind.Photos => KindKeyMark + "p", EnumResourceKind.Documents => KindKeyMark + "d", _ => "" }) + text
        : options.Any ? OptionsKeyMark + options.Key + text
        : text;

    // By meaning, what was searched (4.6b).
    private EnumResourceKind SearchedKind()
    {
        var key = ListKey();
        if (SearchedMode() != EnumNotesSearchMode.Meaning || key.Length < MeaningKeyMark.Length + KindKeyMark.Length + 1
            || !key[MeaningKeyMark.Length..].StartsWith(KindKeyMark, StringComparison.Ordinal))
            return EnumResourceKind.All;
        return key[MeaningKeyMark.Length + KindKeyMark.Length] == 'p' ? EnumResourceKind.Photos : EnumResourceKind.Documents;
    }

    // The mode, the text and the options of the search shown in the list (the box may have been changed without searching it).
    private EnumNotesSearchMode SearchedMode() =>
        ListKey().StartsWith(MeaningKeyMark, StringComparison.Ordinal) ? EnumNotesSearchMode.Meaning : EnumNotesSearchMode.Words;

    private bool HasOptions() => ListKey().StartsWith(OptionsKeyMark, StringComparison.Ordinal) && ListKey().Length >= 4;

    private WordOptions SearchedOptions() =>
        HasOptions() ? WordOptions.OfKey(ListKey().Substring(OptionsKeyMark.Length, 3)) : WordOptions.None;

    private string SearchedText() =>
        SearchedMode() == EnumNotesSearchMode.Meaning
            ? ListKey()[(MeaningKeyMark.Length + (SearchedKind() == EnumResourceKind.All ? 0 : KindKeyMark.Length + 1))..]
        : HasOptions() ? ListKey()[(OptionsKeyMark.Length + 3)..]
        : ListKey();

    // The notes found, to print or export them (NotesPrintExportMenu adds the list's order and view).
    private NotesListReportRequestDto ReportRequest() => new()
    {
        Source = NotesListReportSource.Search,
        TextSearch = SearchedText(),
        SearchMode = SearchedMode(),
        SearchInDescription = SearchedOptions().Description,
        SearchInNoteTasks = SearchedOptions().Tasks,
        SearchInResources = SearchedOptions().Resources
    };

    // Creating a note needs Staff (KntAccess, checked with no wait before: it opens a window).
    async Task OnNew()
    {
        if (await access.CheckAsync(AuthenticationState, EnumRoles.Staff, "Creating notes"))
            await kntWindows.OpenNewAsync();
    }

    private Task OnView(NoteMinimalDto note) => kntWindows.OpenViewAsync(note.NoteId);

    private Task OnEdit(NoteMinimalDto note) => kntWindows.OpenEditAsync(note.NoteId);

    // A note saved in its window: the list shows it changed (or moved, or gone from it).
    private void OnNoteSaved(Guid noteId)
    {
        _ = InvokeAsync(() =>
        {
            // By meaning, the search again (the note saved may be found, or not, by its new content).
            NewMeaningPages();
            return notesGrid?.RefreshAsync() ?? Task.CompletedTask;
        });
    }

    // One delete at a time: a click or the Delete key repeated asks and deletes once.
    private readonly KntSingleFlight deleting = new();

    Task OnDelete(NoteMinimalDto item) => deleting.RunAsync(() => DeleteAsync(item));

    async Task DeleteAsync(NoteMinimalDto item)
    {
        var resultDialog = await dialogService.Confirm(
            $"Are you sure you want delete note - {@item.Topic} - ({@item.NoteNumber})?",
            "Delete note",
            new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });

        if (resultDialog == true)
        {
            var result = await store.Notes.DeleteAsync(item.NoteId);
            if (result.IsValid && notesGrid != null)
            {
                await notesGrid.ReloadAsync();
            }
        }
    }
}
