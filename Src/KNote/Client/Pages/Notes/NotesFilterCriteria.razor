@inject IStore store
@inject TooltipService tooltipService
@inject NavigationManager navigationManger
@inject DialogService dialogService
@inject NotificationService notificationService

@* Criteria of the notes filter (NotesFilter's side panel): compact fields with floating labels, the same text
   size as the notes list. *@

<EditForm Model="notesFilter" Context="formContext">

    <DataAnnotationsValidator></DataAnnotationsValidator>

    <RadzenStack Gap="0.75rem" class="knt-filter-criteria">

        <RadzenFormField Text="Topic" Variant="Variant.Outlined" Component="Topic">
            <Start><RadzenIcon Icon="title" /></Start>
            <ChildContent>
                <RadzenTextBox Name="Topic" @bind-Value="@notesFilter.Topic" InputSize="InputSize.Small" />
            </ChildContent>
        </RadzenFormField>

        <RadzenFormField Text="Description" Variant="Variant.Outlined" Component="Description">
            <Start><RadzenIcon Icon="notes" /></Start>
            <ChildContent>
                <RadzenTextBox Name="Description" @bind-Value="@notesFilter.Description" InputSize="InputSize.Small" />
            </ChildContent>
        </RadzenFormField>

        <RadzenFormField Text="Tags" Variant="Variant.Outlined" Component="Tags">
            <Start><RadzenIcon Icon="sell" /></Start>
            <ChildContent>
                <RadzenTextBox Name="Tags" @bind-Value="@notesFilter.Tags" InputSize="InputSize.Small" />
            </ChildContent>
        </RadzenFormField>

        <RadzenFormField Text="Note type" Variant="Variant.Outlined" Component="NoteTypeId">
            <Start><RadzenIcon Icon="category" /></Start>
            <ChildContent>
                <RadzenDropDown Name="NoteTypeId" TValue="Guid?" @bind-Value="@notesFilter.NoteTypeId"
                                Data="@noteTypes" TextProperty="Name" ValueProperty="NoteTypeId"
                                AllowClear="true" InputSize="InputSize.Small" />
            </ChildContent>
        </RadzenFormField>

        <RadzenFormField Text="Folder" Variant="Variant.Outlined">
            <Start><RadzenIcon Icon="folder" /></Start>
            <ChildContent>
                <RadzenTextBox Value="@folderName" ReadOnly="true" InputSize="InputSize.Small" />
            </ChildContent>
            <End>
                @if (!string.IsNullOrEmpty(folderName))
                {
                    <RadzenButton Icon="close" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.ExtraSmall"
                                  Click="OnResetFolder" MouseEnter="@(args => tooltipService.Open(args, "Any folder"))" />
                }
                <RadzenButton Icon="folder_open" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.ExtraSmall"
                              Click="SelectFolder" MouseEnter="@(args => tooltipService.Open(args, "Select folder"))" />
            </End>
        </RadzenFormField>

        <RadzenStack Gap="0.25rem">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenText TextStyle="TextStyle.Overline" class="rz-m-0">Attributes</RadzenText>
                <RadzenButton Icon="add" Text="Add" Variant="Variant.Text" Size="ButtonSize.ExtraSmall"
                              Click="OnAtrNew" MouseEnter="@(args => tooltipService.Open(args, "Add new attribute filter"))" />
            </RadzenStack>
            @if (notesFilter.AttributesFilter.Count > 0)
            {
                <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="0.25rem">
                    @foreach (var atr in notesFilter.AttributesFilter)
                    {
                        <RadzenChip Text="@($"{atr.AtrName}: {atr.Value}")" Size="ChipSize.Small" Close="@(() => OnAtrDelete(atr))" />
                    }
                </RadzenStack>
            }
            else
            {
                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 knt-filter-criteria-none">No attribute filters.</RadzenText>
            }
        </RadzenStack>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton Text="Clean" Icon="filter_alt_off" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                          Click="() => ClearFilter(formContext)" />
            <RadzenButton Text="Apply" Icon="filter_alt" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                          Click="() => ApplyFilter(formContext)" />
        </RadzenStack>

    </RadzenStack>

</EditForm>

@code {
    // A copy of the filter applied (the form can keep changing without applying it).
    [Parameter] public EventCallback<NotesFilterDto> FilterSelected { get; set; }
    // The filter shown when the form opens (e.g. the one applied before) and the name of its folder.
    [Parameter] public NotesFilterDto? Filter { get; set; }
    [Parameter] public string? FolderName { get; set; }
    [Parameter] public EventCallback<string?> FolderNameChanged { get; set; }

    private NotesFilterDto notesFilter = new NotesFilterDto();
    private List<NoteTypeDto> noteTypes = new List<NoteTypeDto>();
    private string folderName = "";

    protected async override Task OnInitializedAsync()
    {
        if (Filter != null)
        {
            notesFilter = Filter.GetSimpleDto<NotesFilterDto>();
            folderName = FolderName ?? "";
        }

        var result = await store.NoteTypes.GetAllAsync();
        //if (!result.IsValid)
        //{
        //    notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Loading note types.", Detail =  result.Message, Duration = 12000 });
        //    navigationManger.NavigateTo("index");
        //}
        //else
        //{
        //    noteTypes = result.Entity;
        //}
        if (!result.IsValid)
        {            
            navigationManger.NavigateTo("index");
        }
        else
        {
            noteTypes = result.Entity;
        }

        await base.OnInitializedAsync();
    }

    protected async Task ApplyFilter(EditContext formContext)
    {
        bool formIsValid = formContext.Validate();
        if (formIsValid == false)
        {            
            notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Apply filter.", Detail =  "Incorrect data, check the required attributes.", Duration = 12000 });
            return;
        }

        await SelectFilterAsync();
    }

    protected async Task ClearFilter(EditContext formContext)
    {
        notesFilter.Topic = null;
        notesFilter.NoteTypeId = null;
        notesFilter.Tags = null;
        notesFilter.FolderId = null;
        notesFilter.Description = null;
        notesFilter.AttributesFilter = new List<AtrFilterDto>();             
        folderName = "";

        await SelectFilterAsync();
    }

    private async Task SelectFilterAsync()
    {
        await FolderNameChanged.InvokeAsync(folderName);
        await FilterSelected.InvokeAsync(notesFilter.GetSimpleDto<NotesFilterDto>());
    }
    
    private void OnFolderSelected(FolderDto f)
    {
        notesFilter.FolderId = f.FolderId;
        folderName = f.Name;
    }

    private async Task SelectFolder()
    {
        var res = await dialogService.OpenAsync<KntFolderSelector>("Folder selector",
               new Dictionary<string, object?>(),
               KntDialogs.Medium());

        if (res is FolderDto folder)
            OnFolderSelected(folder);
    }

    private void OnResetFolder()
    {
        notesFilter.FolderId = null;
        folderName = "";
    }

    private void OnAtrDelete(AtrFilterDto atr)
    {
        // A new list instance makes RadzenDataGrid render the change.
        notesFilter.AttributesFilter = notesFilter.AttributesFilter.Where(a => a != atr).ToList();
    }

    private async Task OnAtrNew()
    {
        var res = await dialogService.OpenAsync<NoteKAttributeFilterSelector>($"Attribute filter selector",
               new Dictionary<string, object?>() { { "Attribute", new AtrFilterDto() } },
               KntDialogs.Framed(KntDialogs.Small()));        

        if(res != null)
        {
            var atr = (AtrFilterDto)res;
            // A new list instance makes RadzenDataGrid render the change.
            notesFilter.AttributesFilter = notesFilter.AttributesFilter.Append(atr).ToList();
        }  
    }

}
