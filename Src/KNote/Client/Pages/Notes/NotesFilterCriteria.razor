@inject IStore store
@inject TooltipService tooltipService
@inject NavigationManager navigationManger
@inject DialogService dialogService
@inject NotificationService notificationService


<EditForm Model="notesFilter" Context="formContext" class="rz-mb-3">

    <DataAnnotationsValidator></DataAnnotationsValidator>

    <RadzenStack Gap="0.75rem">

        <KntFormField Label="Topic:" Component="Topic" LabelSize="12">
            <RadzenTextBox Name="Topic" @bind-Value="@notesFilter.Topic" Style="width: 100%" />
        </KntFormField>

        <KntFormField Label="Description:" Component="Description" LabelSize="12">
            <RadzenTextBox Name="Description" @bind-Value="@notesFilter.Description" Style="width: 100%" />
        </KntFormField>

        <KntFormField Label="Tags:" Component="Tags" LabelSize="12">
            <RadzenTextBox Name="Tags" @bind-Value="@notesFilter.Tags" Style="width: 100%" />
        </KntFormField>

        <KntFormField Label="Note type:" Component="NoteTypeId" LabelSize="12">
            <RadzenDropDown Name="NoteTypeId" TValue="Guid?" @bind-Value="@notesFilter.NoteTypeId"
                            Data="@noteTypes" TextProperty="Name" ValueProperty="NoteTypeId"
                            AllowClear="true" Style="width: 100%" />
        </KntFormField>

        <KntFormField Label="Folder:" LabelSize="12">
            <KntFolderPicker FolderName="@folderName" FolderSelected="OnFolderSelected" FolderReset="OnResetFolder" />
        </KntFormField>

        <KntFormField Label="Attributes:" LabelSize="12">
            <RadzenStack Gap="0.5rem">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                    <RadzenButton Icon="add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" MouseEnter="@(args => tooltipService.Open(args, "Add new attribute filter"))"
                                  Click="@(() => OnAtrNew())" />
                </RadzenStack>
                @if (notesFilter.AttributesFilter.Count > 0)
                {
                    <RadzenDataGrid Data="@notesFilter.AttributesFilter" TItem="AtrFilterDto" Density="@Density.Compact">
                        <Columns>
                            <RadzenDataGridColumn TItem="AtrFilterDto" Property="AtrName" Title="Attribute" />
                            <RadzenDataGridColumn TItem="AtrFilterDto" Property="Value" Title="Value" />
                            <RadzenDataGridColumn TItem="AtrFilterDto" Width="60px" TextAlign="TextAlign.Center">
                                <Template Context="atr">
                                    <RadzenButton Icon="remove" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" MouseEnter="@(args => tooltipService.Open(args, "Delete attribute filter"))"
                                                  Click="@(() => OnAtrDelete(atr))" />
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                }
            </RadzenStack>
        </KntFormField>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton Text="Apply" Icon="filter_alt" Click="() => ApplyFilter(formContext)" ButtonStyle="ButtonStyle.Primary" />
            <RadzenButton Text="Clean" Icon="cleaning_services" Click="() => ClearFilter(formContext)" ButtonStyle="ButtonStyle.Secondary" />
        </RadzenStack>

    </RadzenStack>
    
</EditForm>


@code {
    // A copy of the filter applied (the form can keep changing without applying it).
    [Parameter] public EventCallback<NotesFilterDto> FilterSelected { get; set; }
    // The filter shown when the form opens (e.g. the one applied before) and the name of its folder.
    [Parameter] public NotesFilterDto? Filter { get; set; }
    [Parameter] public string? FolderName { get; set; }
    [Parameter] public EventCallback<string?> FolderNameChanged { get; set; }

    private NotesFilterDto notesFilter = new NotesFilterDto();
    private List<NoteTypeDto> noteTypes = new List<NoteTypeDto>();
    private string folderName = "";

    protected async override Task OnInitializedAsync()
    {
        if (Filter != null)
        {
            notesFilter = Filter.GetSimpleDto<NotesFilterDto>();
            folderName = FolderName ?? "";
        }

        var result = await store.NoteTypes.GetAllAsync();
        //if (!result.IsValid)
        //{
        //    notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Loading note types.", Detail =  result.Message, Duration = 12000 });
        //    navigationManger.NavigateTo("index");
        //}
        //else
        //{
        //    noteTypes = result.Entity;
        //}
        if (!result.IsValid)
        {            
            navigationManger.NavigateTo("index");
        }
        else
        {
            noteTypes = result.Entity;
        }

        await base.OnInitializedAsync();
    }

    protected async Task ApplyFilter(EditContext formContext)
    {
        bool formIsValid = formContext.Validate();
        if (formIsValid == false)
        {            
            notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Apply filter.", Detail =  "Incorrect data, check the required attributes.", Duration = 12000 });
            return;
        }

        await SelectFilterAsync();
    }

    protected async Task ClearFilter(EditContext formContext)
    {
        notesFilter.Topic = null;
        notesFilter.NoteTypeId = null;
        notesFilter.Tags = null;
        notesFilter.FolderId = null;
        notesFilter.Description = null;
        notesFilter.AttributesFilter = new List<AtrFilterDto>();             
        folderName = "";

        await SelectFilterAsync();
    }

    private async Task SelectFilterAsync()
    {
        await FolderNameChanged.InvokeAsync(folderName);
        await FilterSelected.InvokeAsync(notesFilter.GetSimpleDto<NotesFilterDto>());
    }
    
    private void OnFolderSelected(FolderDto f)
    {
        notesFilter.FolderId = f.FolderId;
        folderName = f.Name;
    }

    private void OnResetFolder()
    {
        notesFilter.FolderId = null;
        folderName = "";
    }

    private void OnAtrDelete(AtrFilterDto atr)
    {
        // A new list instance makes RadzenDataGrid render the change.
        notesFilter.AttributesFilter = notesFilter.AttributesFilter.Where(a => a != atr).ToList();
    }

    private async Task OnAtrNew()
    {
        var res = await dialogService.OpenAsync<NoteKAttributeFilterSelector>($"Attribute filter selector",
               new Dictionary<string, object?>() { { "Attribute", new AtrFilterDto() } },
               KntDialogs.Medium());        

        if(res != null)
        {
            var atr = (AtrFilterDto)res;
            // A new list instance makes RadzenDataGrid render the change.
            notesFilter.AttributesFilter = notesFilter.AttributesFilter.Append(atr).ToList();
        }  
    }

}
