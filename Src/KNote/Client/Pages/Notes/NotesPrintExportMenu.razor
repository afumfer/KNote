@* Menu item of the notes pages (tree, search, filter) that prints or exports their notes list, as ClientWin's
   File > Print menu: the list (landscape table), the list as a book (one chapter per note) and the selected note's
   details, in the report preview (Shared/KntReportPreview), or the list as a CSV file. The whole list, as the
   notes grid shows it: same notes, order and view (compact or extended). The reports are generated by Server
   (api/reports), only for Staff and up, as in ClientWin: the menu is always there, and each option checks the role
   when chosen (KntAccess). *@

@using KNote.Client.Auth

@implements IAsyncDisposable

@inject IStore store
@inject DialogService dialogService
@inject NotificationService notificationService
@inject IJSRuntime js
@inject KntAccess access

@* The last item of the bar: its dropdown opens to the left (knt-menu-end, KntIndexHeader). *@
<RadzenMenuItem Text="Print/Export" Icon="print" class="knt-menu-separator knt-menu-end">
    <RadzenMenuItem Text="Print list ..." Icon="table_rows" Click="PrintListAsync" />
    <RadzenMenuItem Text="Print as book ..." Icon="menu_book" Click="PrintBookAsync" />
    <RadzenMenuItem Text="Print note details ..." Icon="description" Disabled="@(Grid?.Current == null)" Click="PrintNoteAsync" />
    <RadzenMenuItem Text="Export to CSV ..." Icon="download" Click="ExportCsv" />
</RadzenMenuItem>

@code {
    // The page's notes list: its notes, order and selected note.
    [Parameter][EditorRequired] public NotesGrid? Grid { get; set; }
    // Where the list's notes come from (the folder, the text searched or the filter); the order and the view are
    // added from the grid.
    [Parameter][EditorRequired] public Func<NotesListReportRequestDto> Request { get; set; } = null!;
    // The order of a list not sorted by the user (a folder's own order); null: the query's own one.
    [Parameter] public NotesOrder? DefaultOrder { get; set; }
    // What the list is (e.g. the folder's name), shown under the report's title while it is generated.
    [Parameter] public string? ListName { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = null!;

    private IJSObjectReference? module;

    private Task<bool> CanReportAsync() => access.CheckAsync(AuthenticationState, EnumRoles.Staff, "Printing and exporting notes");

    private async Task PrintListAsync()
    {
        if (!await CanReportAsync() || !HasNotes("print"))
            return;

        var request = BuildRequest();
        await KntReportPreview.OpenAsync(dialogService, "Notes list", ListName, _ => store.Reports.GetNotesListAsync(request));
    }

    private async Task PrintBookAsync()
    {
        if (!await CanReportAsync() || !HasNotes("print"))
            return;

        var notesCount = Grid!.TotalCount;
        if (LargeNotesBook.Is(notesCount))
        {
            var confirmed = await dialogService.Confirm($"{LargeNotesBook.Warning(notesCount)} Do you want to continue?", "Notes book",
                new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" });
            if (confirmed != true)
                return;
        }

        var request = BuildRequest();
        await KntReportPreview.OpenAsync(dialogService, "Notes book", ListName,
            cancellationToken => store.Reports.GetNotesBookAsync(request, cancellationToken),
            $"Generating the book ({notesCount} {(notesCount == 1 ? "note" : "notes")}) ...");
    }

    private async Task PrintNoteAsync()
    {
        var note = Grid?.Current;
        if (note == null || !await CanReportAsync())
            return;

        await KntReportPreview.OpenAsync(dialogService, "Note details", $"#{note.NoteNumber} {note.Topic}",
            _ => store.Reports.GetNoteDetailAsync(note.NoteId));
    }

    // One export at a time: a click repeated downloads the file once.
    private readonly KntSingleFlight exporting = new();

    private Task ExportCsv() => exporting.RunAsync(ExportCsvAsync);

    private async Task ExportCsvAsync()
    {
        if (!await CanReportAsync() || !HasNotes("export"))
            return;

        var result = await store.Reports.GetNotesListCsvAsync(BuildRequest());
        if (!result.IsValid || result.Entity == null)
            return;     // already notified

        module ??= await js.ImportModuleAsync("./js/kntReports.js", store.AppState);
        if (module == null)
            return;     // already notified
        await module.InvokeVoidAsync("downloadFile", result.Entity.FileName, result.Entity.ContentType, result.Entity.Content);

        var notesCount = Grid!.TotalCount;
        notificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Success,
            Summary = "Export to CSV",
            Detail = $"Notes list exported ({notesCount} {(notesCount == 1 ? "note" : "notes")}): {result.Entity.FileName}"
        });
    }

    private bool HasNotes(string action)
    {
        if (Grid?.TotalCount > 0)
            return true;

        notificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Info,
            Summary = "Print/Export",
            Detail = $"There are no notes in the list to {action}."
        });
        return false;
    }

    private NotesListReportRequestDto BuildRequest()
    {
        var request = Request();
        var order = Grid?.CurrentOrder ?? DefaultOrder;
        request.OrderColumn = order?.Column;
        request.OrderAscending = order?.Ascending ?? true;
        request.Compact = store.AppState.NotesListCompact ?? true;
        return request;
    }

    public async ValueTask DisposeAsync()
    {
        if (module != null)
        {
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
