@page "/admin"

@using KNote.Client.Pages.Users
@using KNote.Client.Pages.Folders
@using KNote.Client.Pages.Attributes
@using KNote.Client.Pages.Types
@using KNote.Client.Pages.TraceNoteTypes
@using KNote.Client.Pages.Local

@inject NavigationManager navigationManager
@inject IStore store

@attribute [Authorize(Roles = "Admin")]


<KntIndexHeader Section="KntSections.Admin">
</KntIndexHeader>

<div class="rz-pt-2 knt-admin">

    @* The admin pages shown in the tabs draw their headers in compact style. *@
    <CascadingValue Name="KntCompactHeader" Value="true">
        <RadzenTabs TabPosition="TabPosition.Left">
            <Tabs>

                <RadzenTabsItem Text="@TabText(KntSections.Users)" Icon="@KntSections.Users.Icon">
                    <UsersIndex></UsersIndex>
                </RadzenTabsItem>

                <RadzenTabsItem Text="@TabText(KntSections.Folders)" Icon="@KntSections.Folders.Icon">
                    <FoldersIndex></FoldersIndex>
                </RadzenTabsItem>

                <RadzenTabsItem Text="@TabText(KntSections.NoteTypes)" Icon="@KntSections.NoteTypes.Icon">
                    <TypesIndex></TypesIndex>
                </RadzenTabsItem>

                <RadzenTabsItem Text="@TabText(KntSections.TraceNoteTypes)" Icon="@KntSections.TraceNoteTypes.Icon">
                    <TraceNoteTypesIndex></TraceNoteTypesIndex>
                </RadzenTabsItem>

                <RadzenTabsItem Text="@TabText(KntSections.Attributes)" Icon="@KntSections.Attributes.Icon">
                    <AttributesIndex></AttributesIndex>
                </RadzenTabsItem>

                @if (localAdmin)
                {
                    <RadzenTabsItem Text="@TabText(KntSections.ThisComputer)" Icon="@KntSections.ThisComputer.Icon">
                        <LocalSettingsIndex></LocalSettingsIndex>
                    </RadzenTabsItem>
                }

            </Tabs>
        </RadzenTabs>
    </CascadingValue>

</div>


@code {

    // Non-breaking space: separates the tab text from its icon.
    private static string TabText(KntSection section) => $" {section.Text}";

    // KNote Local: the computer's settings (the server says whether it can).
    private bool localAdmin;

    protected override async Task OnInitializedAsync()
    {
        var capabilities = await store.Server.GetCapabilitiesAsync();
        localAdmin = capabilities.IsValid && capabilities.Entity?.LocalAdmin == true;
    }

}
