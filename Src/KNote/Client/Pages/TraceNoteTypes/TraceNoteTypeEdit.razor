@page "/tracenotetypes/edit/{TypeId}"

@implements IDisposable

@inject IStore store
@inject DialogService dialogService

@attribute [Authorize(Roles = "Admin")]


<NavigationLock ConfirmExternalNavigation=true />

@if (traceNoteType != null)
{
    <TraceNoteTypeForm Title="Edit trace note type" OnValidSubmit="OnSave" OnExit="OnExit" Saving="saving.IsBusy" TraceNoteType="traceNoteType" />
}
else
{
    <text>Loading trace note type ... </text>
}

@code {
    // One save at a time (a double click saves once), and leaving waits for it.
    private readonly KntSingleFlight saving = new();
    // Closed meanwhile (Esc): no result to give, and Radzen's Close would close the dialog on top, another one.
    private bool closed;

    [Parameter] public string TypeId { get; set; } = string.Empty;

    private TraceNoteTypeDto? traceNoteType;

    protected async override Task OnInitializedAsync()
    {
        if (!Guid.TryParse(TypeId, out var id))
        {
            await dialogService.Alert("Invalid trace note type identifier.");
            CloseDialog(null);
            return;
        }

        var result = await store.TraceNoteTypes.GetAsync(id);
        if (!result.IsValid)
            CloseDialog(null);
        else
        {
            traceNoteType = result.Entity;
            traceNoteType.SetIsDirty(false);
        }
    }

    private Task OnSave() => saving.RunAsync(SaveAsync);

    private async Task SaveAsync()
    {
        if (!traceNoteType!.IsDirty())
        {
            CloseDialog(traceNoteType);
        }
        else if (traceNoteType.IsValid())
        {
            var result = await store.TraceNoteTypes.SaveAsync(traceNoteType);
            if (result.IsValid)
                CloseDialog(result.Entity);
        }
    }

    private async Task OnExit()
    {
        if (saving.IsBusy)
            return;

        if (traceNoteType == null || !traceNoteType.IsDirty())
        {
            CloseDialog(null);
            return;
        }

        var resultDialog = await dialogService.Confirm(
            @"Do you want to leave the page and lose your changes?",
            $"{KntConst.AppName}",
            new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });

        if (resultDialog == true)
            CloseDialog(null);
    }

    public void Dispose() => closed = true;

    private void CloseDialog(object? result)
    {
        if (!closed)
            dialogService.Close(result);
    }
}
