@page "/types"

@inject IStore store
@inject TooltipService tooltipService
@inject DialogService dialogService
@inject ContextMenuService contextMenuService

@attribute [Authorize(Roles = "Admin")]

<KntIndexHeader Section="KntSections.NoteTypes">
    <IndexMenu>
        <RadzenMenu>
            <RadzenMenuItem Text="New type ..." Icon="post_add"  Click="OnNew"></RadzenMenuItem>
            <RadzenMenuItem Text="Edit type ..." Icon="edit" Disabled="@(Selected == null)" Click="@(() => OnEdit(Selected!))"></RadzenMenuItem>
            <RadzenMenuItem Text="Delete type ..." Icon="delete" Disabled="@(Selected == null)" Click="@(() => OnDelete(Selected!))"></RadzenMenuItem>
        </RadzenMenu>
    </IndexMenu>
</KntIndexHeader>

<div class="rz-pt-2">
    <EntityList List="noteTypes">
        <AllItems>
            <RadzenDataGrid Data="@noteTypes" TItem="NoteTypeDto" AllowColumnResize="true" AllowSorting="true" Density="@Density.Compact"
                            class="knt-admin-list knt-list" AllowAlternatingRows="false"
                            SelectionMode="DataGridSelectionMode.Single" @bind-Value="selection"
                            CellContextMenu="OnCellContextMenu"
                            RowDoubleClick="@(args => OnEdit(args.Data!))">
                <Columns>
                    <RadzenDataGridColumn TItem="NoteTypeDto" Property="Name" Title="Name" />
                    <RadzenDataGridColumn TItem="NoteTypeDto" Property="Description" Title="Full name" />                
                </Columns> 
            </RadzenDataGrid>
        </AllItems>
    </EntityList>
</div>

@code {

    private List<NoteTypeDto>? noteTypes { get; set; }    

    protected async override Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        var result = await store.NoteTypes.GetAllAsync();
        if (result.IsValid)
            noteTypes = result.Entity;
            selection = noteTypes!.Where(x => selection.Any(s => s.NoteTypeId == x.NoteTypeId)).ToList();

        StateHasChanged();
    }

    async Task OnNew()
    {        
        var res = await dialogService.OpenAsync<TypeNew>($"New note type",
               new Dictionary<string, object?>() {  },
               KntDialogs.Framed(KntDialogs.Small()));

        if(res != null)           
            await Load();        
    }

    // The selected row: what the header's Edit and Delete act on.
    private IList<NoteTypeDto> selection = new List<NoteTypeDto>();
    private NoteTypeDto? Selected => selection.FirstOrDefault();

    private void OnCellContextMenu(DataGridCellMouseEventArgs<NoteTypeDto> args)
    {
        selection = [args.Data!];
        KntActionsMenu.Open(contextMenuService, args, ActionsOf(args.Data!));
    }

    private List<KntAction> ActionsOf(NoteTypeDto noteType) =>
    [
        new("Edit", "edit", () => OnEdit(noteType)),
        new("Delete", "delete", () => OnDelete(noteType), Danger: true)
    ];

    async Task OnEdit(NoteTypeDto noteType)
    {        
        var res = await dialogService.OpenAsync<TypeEdit>($"Edit note type",
               new Dictionary<string, object?>() { { "TypeId", noteType.NoteTypeId.ToString() } },
               KntDialogs.Framed(KntDialogs.Small()));

        if(res != null)        
            await Load();        
    }

    async Task OnDelete(NoteTypeDto item)
    {             
        var resultDialog = await dialogService.Confirm(
            $"Are you sure you want delete note type - {@item.Name})?", 
            "Delete note type", 
            new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });

        if (resultDialog == true)
        {
            // No explicit error notification here on failure: store.NoteTypes.DeleteAsync already
            // shows one via BaseService.ProcessResultFromHttpResponse -> AppState.NotifyError (a
            // global mechanism every WebApiService call goes through) - adding another here would
            // just duplicate it.
            var result = await store.NoteTypes.DeleteAsync(item.NoteTypeId);
            if (result.IsValid)
            {
                noteTypes = null;
                await Load();
            }
        }
    }

}
