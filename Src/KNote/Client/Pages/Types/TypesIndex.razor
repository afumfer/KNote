@page "/types"

@inject IStore store
@inject TooltipService tooltipService
@inject DialogService dialogService
@inject ContextMenuService contextMenuService

@attribute [Authorize(Roles = "Admin")]

<KntIndexHeader Section="KntSections.NoteTypes">
    <IndexMenu>
        <RadzenMenu>
            <RadzenMenuItem Text="New type ..." Icon="post_add"  Click="OnNew"></RadzenMenuItem>
        </RadzenMenu>
    </IndexMenu>
</KntIndexHeader>

<div class="rz-pt-2">
    <EntityList List="noteTypes">
        <AllItems>
            <RadzenDataGrid Data="@noteTypes" TItem="NoteTypeDto" AllowColumnResize="true" Density="@Density.Compact"
                            CellContextMenu="@(args => KntActionsMenu.Open(contextMenuService, args, ActionsOf(args.Data!)))"
                            RowDoubleClick="@(args => OnEdit(args.Data!))">
                <Columns>
                    <RadzenDataGridColumn TItem="NoteTypeDto" Property="Name" Title="Name" />
                    <RadzenDataGridColumn TItem="NoteTypeDto" Property="Description" Title="Full name" />                
                    <RadzenDataGridColumn TItem="NoteTypeDto" Width="52px" TextAlign="TextAlign.Center" Resizable="false" Sortable="false">
                        <Template Context="data">
                            <KntActionsMenu Actions="@ActionsOf(data)" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns> 
            </RadzenDataGrid>
        </AllItems>
    </EntityList>
</div>

@code {

    private List<NoteTypeDto>? noteTypes { get; set; }    

    protected async override Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        var result = await store.NoteTypes.GetAllAsync();
        if (result.IsValid)
            noteTypes = result.Entity;

        StateHasChanged();
    }

    async Task OnNew()
    {        
        var res = await dialogService.OpenAsync<TypeNew>($"New note type",
               new Dictionary<string, object?>() {  },
               KntDialogs.Small(showClose: false));

        if(res != null)           
            await Load();        
    }

    private List<KntAction> ActionsOf(NoteTypeDto noteType) =>
    [
        new("Edit", "edit", () => OnEdit(noteType)),
        new("Delete", "delete", () => OnDelete(noteType), Danger: true)
    ];

    async Task OnEdit(NoteTypeDto noteType)
    {        
        var res = await dialogService.OpenAsync<TypeEdit>($"Edit note type",
               new Dictionary<string, object?>() { { "TypeId", noteType.NoteTypeId.ToString() } },
               KntDialogs.Small(showClose: false));

        if(res != null)        
            await Load();        
    }

    async Task OnDelete(NoteTypeDto item)
    {             
        var resultDialog = await dialogService.Confirm(
            $"Are you sure you want delete note type - {@item.Name})?", 
            "Delete note type", 
            new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });

        if (resultDialog == true)
        {
            // No explicit error notification here on failure: store.NoteTypes.DeleteAsync already
            // shows one via BaseService.ProcessResultFromHttpResponse -> AppState.NotifyError (a
            // global mechanism every WebApiService call goes through) - adding another here would
            // just duplicate it.
            var result = await store.NoteTypes.DeleteAsync(item.NoteTypeId);
            if (result.IsValid)
            {
                noteTypes = null;
                await Load();
            }
        }
    }

}
