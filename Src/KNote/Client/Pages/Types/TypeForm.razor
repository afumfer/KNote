@inject NotificationService notificationService

<EditForm Model="NoteType" Context="formContext">

    <DataAnnotationsValidator></DataAnnotationsValidator>

    <KntDialogFrame Icon="@KntSections.NoteTypes.Icon" Title="@Title" Subtitle="@Subtitle" OnClose="() => OnExit.InvokeAsync(null)">
        <ChildContent>
            <KntFormSection Icon="badge" Title="General" Description="A type groups notes that share attributes.">
                <KntField Label="Name" Component="Name" Required="true">
                    <RadzenTextBox Name="Name" @bind-Value="@NoteType.Name" />
                    <ValidationMessage For="@(() => NoteType.Name)" />
                </KntField>
                <KntField Label="Description" Component="Description">
                    <RadzenTextArea Name="Description" @bind-Value="@NoteType.Description" Rows="3" />
                    <ValidationMessage For="@(() => NoteType.Description)" />
                </KntField>
            </KntFormSection>
        </ChildContent>
        <Footer>
            <RadzenButton Text="Cancel" Click="() => OnExit.InvokeAsync(null)" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Disabled="@Saving" />
            <RadzenButton Text="Save" Icon="save" Click="() => Save(formContext)" ButtonStyle="ButtonStyle.Primary" IsBusy="@Saving" />
        </Footer>
    </KntDialogFrame>

</EditForm>

@code {        
    [Parameter] [EditorRequired] public NoteTypeDto NoteType { get; set; } = null!;
    [Parameter] public string Title { get; set; } = "...";    
    [Parameter] public EventCallback OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnExit { get; set; }
    // Being saved: the buttons wait for it (the page ignores another save or leaving meanwhile).
    [Parameter] public bool Saving { get; set; }

    private string Subtitle => NoteType.NoteTypeId == Guid.Empty ? "A new type of note." : NoteType.Name;

    protected async Task Save(EditContext formContext)
    {
        bool formIsValid = formContext.Validate();
        if (formIsValid == false)
        {            
            notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Save note type.", Detail =  "Incorrect data, check the required attributes.", Duration = 12000 });
            return;
        }

        await OnValidSubmit.InvokeAsync(formContext);
    }

}
