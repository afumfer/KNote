@page "/types/edit/{TypeId}"

@implements IDisposable

@inject IStore store
@inject DialogService dialogService

@attribute [Authorize(Roles = "Admin")]


<NavigationLock ConfirmExternalNavigation=true />

@if (noteType != null)
{
    <TypeForm Title="Edit note type" OnValidSubmit="OnSave" OnExit="OnExit" Saving="saving.IsBusy" NoteType="noteType" />
}
else
{
    <text>Loading note type ... </text>
}

@code {
    // One save at a time (a double click saves once), and leaving waits for it.
    private readonly KntSingleFlight saving = new();
    // Closed meanwhile (Esc): no result to give, and Radzen's Close would close the dialog on top, another one.
    private bool closed;

    [Parameter] public string TypeId { get; set; } = string.Empty;

    private NoteTypeDto? noteType;

    protected async override Task OnInitializedAsync()
    {
        base.OnInitialized();

        Guid id;
        var parseOk = Guid.TryParse(TypeId, out id);
        if (!parseOk)
        {            
            await dialogService.Alert("Invalid note type identifier.");
            CloseDialog(null);
            return;
        }

        var result = await store.NoteTypes.GetAsync(id);
        if (!result.IsValid)                    
            CloseDialog(null);
        else
        {            
            noteType = result.Entity;
            noteType.SetIsDirty(false);
        }
    }

    private Task OnSave() => saving.RunAsync(SaveAsync);

    private async Task SaveAsync()
    {
        if (!noteType!.IsDirty())
        {
            CloseDialog(noteType);
        }
        else
        {
            if (noteType.IsValid())
            {
                var result = await store.NoteTypes.SaveAsync(noteType);
                if (result.IsValid)                                    
                {                    
                    CloseDialog(result.Entity);
                }
            }
        }
    }

    private async Task OnExit()
    {        
        if (saving.IsBusy)
            return;

        if (noteType == null)
        {
            CloseDialog(null);
            return;
        }

        if (noteType.IsDirty())
        {
            var resultDialog = await dialogService.Confirm(
                @"Do you want to leave the page and lose your changes?",
                $"{KntConst.AppName}",
                new ConfirmOptions() { OkButtonText = "Yes", CancelButtonText = "No" });

            if (resultDialog == true)
            {
                CloseDialog(null);
            }
        }
        else
        {
            CloseDialog(null);
        }
    }

    public void Dispose() => closed = true;

    private void CloseDialog(object? result)
    {
        if (!closed)
            dialogService.Close(result);
    }
}
