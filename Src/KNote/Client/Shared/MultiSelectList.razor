@inject DialogService dialogService

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Start" Style="width: 100%">
    <RadzenStack Gap="0.25rem">
        @foreach (var item in Items.Where(i => i.Selected))
        {
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                <RadzenIcon Icon="check_box" />
                <RadzenText Text="@item.Value" class="rz-my-0" />
            </RadzenStack>
        }
    </RadzenStack>
    <RadzenButton Icon="playlist_add_check" Click="() => SelectTags()" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" title="Select tags" />
</RadzenStack>


@code
{
    [Parameter] public List<MultiSelectListDto> Items { get; set; } = null!;
    [Parameter] public EventCallback<string> OnAttributeChange { get; set; }


    private async Task SelectTags()
    {
        var res = await dialogService.OpenAsync<InputMultiSelectList>($"Select tags",
               new Dictionary<string, object>() { { "Items", Items } },
               new DialogOptions() { Width = "700px", Height = "470px", Resizable = true, Draggable = true });

        if(res != null)
        {            
            var r2 = string.Join(", ", res);
            await OnAttributeChange.InvokeAsync(r2);
        }        
    }

}
