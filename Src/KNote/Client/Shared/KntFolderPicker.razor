@* Read-only folder name (or path) in a field with a folder icon, a button that opens KntFolderSelector and an
   optional reset button (shown only when FolderReset has a handler). *@

@inject DialogService dialogService
@inject TooltipService tooltipService

<RadzenFormField Variant="Variant.Outlined" AllowFloatingLabel="false" class="knt-folder-picker">
    <Start>
        <RadzenIcon Icon="folder" />
    </Start>
    <ChildContent>
        <RadzenTextBox Value="@FolderName" ReadOnly="true" />
    </ChildContent>
    <End>
        @if (FolderReset.HasDelegate)
        {
            <RadzenButton Icon="close" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                          MouseEnter="@(args => tooltipService.Open(args, ResetTitle))" Click="@(() => FolderReset.InvokeAsync())" />
        }
        <RadzenButton Text="Change" Icon="drive_file_move" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                      MouseEnter="@(args => tooltipService.Open(args, "Select folder"))" Click="SelectFolder" />
    </End>
</RadzenFormField>

@code {
    [Parameter] public string? FolderName { get; set; }
    [Parameter] public string ResetTitle { get; set; } = "Reset folder";
    [Parameter] public EventCallback<FolderDto> FolderSelected { get; set; }
    [Parameter] public EventCallback FolderReset { get; set; }

    private async Task SelectFolder()
    {
        var res = await dialogService.OpenAsync<KntFolderSelector>("Folder selector",
               new Dictionary<string, object?>(),
               KntDialogs.Framed(KntDialogs.Medium()));

        if (res is FolderDto folder)
            await FolderSelected.InvokeAsync(folder);
    }
}
