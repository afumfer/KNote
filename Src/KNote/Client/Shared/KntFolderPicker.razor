@* Read-only folder name with a button that opens KntFolderSelector, and an optional reset button
   (shown only when FolderReset has a handler). *@

@inject DialogService dialogService

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
    <RadzenTextBox Value="@FolderName" ReadOnly="true" Style="flex: 1;" />
    @if (FolderReset.HasDelegate)
    {
        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" title="@ResetTitle" Click="@(() => FolderReset.InvokeAsync())" />
    }
    <RadzenButton Icon="folder" ButtonStyle="ButtonStyle.Light" title="Select folder" Click="SelectFolder" />
</RadzenStack>

@code {
    [Parameter] public string? FolderName { get; set; }
    [Parameter] public string ResetTitle { get; set; } = "Reset folder";
    [Parameter] public EventCallback<FolderDto> FolderSelected { get; set; }
    [Parameter] public EventCallback FolderReset { get; set; }

    private async Task SelectFolder()
    {
        var res = await dialogService.OpenAsync<KntFolderSelector>("Folder selector",
               new Dictionary<string, object?>(),
               new DialogOptions() { Width = "700px", Height = "520px" });

        if (res is FolderDto folder)
            await FolderSelected.InvokeAsync(folder);
    }
}
