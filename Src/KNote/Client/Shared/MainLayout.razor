@inherits LayoutComponentBase

@implements IDisposable

@inject IStore store
@inject KntWindows kntWindows
@inject NotificationService notificationService
@inject NavigationManager navigationManager
@inject AuthenticationStateProvider authenticationStateProvider

<RadzenComponents />

<RadzenLayout>

    <RadzenHeader>
        <ChildContent>
            <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Start" Gap="0px">
                <RadzenColumn Size="5">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
                        <RadzenSidebarToggle Click="@(() => sidebar = !sidebar)" />
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="knt-app-brand">
                            <KntLogo Size="24" />
                            <span class="knt-app-title">
                                @KntConst.AppName
                                @if (ShowRepositoryName)
                                {
                                    <span class="knt-app-repository">&nbsp;- @store.AppState.RepositoryName</span>
                                }
                            </span>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="7">
                    <RadzenStack  Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End">
                        <MainLayoutHeader />
                    </RadzenStack>                
                </RadzenColumn>
            </RadzenRow>
        </ChildContent>
    </RadzenHeader>

    <RadzenSidebar @bind-Expanded="@sidebar">
        <MainLayoutNavMenu />
    </RadzenSidebar>

    <RadzenBody>
        @Body
    </RadzenBody>

    <RadzenFooter class="rz-p-1 rz-mx-1">
        <MainLayoutFooter RepositoryName="@store.AppState.RepositoryName" />
    </RadzenFooter>

</RadzenLayout>

@code {

    private bool sidebar;    

    protected override async Task OnInitializedAsync()
    {
        base.OnInitialized();

        store.AppState.OnChange += StateHasChanged;
        store.AppState.OnNotifyError += NotifyError;
        store.AppState.OnNotifySuccess += NotifySuccess;

        await LoadRepositoryNameAsync();
        await kntWindows.StartAsync();

        authenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await UpdateChatRoomAsync(await authenticationStateProvider.GetAuthenticationStateAsync());
    }

    public void Dispose()
    {
        store.AppState.OnChange -= StateHasChanged;
        store.AppState.OnNotifyError -= NotifyError;
        store.AppState.OnNotifySuccess -= NotifySuccess;
        authenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private async void OnAuthenticationStateChanged(Task<AuthenticationState> state)
    {
        await UpdateChatRoomAsync(await state);
    }

    // The chat room is open for a Staff user while they are signed in (see ChatRoomHub): its threads are followed
    // while the app is open, wherever the user is.
    private async Task UpdateChatRoomAsync(AuthenticationState state) =>
        await store.ChatRoom.StartForUserAsync(state.User);

    // Home shows the repository's name as its title; the other pages, here, after the application's name. The
    // layout is rendered again on every navigation (its Body changes), so the title follows the page shown.
    private bool ShowRepositoryName => !string.IsNullOrEmpty(store.AppState.RepositoryName) && !IsHome();

    private bool IsHome()
    {
        var path = navigationManager.ToBaseRelativePath(navigationManager.Uri).Split('?', '#')[0].Trim('/');
        return path.Length == 0 || path.Equals("index", StringComparison.OrdinalIgnoreCase);
    }

    private async Task LoadRepositoryNameAsync()
    {
        var result = await store.SystemValues.GetRepositoryNameAsync();
        store.AppState.RepositoryName = result.IsValid ? result.Entity ?? "" : "";
    }

    private void NotifyError(string summary, string details)
    {
        notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = summary, Detail = details, Duration = 12000 });
    }

    private void NotifySuccess(string summary, string details)
    {
        notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = summary, Detail = details, Duration = 3000 });
    }
}