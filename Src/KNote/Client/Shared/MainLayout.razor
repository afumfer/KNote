@inherits LayoutComponentBase

@implements IDisposable

@using KNote.Client.Auth

@inject IStore store
@inject ILoginService loginService
@inject KntWindows kntWindows
@inject AlarmNotices alarmNotices
@inject NotificationService notificationService
@inject NavigationManager navigationManager
@inject AuthenticationStateProvider authenticationStateProvider
@inject IJSRuntime js

<RadzenComponents />

<RadzenMediaQuery Query="(max-width: 768px)" Change="@(narrow => narrowScreen = narrow)" />

<RadzenLayout>

    <RadzenHeader>
        <ChildContent>
            <RadzenRow AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Start" Gap="0px">
                <RadzenColumn Size="5">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
                        <RadzenSidebarToggle Click="ToggleMenuAsync" />
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="knt-app-brand">
                            <KntLogo Size="24" />
                            <span class="knt-app-title">
                                @KntConst.AppName
                                @if (ShowRepositoryName)
                                {
                                    <span class="knt-app-repository">&nbsp;- @store.AppState.RepositoryName</span>
                                }
                            </span>
                        </RadzenStack>
                    </RadzenStack>
                </RadzenColumn>
                <RadzenColumn Size="7">
                    <RadzenStack  Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End">
                        <MainLayoutHeader />
                    </RadzenStack>                
                </RadzenColumn>
            </RadzenRow>
        </ChildContent>
    </RadzenHeader>

    @* Always shown: the toggle switches the menu between icons with their texts and only the icons. *@
    <RadzenSidebar Expanded="true" Responsive="false" class="@(MenuCompact ? "knt-sidebar-compact" : null)">
        <MainLayoutNavMenu Compact="MenuCompact" />
    </RadzenSidebar>

    <RadzenBody>
        @Body
    </RadzenBody>

    <RadzenFooter class="rz-p-1 rz-mx-1">
        <MainLayoutFooter RepositoryName="@store.AppState.RepositoryName" />
    </RadzenFooter>

</RadzenLayout>

@code {

    private const string MenuCompactStorageKey = "KNoteMenuCompact";

    // The menu shows only its icons as the user left it (kept in the browser) or, until they choose, on a narrow
    // screen (a phone).
    private bool? menuCompact;
    private bool narrowScreen;

    private bool MenuCompact => menuCompact ?? narrowScreen;

    protected override async Task OnInitializedAsync()
    {
        base.OnInitialized();

        var savedMenuCompact = await js.LocalStorageGetItem(MenuCompactStorageKey);
        if (savedMenuCompact != null)
            menuCompact = savedMenuCompact == "true";

        store.AppState.OnChange += StateHasChanged;
        store.AppState.OnNotifyError += NotifyError;
        store.AppState.OnNotifySuccess += NotifySuccess;
        store.AppState.OnSessionEnded += OnSessionEnded;
        alarmNotices.Arrived += OnAlarmNoticesArrived;

        // The session first: the repository's name is the session's repository's.
        var authenticationState = await authenticationStateProvider.GetAuthenticationStateAsync();
        await LoadRepositoryNameAsync();
        await kntWindows.StartAsync();
        kntWindows.SessionChanged += OnSessionChangedElsewhere;

        authenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await UpdateChatRoomAsync(authenticationState);
        await UpdateAlarmNoticesAsync(authenticationState);
    }

    public void Dispose()
    {
        store.AppState.OnChange -= StateHasChanged;
        store.AppState.OnNotifyError -= NotifyError;
        store.AppState.OnNotifySuccess -= NotifySuccess;
        store.AppState.OnSessionEnded -= OnSessionEnded;
        alarmNotices.Arrived -= OnAlarmNoticesArrived;
        kntWindows.SessionChanged -= OnSessionChangedElsewhere;
        authenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    // Another tab of the app signed in or out: this one follows it (the windows of a note keep their repository, see
    // KntWindowLayout), back to Home when the repository changes.
    private async void OnSessionChangedElsewhere(Guid? repositoryId)
    {
        if (repositoryId == null)
        {
            await loginService.SignOutHereAsync();
            return;
        }

        var repositoryChanged = repositoryId != loginService.RepositoryId;
        await loginService.AdoptLastSessionAsync();
        if (repositoryChanged)
        {
            navigationManager.NavigateTo("");
            notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = "Session changed",
                Detail = "The session was started in another repository in another tab of the app.", Duration = 6000 });
        }
    }

    // The server refused the session (expired, or the password changed): the user is signed out, unless another
    // window of the app had already renewed it (see ILoginService.SessionRefusedAsync).
    private async void OnSessionEnded()
    {
        var renewed = await loginService.SessionRefusedAsync();
        if (renewed == true)
            notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = "Session renewed",
                Detail = "Your session was renewed in another window of the app. Try again.", Duration = 6000 });
        else if (renewed == false)
            notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Session ended",
                Detail = "Your session has ended: it expired or your password was changed. Sign in again.", Duration = 12000 });
    }

    private async Task ToggleMenuAsync()
    {
        menuCompact = !MenuCompact;
        await js.LocalStorageSetItem(MenuCompactStorageKey, menuCompact == true ? "true" : "false");
    }

    // Signed in, out or in another repository: its name, its chat room and its alarms.
    private async void OnAuthenticationStateChanged(Task<AuthenticationState> state)
    {
        await LoadRepositoryNameAsync();
        var authenticationState = await state;
        await UpdateChatRoomAsync(authenticationState);
        await UpdateAlarmNoticesAsync(authenticationState);
    }

    // The alarms are checked for a Staff user while they are signed in (see AlarmNotices), in this window only (the
    // windows of the app don't, see KntWindowLayout).
    private async Task UpdateAlarmNoticesAsync(AuthenticationState state) =>
        await alarmNotices.StartForUserAsync(state.User);

    // New alarm notices while the app is on screen: they stay in the alarms panel (the header's bell).
    private void OnAlarmNoticesArrived(List<AlarmNotice> notices)
    {
        foreach (var notice in notices)
            notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = AlarmNotices.Title(notice.Notice),
                Detail = notice.Notice.Comment ?? "", Duration = 15000, Click = _ => kntWindows.OpenEditAsync(notice.Notice.NoteId) });
    }

    // The chat room is open for a Staff user while they are signed in (see ChatRoomHub): its threads are followed
    // while the app is open, wherever the user is.
    private async Task UpdateChatRoomAsync(AuthenticationState state) =>
        await store.ChatRoom.StartForUserAsync(state.User);

    // Home shows the repository's name as its title; the other pages, here, after the application's name. The
    // layout is rendered again on every navigation (its Body changes), so the title follows the page shown.
    private bool ShowRepositoryName => !string.IsNullOrEmpty(store.AppState.RepositoryName) && !IsHome();

    private bool IsHome()
    {
        var path = navigationManager.ToBaseRelativePath(navigationManager.Uri).Split('?', '#')[0].Trim('/');
        return path.Length == 0 || path.Equals("index", StringComparison.OrdinalIgnoreCase);
    }

    private async Task LoadRepositoryNameAsync()
    {
        var result = await store.SystemValues.GetRepositoryNameAsync();
        store.AppState.RepositoryName = result.IsValid ? result.Entity ?? "" : "";
    }

    private void NotifyError(string summary, string details)
    {
        notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = summary, Detail = details, Duration = 12000 });
    }

    private void NotifySuccess(string summary, string details)
    {
        notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = summary, Detail = details, Duration = 3000 });
    }
}