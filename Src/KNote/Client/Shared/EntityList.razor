@typeparam TItem

@* A list loaded by its page: "loading" while List is null, the error and Retry if the page couldn't read it
   (LoadFailed), "no records" if it is empty, and its items. *@

@if (LoadFailed)
{
    <div class="knt-load-error">
        <span class="knt-load-error-text"><RadzenIcon Icon="error" /> @FailedText</span>
        <RadzenButton Text="Retry" Icon="refresh" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="Retry" />
    </div>
}
else if (List == null)
{
    @if (Loading == null)
    {
        <RadzenLabel Text="Loading ..."/>
        <RadzenProgressBar  ProgressBarStyle="ProgressBarStyle.Light" Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    }
    else
    {
       @Loading
    }
}
else if (List.Count == 0)
{
    @if (NotRecordsFound == null)
    {
        <p>No records found.</p>    
    }
    else
    {
        @NotRecordsFound
    }
}
else
{
    if(Item != null)
    {
        @foreach (var item in List)    
            @Item(item)
    }
    else
    {
        @AllItems
    }
}

@code {
    [Parameter] public List<TItem> List { get; set; } = null!;
    [Parameter] public RenderFragment Loading { get; set; } = null!;
    [Parameter] public RenderFragment NotRecordsFound { get; set; } = null!;
    [Parameter] public RenderFragment AllItems { get; set; } = null!;
    [Parameter] public RenderFragment<TItem> Item { get; set; } = null!;
    // The page couldn't read the list (the error is already notified, BaseService): shown instead of "loading",
    // with Retry, which asks the page to read it again.
    [Parameter] public bool LoadFailed { get; set; }
    [Parameter] public EventCallback Retry { get; set; }
    [Parameter] public string FailedText { get; set; } = "The list could not be loaded.";
}