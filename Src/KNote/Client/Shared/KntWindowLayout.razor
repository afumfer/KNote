@inherits LayoutComponentBase

@implements IDisposable

@using KNote.Client.Auth

@inject IStore store
@inject ILoginService loginService
@inject KntWindows kntWindows
@inject NotificationService notificationService

@* Layout of the windows of the app (AppStoreService/KntWindows: a note viewed or edited, the AI assistant, the chat
   room): the page alone, without the app's header, side menu and footer, so there is nowhere else to go from it. *@

<RadzenComponents />

<RadzenLayout>
    <RadzenBody>
        @* Tells the page (and KntAccessDenied) it is a window of the app. *@
        <CascadingValue Name="KntWindow" Value="true" IsFixed="true">
            @Body
        </CascadingValue>
    </RadzenBody>
</RadzenLayout>

@code {

    protected override async Task OnInitializedAsync()
    {
        store.AppState.OnNotifyError += NotifyError;
        store.AppState.OnNotifySuccess += NotifySuccess;
        store.AppState.OnSessionEnded += OnSessionEnded;

        await kntWindows.StartAsync();
    }

    public void Dispose()
    {
        store.AppState.OnNotifyError -= NotifyError;
        store.AppState.OnNotifySuccess -= NotifySuccess;
        store.AppState.OnSessionEnded -= OnSessionEnded;
    }

    // The server refused the session (expired, or the password changed): the user is signed out, unless another
    // window of the app had already renewed it (see ILoginService.SessionRefusedAsync).
    private async void OnSessionEnded()
    {
        var renewed = await loginService.SessionRefusedAsync();
        if (renewed == true)
            notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = "Session renewed",
                Detail = "Your session was renewed in another window of the app. Try again.", Duration = 6000 });
        else if (renewed == false)
            notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = "Session ended",
                Detail = "Your session has ended: it expired or your password was changed. Sign in again.", Duration = 12000 });
    }

    private void NotifyError(string summary, string details)
    {
        notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = summary, Detail = details, Duration = 12000 });
    }

    private void NotifySuccess(string summary, string details)
    {
        notificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = summary, Detail = details, Duration = 3000 });
    }
}
