@using System.Linq.Expressions

@inherits InputTextArea

@inject TooltipService tooltipService

@typeparam TValue


<RadzenTabs  TabPosition = "TabPosition.Top" >    
    <Tabs>

        <RadzenTabsItem Text="&nbsp;Preview">            
            <ViewMarkdown MarkdownContent="@CurrentValue" />            
        </RadzenTabsItem>

        <RadzenTabsItem Text="&nbsp;Modify">
            <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="0.75rem" class="rz-mb-1">
                @foreach (var group in toolbarGroups)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.125rem">
                        @foreach (var button in group)
                        {
                            <RadzenButton Icon="@button.Icon" Text="@button.Text" title="@button.Title"
                                          ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                          Click="@(() => InsertMarkDownCommand(button.Command))" />
                        }
                    </RadzenStack>
                }
            </RadzenStack>
            <div>
                <RadzenTextArea @bind-Value="CurrentValue" Style="width: 100%; height: 350px;" />
                @if(For != null)
                {
                    <ValidationMessage For="For" />
                }
            </div>
        </RadzenTabsItem>

    </Tabs>
</RadzenTabs>


@code {
    [Parameter] public Expression<Func<TValue>> For { get; set; } = null!;

    private record ToolbarButton(enumMarkDownCommand Command, string? Icon, string? Text, string Title);

    private static readonly ToolbarButton[][] toolbarGroups =
    [
        [
            new(enumMarkDownCommand.Bold, "format_bold", null, "Bold"),
            new(enumMarkDownCommand.Strikethrough, "format_strikethrough", null, "Strikethrough"),
            new(enumMarkDownCommand.Italic, "format_italic", null, "Italic")
        ],
        [
            new(enumMarkDownCommand.H1, null, "H1", "Heading 1"),
            new(enumMarkDownCommand.H2, null, "H2", "Heading 2"),
            new(enumMarkDownCommand.H3, null, "H3", "Heading 3"),
            new(enumMarkDownCommand.H4, null, "H4", "Heading 4")
        ],
        [
            new(enumMarkDownCommand.List, "format_list_bulleted", null, "Bulleted list"),
            new(enumMarkDownCommand.ListOrdered, "format_list_numbered", null, "Numbered list"),
            new(enumMarkDownCommand.Line, "horizontal_rule", null, "Horizontal line")
        ],
        [
            new(enumMarkDownCommand.Link, "link", null, "Link"),
            new(enumMarkDownCommand.Image, "image", null, "Image"),
            new(enumMarkDownCommand.Code, "code", null, "Code"),
            new(enumMarkDownCommand.Table, "table_chart", null, "Table")
        ]
    ];

    private void InsertMarkDownCommand(enumMarkDownCommand command)
    {
        switch (command)
        {
            case enumMarkDownCommand.Bold:
                CurrentValue += " **_**";
                break;
            case enumMarkDownCommand.Strikethrough:
                CurrentValue += " ~~_~~";
                break;
            case enumMarkDownCommand.Italic:
                CurrentValue += " *_*";
                break;
            case enumMarkDownCommand.H1:
                CurrentValue += "\n\n#";
                break;
            case enumMarkDownCommand.H2:
                CurrentValue += "\n\n##";
                break;
            case enumMarkDownCommand.H3:
                CurrentValue += "\n\n###";
                break;
            case enumMarkDownCommand.H4:
                CurrentValue += "\n\n####";
                break;
            case enumMarkDownCommand.List:
                CurrentValue += "\n\n-_";
                break;
            case enumMarkDownCommand.ListOrdered:
                CurrentValue += "\n\n1._";
                break;
            case enumMarkDownCommand.Line:
                CurrentValue += "\n\n------------\n\n\n";
                break;
            case enumMarkDownCommand.Link:
                CurrentValue += "\n\n[xx](http://xx 'xx')";
                break;
            case enumMarkDownCommand.Image:
                CurrentValue += "\n\n[![Title](Address 'Title')](http://url 'Title')";
                break;
            case enumMarkDownCommand.Code:
                CurrentValue += "\n\n```_```";
                break;
            case enumMarkDownCommand.Table:
                CurrentValue += "\n\n|   |   |\n";
                CurrentValue += "| ------------ | ------------ |\n";
                CurrentValue += "|   |   |\n";
                CurrentValue += "|   |   |\n";
                break;
            default:
                break;
        }
    }

    #region Private enums

    private enum enumMarkDownCommand
    {
        Bold,
        Strikethrough,
        Italic,
        H1,
        H2,
        H3,
        H4,
        List,
        ListOrdered,
        Line,
        Link,
        Image,
        Code,
        Table
    }

    #endregion 
}
