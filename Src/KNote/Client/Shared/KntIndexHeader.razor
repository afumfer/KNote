<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween"
             Wrap="FlexWrap.Wrap" class="rz-border rz-px-4 rz-py-1">
    <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H4" class="rz-my-0">@TextHead</RadzenText>
    @IndexMenu
</RadzenStack>

@code {
    [Parameter] public string TextHead { get; set; } = string.Empty;
    [Parameter] public RenderFragment? IndexMenu { get; set; }
}
