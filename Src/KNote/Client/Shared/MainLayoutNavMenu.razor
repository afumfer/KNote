@* Entries come from KntSections, so the page headers show the same icons. *@
<RadzenPanelMenu style="height: 100%">
    <RadzenPanelMenuItem Text="@KntSections.Home.Text" Path="@KntSections.Home.Path" Icon="@KntSections.Home.Icon" />
    <RadzenPanelMenuItem Text="@KntSections.QuickSearch.Text" Path="@KntSections.QuickSearch.Path" Icon="@KntSections.QuickSearch.Icon" />
    <RadzenPanelMenuItem Text="@KntSections.TreePanel.Text" Path="@KntSections.TreePanel.Path" Icon="@KntSections.TreePanel.Icon" />
    <RadzenPanelMenuItem Text="@KntSections.NotesFilter.Text" Path="@KntSections.NotesFilter.Path" Icon="@KntSections.NotesFilter.Icon" />
    <AuthorizeView Roles="Staff, ProjectManager, Admin">
        <Authorized>
            <RadzenPanelMenuItem Text="@KntSections.TasksCalendar.Text" Path="@KntSections.TasksCalendar.Path" Icon="@KntSections.TasksCalendar.Icon" />
            <RadzenPanelMenuItem Text="@KntSections.Alarms.Text" Path="@KntSections.Alarms.Path" Icon="@KntSections.Alarms.Icon" />
            <RadzenPanelMenuItem Text="@KntSections.ChatRoom.Text" Path="@KntSections.ChatRoom.Path" Icon="@KntSections.ChatRoom.Icon" />
            <RadzenPanelMenuItem Text="@KntSections.AiAssistant.Text" Path="@KntSections.AiAssistant.Path" Icon="@KntSections.AiAssistant.Icon" />
        </Authorized>
    </AuthorizeView>
    <AuthorizeView Roles="Admin">
        <Authorized>
            <RadzenPanelMenuItem Text="@KntSections.Admin.Text" Path="@KntSections.Admin.Path" Icon="@KntSections.Admin.Icon" />
        </Authorized>
    </AuthorizeView>
</RadzenPanelMenu>
