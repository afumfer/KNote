<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap">
    <RadzenLabel Text="@TextLeft" />
    <RadzenLabel Text="@TextRight" />
</RadzenStack>

@code{
    [Parameter] public string TextLeft { get; set; } = "";
    [Parameter] public string TextRight { get; set; } = "";
}
