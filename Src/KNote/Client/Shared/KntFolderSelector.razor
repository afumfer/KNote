@implements IDisposable

@inject IStore store
@inject DialogService dialogService

@* Dialog to choose a folder in the folders tree (KntFolderPicker opens it framed): the result is the folder
   chosen, or null if cancelled. Double click chooses a folder at once. *@

<KntDialogFrame Icon="folder_open" Title="Select folder" Subtitle="@(folderSelected?.Name is { Length: > 0 } name ? $"Selected: {name}" : "Choose a folder in the folders tree.")">
    <ChildContent>
        <div class="knt-folder-selector" @ondblclick="OnConfirm">
            <KntFoldersTreeView FoldersInfo="@foldersTree" FolderSelected="OnFolderSelected" />
        </div>
    </ChildContent>
    <Footer>
        <RadzenButton Text="Cancel" Click="() => OnCancel()" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" />
        <RadzenButton Text="Select" Icon="check" Click="() => OnConfirm()" ButtonStyle="ButtonStyle.Primary" Disabled="@(folderSelected == null)" />
    </Footer>
</KntDialogFrame>


@code {

    private List<FolderDto> foldersTree;
    private FolderDto folderSelected;
    private AppState appState;
    // Closed before the tree is read: it is no longer needed.
    private readonly CancellationTokenSource disposal = new();

    protected override async Task OnInitializedAsync()
    {
        appState = store.AppState;
        appState.OnChange += StateHasChanged;
        if (foldersTree == null)
        {
            if (appState.FoldersTree == null)
            {
                var res = await store.Folders.GetTreeAsync(disposal.Token);
                if (disposal.IsCancellationRequested)
                    return;
                foldersTree = res.Entity;
                appState.FoldersTree = foldersTree;

                if (foldersTree?.Count > 0)
                {
                    var f = foldersTree.Select(x => x).FirstOrDefault();
                    f.Selected = true;
                    OnFolderSelected(f);
                }
            }
            else
            {
                foldersTree = appState.FoldersTree;
                OnFolderSelected(appState.SelectedFolder.GetSimpleDto<FolderDto>());
            }
        }
    }

    public void Dispose()
    {
        closed = true;
        disposal.Cancel();
        appState.OnChange -= StateHasChanged;
    }

    private void OnFolderSelected(FolderDto f)
    {
        folderSelected = f;
    }

    void OnConfirm()
    {
        if (folderSelected != null)
            CloseDialog(folderSelected);
    }

    void OnCancel()
    {
        CloseDialog(null);
    }

    // Closed once: it is opened from another dialog, and a second Close (a click repeated, or after Esc) would close
    // that one (Radzen closes the dialog on top).
    private bool closed;

    private void CloseDialog(object? result)
    {
        if (closed)
            return;
        closed = true;
        dialogService.Close(result);
    }
}
