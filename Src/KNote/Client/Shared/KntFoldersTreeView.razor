@implements IDisposable

@inject IStore store
@inject TooltipService tooltipService
@inject ContextMenuService contextMenuService


@* Compact: the same text size as the notes lists (NotesGrid), so the tree takes less room.
   Which branches are open is kept in the folders themselves (FolderDto.Expanded, in the tree cached in AppState): the
   user opens and closes them (Expand/Collapse), and the selected folder's ancestors are opened when the selection is
   set, so it is always in view. Radzen evaluates Expanded on every render and closes a branch whose value goes from
   true to false: computing it from the selected folder (its parent only) closed the user's branches when the selection
   moved. *@
<div class="knt-folders-tree">
<RadzenTree Data=@FoldersInfo Change=@OnFolderSelected Expand=@OnExpand Collapse=@OnCollapse ItemContextMenu=@OnItemContextMenu>
    <RadzenTreeLevel 
        TextProperty="Name" 
        ChildrenProperty="ChildFolders"     
        Expanded=@ShouldExpanded 
        Selected=@ShouldSelected
        HasChildren=@(f => ((FolderDto)f).ChildFolders.Any()) >
            <Template>
                <span class="knt-folders-tree-item" @ondblclick="@(() => FolderDoubleClick.InvokeAsync((FolderDto)context.Value!))">
                    @* The selected folder shows an open folder. *@
                    <RadzenIcon Icon="@(IsSelected(context.Value) ? "folder_open" : "folder")" class="knt-folders-tree-icon" />
                    <span>@context.Text</span>
                </span>
            </Template>
    </RadzenTreeLevel>            
</RadzenTree>
</div>


@code {
    [Parameter] public List<FolderDto> FoldersInfo { get; set; } = null!;
    [Parameter] public EventCallback<FolderDto> FolderSelected { get; set; }
    // Actions of a folder, shown with a right click on it (KntActionsMenu); none if not given.
    [Parameter] public Func<FolderDto, IEnumerable<KntAction>>? FolderActions { get; set; }
    [Parameter] public EventCallback<FolderDto> FolderDoubleClick { get; set; }

    private AppState appState = null!;

    protected override void OnInitialized()
    {
        appState = store.AppState;
        appState.OnChange += OnAppStateChanged;

        base.OnInitialized();
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (FoldersInfo is null)
            FoldersInfo = new List<FolderDto>();
        RevealSelectedFolder();
    }

    public void Dispose()
    {
        appState.OnChange -= OnAppStateChanged;
    }

    private void OnAppStateChanged()
    {
        RevealSelectedFolder();
        StateHasChanged();
    }

    // The tree and the selected folder whose ancestors were opened last: they are opened once for each selection (or
    // tree read again), so that the user can still close the branch of the selected folder.
    private List<FolderDto>? revealedTree;
    private Guid? revealedFolderId;

    private void RevealSelectedFolder()
    {
        var folderId = appState.SelectedFolder?.FolderId;
        if (ReferenceEquals(revealedTree, FoldersInfo) && revealedFolderId == folderId)
            return;

        revealedTree = FoldersInfo;
        revealedFolderId = folderId;
        if (folderId != null)
            ExpandAncestors(FoldersInfo, folderId.Value);
    }

    // Opens the folders on the way to the folder; whether it was found.
    private static bool ExpandAncestors(IEnumerable<FolderDto> folders, Guid folderId)
    {
        foreach (var folder in folders)
        {
            if (folder.FolderId == folderId)
                return true;
            if (ExpandAncestors(folder.ChildFolders, folderId))
            {
                folder.Expanded = true;
                return true;
            }
        }
        return false;
    }

    private void OnExpand(TreeExpandEventArgs args)
    {
        if (args.Value is FolderDto folder)
            folder.Expanded = true;
    }

    private void OnCollapse(TreeEventArgs args)
    {
        if (args.Value is FolderDto folder)
            folder.Expanded = false;
    }

    private async Task OnFolderSelected(TreeEventArgs args)
    {
        var folder = args.Value as FolderDto;
        selectedFolderId = folder?.FolderId;
        await FolderSelected.InvokeAsync(folder);
    }

    private Guid? selectedFolderId;

    private bool IsSelected(object? value) => value is FolderDto folder && folder.FolderId == selectedFolderId;

    private void OnItemContextMenu(TreeItemContextMenuEventArgs args)
    {
        if (FolderActions != null && args.Value is FolderDto folder)
            KntActionsMenu.Open(contextMenuService, args, FolderActions(folder));
    }

    private bool ShouldSelected(object data) =>
        data is FolderDto folder && appState.SelectedFolder != null && folder.FolderId == appState.SelectedFolder.FolderId;

    private static bool ShouldExpanded(object data) => data is FolderDto { Expanded: true };
}